# Settings for ./flash-3/start.sh. Read before that script's own defaults; a variable already in the environment wins.
# TENSORFOLD_* lines are forwarded into the container by ../tensorfold.sh.

# Elastic kept prompt snapshots (overlay/cache): at most this many (~110 MiB each, outside the memory gate). Default 256.
TENSORFOLD_KEEP_MAX=128

# Visual tokens that ALL images of one request share (each gets budget // N). At 16384 the 1228x617 screenshots shrink from the 23rd
# image on, which changes every image's token count and breaks the prefix cache (full re-prefill). 65536 (the maximum) keeps 722 each up to 50.
VISION_IMAGE_TOKENS=65536
