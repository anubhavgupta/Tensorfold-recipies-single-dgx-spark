 #include "linear.h"
 #include "../graph.cuh"
 
-#define MAX_BSZN 8   // must match MAX_BSZN in blocksparse_mlp.h / BlockSparseMLP.py
+#define MAX_BSZN 25  // must match MAX_BSZN in blocksparse_mlp.h / BlockSparseMLP.py
 
 // Gate and up projections run as one fused MGEMM when the pointer tables are given, otherwise
 // as two separate GEMV/GEMM calls -- for num_tokens > 1 these go directly through exl3_gemm_gr
diff --git a/exllamav3/generator/generator.py b/exllamav3/generator/generator.py
index a1981d49..706c0d75 100644
--- a/exllamav3/generator/generator.py
+++ b/exllamav3/generator/generator.py
@@ -26,6 +26,9 @@ from ..util import profile_opt
 import os as _os
 _BATCH_VERIFY = _os.environ.get("EXL3_BATCH_VERIFY", "1") != "0"
 _MTP_DEVICE_DRAFT = _os.environ.get("EXL3_MTP_DEVICE_DRAFT", "1") != "0"
+# Rows per verify forward that still take the MoE fused decode kernels (MAX_BSZN); with many jobs the draft
+# window is shortened so jobs * (1 + window) stays inside it, instead of falling to the slower prefill-shaped path.
+_FUSED_DECODE_ROWS = int(_os.environ.get("EXL3_FUSED_DECODE_ROWS", "25"))
 
 class Generator:
 
@@ -773,6 +776,10 @@ class Generator:
         # every row's running product of estimated conditional acceptance probabilities falls
         # below the confidence target, keeping the first low-confidence token as the label probe
         window = self.num_draft_tokens
+        if _FUSED_DECODE_ROWS > 0:
+            window = min(window, max(0, _FUSED_DECODE_ROWS // batch_size - 1))
+        if window == 0:
+            return None
         cal = self.draft_calibrator
         conf_cols = []
         reach = None
