+"""DFlash2 drafts for Flash Next's shared rounds: one drafter's weights, a context ring per stream slot.
+
+The drafter reads the target's hidden states after layers ``target_layer_ids`` (each the mean of the four
+hyper-connection streams, as the checkpoint was trained), keeps them as keys and values of its own sliding-window
+attention, and drafts a block from the pending token. Drafts only change speed: every one is verified by the target.
+The block, its two-tap convolutions, the selector chain and the 4-bit weights are GLM's DFlash2 port
+(``glm5_next.cuda.dflash2``); this module batches every stream of a round into one context pass and one block
+pass (a ring per stream slot, blocks that do not mix), lets a context start at a resumed prompt's resume point,
+and drafts over Flash Next's draft vocabulary.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+import triton
+import triton.language as tl
+from safetensors import safe_open
+
+from tensorfold.engine.exact_sampling import Sampling, uniform_rows
+from tensorfold.families.glm5_next.cuda import glue as gglue
+from tensorfold.families.glm5_next.cuda import qmm as gqmm
+from tensorfold.families.glm5_next.cuda.dflash2 import EDGE, NOISE, NO_LIMIT, DraftLayer, _prep_kernel
+
+from . import qmm as fqmm
+from .forward import _embed
+
+TAP_ROWS = 64          # context rows a tap pass takes at a time (graphs in steps of 8 rows)
+
+
+def vocab_choice() -> str:
+    """TENSORFOLD_DFLASH_VOCAB: ``draft`` (default, Flash Next's draft vocabulary, 4-bit head) or ``full``."""
+
+    v = os.environ.get("TENSORFOLD_DFLASH_VOCAB", "draft").strip().lower()
+    if v not in ("draft", "full"):
+        raise ValueError(f"TENSORFOLD_DFLASH_VOCAB: draft or full, not {v!r}")
+    return v
+
+
+def is_dflash2(path: str | Path) -> bool:
+    try:
+        cfg = json.loads((Path(path) / "config.json").read_text())
+    except (OSError, ValueError):
+        return False
+    return "dflash_config" in cfg and any("DFlash" in a for a in cfg.get("architectures", []))
+
+
+@triton.jit
+def _dconv_kernel(X, DYN, BASE, RES, OUT, D: tl.constexpr, G: tl.constexpr, GS: tl.constexpr, NB: tl.constexpr,
+                  BRANCH: tl.constexpr, HAS_RES: tl.constexpr, BLOCK: tl.constexpr):
+    """GLM's two-tap grouped dynamic convolution, over blocks of NB rows (a block's first row has no previous row)."""
+
+    row = tl.program_id(0)
+    c = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    ok = c < D
+    x = tl.load(X + row * D + c, mask=ok, other=0.0).to(tl.float32)
+    prev = tl.load(X + (row - 1) * D + c, mask=ok & (row % NB > 0), other=0.0).to(tl.float32)
+    grp = c // GS
+    d0 = tl.load(DYN + ((row * 2 + BRANCH) * 2) * G + grp, mask=ok, other=0.0).to(tl.float32)
+    d1 = tl.load(DYN + ((row * 2 + BRANCH) * 2 + 1) * G + grp, mask=ok, other=0.0).to(tl.float32)
+    b0 = tl.load(BASE + (BRANCH * 2) * D + c, mask=ok, other=0.0).to(tl.float32)
+    b1 = tl.load(BASE + (BRANCH * 2 + 1) * D + c, mask=ok, other=0.0).to(tl.float32)
+    k0 = (b0 + d0).to(tl.bfloat16).to(tl.float32)
+    k1 = (b1 + d1).to(tl.bfloat16).to(tl.float32)
+    y = (x * k0 + prev * k1).to(tl.bfloat16)
+    if HAS_RES:
+        r = tl.load(RES + row * D + c, mask=ok, other=0.0).to(tl.float32)
+        y = (r + y.to(tl.float32)).to(tl.bfloat16)
+    tl.store(OUT + row * D + c, y, mask=ok)
+
+
+def _dconv(x, dyn, base, branch: int, group_size: int, nb: int, residual=None):
+    rows, d = x.shape
+    x = x.contiguous()
+    out = torch.empty_like(x)
+    block = 1024
+    _dconv_kernel[(rows, triton.cdiv(d, block))](x, dyn.contiguous(), base, residual if residual is not None else x,
+                                                 out, D=d, G=d // group_size, GS=group_size, NB=nb, BRANCH=branch,
+                                                 HAS_RES=residual is not None, BLOCK=block, num_warps=4)
+    return out
+
+
+@triton.jit
+def _dattn_kernel(Q, K, V, OUT, SLOT, POS, LO, R, window, scale, N: tl.constexpr, G: tl.constexpr,
+                  NH: tl.constexpr, KVH: tl.constexpr, HD: tl.constexpr, CAP: tl.constexpr, BK: tl.constexpr,
+                  CAUSAL: tl.constexpr):
+    """GLM's block attention, one program a KV head and stream: the stream's ring from LO on, and its block."""
+
+    kvh = tl.program_id(0)
+    b = tl.program_id(1)
+    M: tl.constexpr = G * N
+    m = tl.arange(0, M)
+    qh = kvh * G + m // N
+    qr = m % N
+    d = tl.arange(0, HD)
+    q = tl.load(Q + (qh[:, None] * R + b * N + qr[:, None]) * HD + d[None, :])
+    slot = tl.load(SLOT + b)
+    s = tl.load(POS + b).to(tl.int32)
+    first = tl.load(LO + b).to(tl.int32)
+    base = (slot * KVH + kvh) * CAP
+    klen = s + N
+    qpos = s + qr
+    m_i = tl.full([M], -1e30, tl.float32)
+    l_i = tl.zeros([M], tl.float32)
+    acc = tl.zeros([M, HD], tl.float32)
+    lo = tl.maximum(tl.maximum(s - window, 0), first) // BK * BK
+    for start in range(lo, klen, BK):
+        kk = start + tl.arange(0, BK)
+        kin = (kk < klen) & (kk >= first)
+        row = kk % CAP
+        k = tl.load(K + (base + row[:, None]) * HD + d[None, :], mask=kin[:, None], other=0.0)
+        v = tl.load(V + (base + row[:, None]) * HD + d[None, :], mask=kin[:, None], other=0.0)
+        sc = tl.dot(q, tl.trans(k)) * scale
+        ok = kin[None, :] & (((kk[None, :] < s) & (qpos[:, None] - kk[None, :] <= window)) | (kk[None, :] >= s))
+        if CAUSAL:
+            ok = ok & (kk[None, :] <= qpos[:, None])
+        sc = tl.where(ok, sc, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(sc, axis=1))
+        alpha = tl.exp(m_i - m_new)
+        p = tl.exp(sc - m_new[:, None])
+        l_i = l_i * alpha + tl.sum(p, axis=1)
+        acc = acc * alpha[:, None] + tl.dot(p.to(tl.bfloat16), v)
+        m_i = m_new
+    out = acc / l_i[:, None]
+    tl.store(OUT + (b * N + qr[:, None]) * (NH * HD) + qh[:, None] * HD + d[None, :], out.to(tl.bfloat16))
+
+
+class DFlash2:
+    """The drafter's weights and a context ring for each of the decoder's states; every pass covers all streams."""
+
+    def __init__(self, draft_dir: str | Path, w, states: list) -> None:
+        from tensorfold.cuda.geometry import draft_ring_rows
+
+        path = Path(draft_dir)
+        cfg = json.loads((path / "config.json").read_text())
+        dc = cfg["dflash_config"]
+        self.w, self.dev = w, w.device
+        self.D = int(cfg["hidden_size"])
+        if self.D != w.cfg.hidden:
+            raise ValueError(f"the DFlash2 drafter's width {self.D} is not the target's {w.cfg.hidden}")
+        self.hd = int(cfg["head_dim"])
+        self.heads, self.kvh = int(cfg["num_attention_heads"]), int(cfg["num_key_value_heads"])
+        self.eps = float(cfg["rms_norm_eps"])
+        theta = float(cfg["rope_parameters"]["rope_theta"])
+        self.mask_id = int(dc["mask_token_id"])
+        self.gs = int(dc["conv_group_size"])
+        if int(dc["conv_kernel_size"]) != 2:
+            raise ValueError("only two-tap convolutions are ported")
+        self.block = int(dc["block_size"])
+        self.top_k = int(dc["selector_top_k"])
+        self.tap_layers = tuple(int(i) for i in dc["target_layer_ids"])
+        if max(self.tap_layers) + 1 >= w.cfg.layers:
+            raise ValueError(f"DFlash2 taps {self.tap_layers} need a layer after each in a {w.cfg.layers}-layer target")
+        self.window = int(cfg["sliding_window"]) - 1
+        self.causal = bool(cfg.get("is_causal", True))
+        self.inter = int(cfg["intermediate_size"])
+        dev = self.dev
+
+        def gpu(t: torch.Tensor) -> torch.Tensor:
+            return t.to(dev, torch.bfloat16).contiguous()
+
+        q4 = gqmm.quantize4
+        with safe_open(str(path / "model.safetensors"), framework="pt", device="cpu") as f:
+            get = f.get_tensor
+            self.fc = q4(gpu(get("fc.weight")))
+            self.hidden_norm = gpu(get("hidden_norm.weight"))
+            self.norm_weight = gpu(get("norm.weight"))
+            self.hproj = gpu(get("candidate_selector.hidden_projection.weight"))
+            self.pred = get("candidate_selector.predecessor_codebook").float().numpy().astype(np.float64)
+            self.succ = get("candidate_selector.successor_codebook").float().numpy().astype(np.float64)
+            self.layers: list[DraftLayer] = []
+            for i in range(int(cfg["num_hidden_layers"])):
+                p = f"layers.{i}."
+                q, k, v = (get(p + f"self_attn.{x}_proj.weight") for x in "qkv")
+                for conv in ("attention_conv", "mlp_conv"):
+                    if tuple(get(p + conv + ".base_kernel").shape) != (2, 2, self.D):
+                        raise ValueError(f"unexpected {conv} base kernel shape")
+                self.layers.append(DraftLayer(
+                    in_norm=gpu(get(p + "input_layernorm.weight")),
+                    post_norm=gpu(get(p + "post_attention_layernorm.weight")),
+                    a_base=gpu(get(p + "attention_conv.base_kernel")),
+                    a_kp=q4(gpu(get(p + "attention_conv.kernel_projection.weight"))),
+                    m_base=gpu(get(p + "mlp_conv.base_kernel")),
+                    m_kp=q4(gpu(get(p + "mlp_conv.kernel_projection.weight"))),
+                    qkv=q4(gpu(torch.cat((q, k, v)))),
+                    kv=q4(gpu(torch.cat((k, v)))),
+                    q_norm=gpu(get(p + "self_attn.q_norm.weight")),
+                    k_norm=gpu(get(p + "self_attn.k_norm.weight")),
+                    o=q4(gpu(get(p + "self_attn.o_proj.weight"))),
+                    gu=q4(gpu(torch.cat((get(p + "mlp.gate_proj.weight"), get(p + "mlp.up_proj.weight"))))),
+                    down=q4(gpu(get(p + "mlp.down_proj.weight")))))
+        self.head, self.head_ids = self._head()
+        torch.cuda.empty_cache()
+        self.inv_freq = 1.0 / theta ** (torch.arange(self.hd // 2, device=dev, dtype=torch.float32) * 2 / self.hd)
+        self.cap = draft_ring_rows(self.window, self.block)
+        # one context ring a stream slot, plus a last one that padded rows write to
+        self.index = {id(st): i for i, st in enumerate(states)}
+        S, n = len(states), self.block
+        self.S = S
+        self.kc = [torch.zeros((S + 1, self.kvh, self.cap, self.hd), dtype=torch.bfloat16, device=dev)
+                   for _ in self.layers]
+        self.vc = [torch.zeros_like(k) for k in self.kc]
+        self.end = [0] * S          # a slot's next context position
+        self.lo = [0] * S           # its first valid one (a context starts over where a resumed prompt does)
+        width = len(self.tap_layers) * self.D
+        # a tap pass's static inputs: rows, and each row's slot, ring row and position
+        self.t_in = torch.zeros((TAP_ROWS, width), dtype=torch.bfloat16, device=dev)
+        self.t_meta = torch.zeros((3, TAP_ROWS), dtype=torch.int64, device=dev)
+        self.t_host = torch.zeros((3, TAP_ROWS), dtype=torch.int64).pin_memory()
+        # a block pass's static inputs (a stream's pending id, slot, position, first valid position) and outputs
+        self.b_ids = torch.full((S * n,), self.mask_id, dtype=torch.int32, device=dev)
+        self.b_meta = torch.zeros((4, S), dtype=torch.int64, device=dev)
+        self.b_host = torch.zeros((4, S), dtype=torch.int64).pin_memory()
+        self.b_rows = torch.arange(n, device=dev)
+        self.packed = torch.zeros((S * (n - 1), 2 * self.top_k), dtype=torch.float32, device=dev)
+        self.proj = torch.zeros((S * (n - 1), self.hproj.shape[0]), dtype=torch.float32, device=dev)
+        self.packed_host = torch.zeros_like(self.packed, device="cpu").pin_memory()
+        self.proj_host = torch.zeros_like(self.proj, device="cpu").pin_memory()
+        self.pool = None
+        self.tap_graphs: dict[int, torch.cuda.CUDAGraph] = {}
+        self.block_graphs: dict[int, torch.cuda.CUDAGraph] = {}
+        # TENSORFOLD_DFLASH_TIMING=1: every 50 rounds, the mean round and drafting ms (synchronized, so slower)
+        self.timing = os.environ.get("TENSORFOLD_DFLASH_TIMING", "0") == "1"
+        self.times: list[tuple[float, float, int, int]] = []
+
+    def timed(self, t0: float, t1: float, t2: float, streams: int, rows: int) -> None:
+        self.times.append((t1 - t0, t2 - t1, streams, rows))
+        if len(self.times) == 50:
+            n = len(self.times)
+            print(f"[tensorfold] dflash2 timing: verify+commit {1e3 * sum(t[0] for t in self.times) / n:.1f} ms, "
+                  f"drafting {1e3 * sum(t[1] for t in self.times) / n:.1f} ms a round; "
+                  f"{sum(t[2] for t in self.times) / n:.1f} streams, {sum(t[3] for t in self.times) / n:.1f} rows",
+                  flush=True)
+            self.times.clear()
+
+    def _head(self):
+        """Draft logits: Flash Next's draft-vocabulary rows of the head at 4 bits (or the full EXL3/4-bit head)."""
+
+        w = self.w
+        if vocab_choice() == "full":
+            return w.head, None
+        if w.draft_head is not None:
+            return w.draft_head, w.draft_ids
+        from .exl3 import requant_rows
+        from .weights import draft_token_ids
+
+        ids = draft_token_ids("default")
+        ids = torch.from_numpy(ids[ids < w.cfg.vocab]).to(self.dev)
+        return fqmm.make_q4(*requant_rows(w.head, ids, self.dev)), ids
+
+    def attach(self, b) -> None:
+        """Give a forward's buffers a tap row for each of its rows: the mean stream after each tapped layer."""
+
+        b.taps = torch.zeros((b.rows, len(self.tap_layers) * self.D), dtype=torch.bfloat16, device=self.dev)
+        b.tap_at = {id(self.w.layers[i + 1]): k for k, i in enumerate(self.tap_layers)}
+
+    def nbytes(self) -> int:
+        mats = sum(q.nbytes() for L in self.layers for q in (L.a_kp, L.m_kp, L.qkv, L.kv, L.o, L.gu, L.down))
+        head = self.head.nbytes() if self.head_ids is not None else 0
+        return mats + self.fc.nbytes() + head + 2 * sum(t.numel() * 2 for t in self.kc)
+
+    # -- pieces -------------------------------------------------------------------------------------------------
+    def _norm(self, x: torch.Tensor, weight: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        rows = x.shape[0]
+        out = torch.empty((rows, self.D), dtype=torch.bfloat16, device=self.dev)
+        xs = torch.empty((rows, self.D // 64), dtype=torch.float32, device=self.dev)
+        gglue.rmsnorm(x, weight, self.eps, out, xs)
+        return out, xs
+
+    def _logits(self, h: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        """Top ``top_k`` draft logits [rows, k] fp32 and their token ids [rows, k] int32."""
+
+        if self.head_ids is None:                           # the full head: an EXL3 linear (fp32 out) or 4-bit
+            if isinstance(self.head, fqmm.Q4):
+                logits = fqmm.matmul(h, self.head)
+            else:
+                logits = torch.empty((h.shape[0], self.head.n), dtype=torch.float32, device=self.dev)
+                self.head(h, logits)
+            vals, idx = torch.topk(logits.float(), self.top_k, dim=-1)
+            return vals, idx.to(torch.int32)
+        vals, local = torch.topk(fqmm.matmul(h, self.head).float(), self.top_k, dim=-1)
+        return vals, self.head_ids[local].to(torch.int32)
+
+    def _rotary(self, pos: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        phase = pos.to(torch.float32)[:, None] * self.inv_freq[None, :]
+        return phase.cos().contiguous(), phase.sin().contiguous()
+
+    def _prep(self, qkv: torch.Tensor, L: DraftLayer, cos: torch.Tensor, sin: torch.Tensor, heads: int):
+        rows = qkv.shape[0]
+        q = torch.empty((heads, rows, self.hd), dtype=torch.bfloat16, device=self.dev) if heads else qkv
+        k = torch.empty((self.kvh, rows, self.hd), dtype=torch.bfloat16, device=self.dev)
+        v = torch.empty_like(k)
+        _prep_kernel[(rows, heads + 2 * self.kvh)](qkv, L.q_norm, L.k_norm, cos, sin, q, k, v, rows, qkv.stride(0),
+                                                   self.eps, H=heads, HKV=self.kvh, HALF=self.hd // 2, num_warps=1)
+        return q, k, v
+
+    def _store(self, i: int, slots: torch.Tensor, rows: torch.Tensor, k: torch.Tensor, v: torch.Tensor) -> None:
+        self.kc[i][slots, :, rows] = k.transpose(0, 1)
+        self.vc[i][slots, :, rows] = v.transpose(0, 1)
+
+    # -- the contexts -------------------------------------------------------------------------------------------
+    def _taps_compute(self, rows: int) -> None:
+        """Context rows: each tap row's keys and values into its slot's ring at its position."""
+
+        slots, ring, pos = self.t_meta[0, :rows], self.t_meta[1, :rows], self.t_meta[2, :rows]
+        ctx, _ = self._norm(gqmm.matmul(self.t_in[:rows], self.fc), self.hidden_norm)
+        cos, sin = self._rotary(pos)
+        for i, L in enumerate(self.layers):
+            _, k, v = self._prep(gqmm.matmul(ctx, L.kv), L, cos, sin, 0)
+            self._store(i, slots, ring, k, v)
+
+    @torch.no_grad()
+    def add_taps(self, parts: list[tuple[object, torch.Tensor, int]]) -> None:
+        """(state, committed rows' taps [n, taps * D], first position) for each stream; a gap starts its context over."""
+
+        rows: list[tuple[int, int]] = []                  # (slot, position) a row
+        chunks = []
+        for st, taps, at in parts:
+            i = self.index[id(st)]
+            if at != self.end[i]:
+                self.end[i] = self.lo[i] = at
+            n = taps.shape[0]
+            rows += [(i, at + r) for r in range(n)]
+            chunks.append(taps)
+            self.end[i] = at + n
+        if not rows:
+            return
+        allt = chunks[0] if len(chunks) == 1 else torch.cat(chunks)
+        for start in range(0, len(rows), TAP_ROWS):
+            part = rows[start:start + TAP_ROWS]
+            n = len(part)
+            bucket = -(-n // 8) * 8
+            meta = self.t_host.numpy()
+            meta[0, :bucket], meta[1, :bucket], meta[2, :bucket] = self.S, 0, 0       # padding: the spare ring
+            for r, (i, p) in enumerate(part):
+                meta[0, r], meta[1, r], meta[2, r] = i, p % self.cap, p
+            self.t_meta.copy_(self.t_host, non_blocking=True)
+            self.t_in[:n].copy_(allt[start:start + n])
+            g = self.tap_graphs.get(bucket)
+            if g is not None:
+                g.replay()
+            else:
+                self._taps_compute(bucket)
+
+    # -- drafts -------------------------------------------------------------------------------------------------
+    def _block_compute(self, count: int) -> None:
+        """[pending, mask x (block - 1)] for ``count`` streams at their contexts' ends: candidates and selector rows."""
+
+        n = self.block
+        R = count * n
+        slots, pos, lo = self.b_meta[1, :count], self.b_meta[2, :count], self.b_meta[3, :count]
+        x = torch.empty((R, self.D), dtype=torch.bfloat16, device=self.dev)
