+_SHARDS_TO_DROP: List[str] = []
+
+
+def drop_loaded_shard_caches() -> None:
+    """After a model is loaded: drop the page cache of every shard the prefaulting iterator read. The per-shard drop
+    during the load frees nothing while a shard's pages are still mapped by live tensors, and on this unified-memory
+    box cudaMemGetInfo does not count that cache as free, so ~9-40 GB stayed cached and the KV pool came out smaller."""
+    if not _SHARDS_TO_DROP:
+        return
+    import gc
+
+    gc.collect()
+    for st_file in _SHARDS_TO_DROP:
+        _drop_file_cache_after_load(st_file)
+    _SHARDS_TO_DROP.clear()
+    try:
+        import ctypes
+
+        ctypes.CDLL("libc.so.6").malloc_trim(0)
+    except OSError:
+        pass
+
+
+def _prefault_enabled() -> bool:
+    return os.environ.get("SGLANG_LOAD_PREFAULT", "0") == "1"
+
+
+def _read_into_page_cache(path: str, chunk: int = 64 << 20) -> None:
+    """Sequential read of a shard (the NVMe reads 5.6 GB/s this way; page faults read it at ~0.4 GB/s)."""
+    view = memoryview(bytearray(chunk))
+    with open(path, "rb", buffering=0) as f:
+        try:
+            os.posix_fadvise(f.fileno(), 0, 0, os.POSIX_FADV_SEQUENTIAL)
+        except (AttributeError, OSError):
+            pass
+        while f.readinto(view):
+            pass
+
+
+def _prefault(t: torch.Tensor) -> None:
+    """Map every page of an mmap-backed tensor into this process (one byte read per 4 KiB page).
+
+    On a DGX Spark (GB10, CUDA 13, driver 580) cudaMemcpy from mmap'd safetensors pages that this process has not
+    touched yet runs at ~0.15 GB/s (10 ms for a 1.5 MB expert tensor), even with the file in the page cache; once the
+    pages are mapped it runs at ~37 GB/s. The loader workers do this in parallel, ahead of the copies."""
+    if t.numel() == 0:
+        return
+    b = t.reshape(-1).view(torch.uint8)
+    b[::4096].sum()
+
+
