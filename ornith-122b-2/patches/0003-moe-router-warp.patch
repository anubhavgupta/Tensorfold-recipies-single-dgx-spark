+    pub fn routeWarp(f: Fns, s: Stream, x: u64, x_stride: usize, rows: usize, w: u64, logits: u64, dims: usize, count: usize, params: u64) !void {
+        const fw = f.router_warp_fn orelse return f.route(s, x, x_stride, rows, w, logits, dims, count, params);
