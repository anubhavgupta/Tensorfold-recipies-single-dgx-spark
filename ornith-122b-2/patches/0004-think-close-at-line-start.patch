+    const a = std.testing.allocator;
+    // a toy vocabulary: id 9 is the close token, the rest one piece of text each
+    const Toy = struct {
+        const pieces = [_][]const u8{ "Plan: emit `", "` then a call.", "\n", "\n\nDone.", "```\n", "\n```\n", "x", "a ```py", "", "</think>" };
+        fn decode(_: void, al: Allocator, ids: []const u32) ![]u8 {
+            var out: std.ArrayList(u8) = .empty;
+            for (ids) |i| try out.appendSlice(al, pieces[i]);
+            return out.toOwnedSlice(al);
+        }
