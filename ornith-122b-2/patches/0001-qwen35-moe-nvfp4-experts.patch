diff --git a/zig/src/families/qwen3_5/cuda_modelopt_experts.zig b/zig/src/families/qwen3_5/cuda_modelopt_experts.zig
new file mode 100644
index 00000000..3c8af51e
--- /dev/null
+++ b/zig/src/families/qwen3_5/cuda_modelopt_experts.zig
@@ -0,0 +1,130 @@
+//! A ModelOpt checkpoint's routed experts (qwen3_5_moe, e.g. Ornith-1.5-122B-NVFP4): NVFP4 codes, e4m3 block scales
+//! and an fp32 global scale per projection, read as stored and packed for cuda.experts.Nvfp4Experts (bf16 rows in).
+//! The shared expert is packed last in the same tables, as the affine and EXL3 loaders stack it.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const engine = @import("cuda_engine.zig");
+const geometry = @import("cuda_geometry.zig");
+
+const Engine = engine.Engine;
+const X = cuda.experts.Nvfp4Experts;
+const aligned = engine.aligned;
+
+/// Experts packed on the host at once: bounds the host buffers (~85 MiB of packed words an expert pair at 122B).
+const chunk = 32;
+
+/// A layer's device bytes: the gate-up pair table, the down table, their global scales and the router's bf16 rows.
+pub fn bytes(g: geometry.Geometry) usize {
+    const count = g.experts + 1;
+    return aligned(X.bytes(count, g.intermediate, g.hidden, 2)) + aligned(X.bytes(count, g.hidden, g.intermediate, 1)) +
+        aligned(count * 2 * 4) + aligned(count * 4) + aligned(count * g.hidden * 2);
+}
+
+/// One projection as stored: codes [n][k/2] (low nibble first), e4m3 scales [n][k/16], the fp32 global scale.
+const Part = struct { codes: []const u8, scales: []const u8, global: f32 };
+
+fn part(ck: *core.Checkpoint, base: []const u8, n: usize, k: usize) !Part {
+    var buf: [200]u8 = undefined;
+    const codes = try ck.expect(try std.fmt.bufPrint(&buf, "{s}.weight", .{base}), .u8, &.{ n, k / 2 });
+    const scales = try ck.expect(try std.fmt.bufPrint(&buf, "{s}.weight_scale", .{base}), .f8_e4m3, &.{ n, k / 16 });
+    const t = try ck.get(try std.fmt.bufPrint(&buf, "{s}.weight_scale_2", .{base}));
+    if (t.dtype != .f32 or t.bytes.len != 4) return error.UnexpectedTensor;
+    const global: f32 = @bitCast(std.mem.readInt(u32, t.bytes[0..4], .little));
+    if (!std.math.isFinite(global) or global <= 0) return error.UnexpectedTensor;
+    return .{ .codes = codes.bytes, .scales = scales.bytes, .global = global };
+}
+
+/// Packs experts [from, to) of a chunk: worker `w` of `n` takes every n-th one.
+const Job = struct {
+    parts: []const [3]Part,
+    up: []u32,
+    down: []u32,
+    up_len: usize,
+    down_len: usize,
+    ni: usize,
+    d: usize,
+
+    fn run(j: *const Job, w: usize, n: usize) void {
+        var i = w;
+        while (i < j.parts.len) : (i += n) {
+            const p = j.parts[i];
+            X.packGateUp(j.up[i * j.up_len ..][0..j.up_len], .{ p[0].codes, p[0].scales }, .{ p[1].codes, p[1].scales }, j.ni, j.d);
+            X.packOne(j.down[i * j.down_len ..][0..j.down_len], p[2].codes, p[2].scales, j.d, j.ni);
+        }
+    }
+};
+
+/// The router as bf16 [experts + 1][hidden]: the gate's rows, then shared_expert_gate's (both stored bf16).
+fn router(e: *Engine, ck: *core.Checkpoint, p: []const u8) !u64 {
+    const g = e.g;
+    var buf: [200]u8 = undefined;
+    const a = try ck.expect(try std.fmt.bufPrint(&buf, "{s}mlp.gate.weight", .{p}), .bf16, &.{ g.experts, g.hidden });
+    const b = try ck.expect(try std.fmt.bufPrint(&buf, "{s}mlp.shared_expert_gate.weight", .{p}), .bf16, &.{ 1, g.hidden });
+    const out = try e.alloc(a.bytes.len + b.bytes.len);
+    try e.arena.upload(out - e.arena.ptr, a.bytes);
+    try e.arena.upload(out - e.arena.ptr + a.bytes.len, b.bytes);
+    return out;
+}
+
+/// Layer `p`'s routed experts (the shared one last) packed into the engine's arena, and its router rows.
+pub fn load(e: *Engine, ck: *core.Checkpoint, p: []const u8) !engine.Mlp {
+    const g = e.g;
+    const gpa = e.gpa;
+    const ni = g.intermediate;
+    const d = g.hidden;
+    const count = g.experts + 1;
+    if (ni % X.cols != 0 or d % X.cols != 0) return error.UnsupportedQwenGeometry;
+    const up_len = X.bytes(1, ni, d, 2) / 4;
+    const down_len = X.bytes(1, d, ni, 1) / 4;
+    const up = try e.alloc(count * up_len * 4);
+    const down = try e.alloc(count * down_len * 4);
+    const up_scale = try e.alloc(count * 2 * 4);
+    const down_scale = try e.alloc(count * 4);
+    const hu = try gpa.alloc(u32, chunk * up_len);
+    defer gpa.free(hu);
+    const hd = try gpa.alloc(u32, chunk * down_len);
+    defer gpa.free(hd);
+    const us = try gpa.alloc(f32, count * 2);
+    defer gpa.free(us);
+    const ds = try gpa.alloc(f32, count);
+    defer gpa.free(ds);
+    var parts: [chunk][3]Part = undefined;
+    const workers = @min(chunk, @max(1, std.Thread.getCpuCount() catch 1));
+    var buf: [200]u8 = undefined;
+    var e0: usize = 0;
+    while (e0 < count) : (e0 += chunk) {
+        const ec = @min(chunk, count - e0);
+        for (0..ec) |j| {
+            const x = e0 + j;
+            for ([_][]const u8{ "gate_proj", "up_proj", "down_proj" }, 0..) |mod, m| {
+                const base = if (x < g.experts) try std.fmt.bufPrint(&buf, "{s}mlp.experts.{d}.{s}", .{ p, x, mod }) else try std.fmt.bufPrint(&buf, "{s}mlp.shared_expert.{s}", .{ p, mod });
+                parts[j][m] = try part(ck, base, if (m == 2) d else ni, if (m == 2) ni else d);
+            }
+            us[x * 2] = parts[j][0].global;
+            us[x * 2 + 1] = parts[j][1].global;
+            ds[x] = parts[j][2].global;
+        }
+        const job: Job = .{ .parts = parts[0..ec], .up = hu, .down = hd, .up_len = up_len, .down_len = down_len, .ni = ni, .d = d };
+        const n = @min(workers, ec);
+        var threads: [chunk]?std.Thread = @splat(null);
+        for (1..n) |w| threads[w] = std.Thread.spawn(.{}, Job.run, .{ &job, w, n }) catch null;
+        job.run(0, n);
+        for (1..n) |w| if (threads[w]) |t| t.join() else job.run(w, n); // a worker that did not start: its share here
+        try e.arena.upload(up - e.arena.ptr + e0 * up_len * 4, std.mem.sliceAsBytes(hu[0 .. ec * up_len]));
+        try e.arena.upload(down - e.arena.ptr + e0 * down_len * 4, std.mem.sliceAsBytes(hd[0 .. ec * down_len]));
+    }
+    try e.arena.upload(up_scale - e.arena.ptr, std.mem.sliceAsBytes(us));
+    try e.arena.upload(down_scale - e.arena.ptr, std.mem.sliceAsBytes(ds));
+    const layer: cuda.experts.Layer = .{ .format = .nvfp4, .up = up, .down = down, .up_scale = up_scale, .down_scale = down_scale, .width = ni, .dims = d, .experts = count };
+    return .{ .moe = .{ .router = try router(e, ck, p), .experts = layer } };
+}
+
+test "a layer's bytes hold both tables, their scales and the router's rows" {
+    var g: geometry.Geometry = undefined;
+    g.experts = 2;
+    g.intermediate = 64;
+    g.hidden = 256;
+    const want = aligned(X.bytes(3, 64, 256, 2)) + aligned(X.bytes(3, 256, 64, 1)) + aligned(24) + aligned(12) + aligned(3 * 256 * 2);
+    try std.testing.expectEqual(want, bytes(g));
+}
