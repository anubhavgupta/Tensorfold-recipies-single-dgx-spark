+/// TENSORFOLD_THINK_LINE_CLOSE=0: a think block ends at its first ``</think>`` anywhere (stock).
+fn lineClose() bool {
+    const S = struct {
+        var v: ?bool = null;
+    };
+    if (S.v == null) S.v = if (std.c.getenv("TENSORFOLD_THINK_LINE_CLOSE")) |e| !std.mem.eql(u8, std.mem.span(e), "0") else true;
+    return S.v.?;
+}
+
+/// Where a ``</think>`` block ends. A reasoning that quotes the tag (a chat template, a parser) writes it inline, e.g.
+/// ``outputs `<think>\n\n</think>` ``, while Qwen's models close their reasoning with ``\n</think>\n\n``: the end is
+/// the first ``</think>`` that starts a line outside a ``` fence. A finished reply with no such closer falls back to
+/// its first ``</think>``; while streaming, an inline one stays reasoning.
+fn thinkClose(text: []const u8, close: []const u8, finished: bool) ?usize {
+    if (!std.mem.eql(u8, close, think_markers.close) or !lineClose()) return find(text, close);
+    return lineCloseAt(text, close, finished);
+}
+
+fn lineCloseAt(text: []const u8, close: []const u8, finished: bool) ?usize {
+    var first: ?usize = null;
+    var at: usize = 0;
+    while (findTag(text, at, close)) |i| {
+        if (first == null) first = i;
+        if ((i == 0 or text[i - 1] == '\n') and std.mem.count(u8, text[0..i], "```") % 2 == 0) return i;
+        at = i + close.len;
+    }
+    return if (finished) first else null;
+}
