+// (passes of 16 rows one weight decode serves, column parts): MP x 64 / CS accumulators a thread.
+// TENSORFOLD_EXL3_MP=1 is the stock kernel (a decode every 16 rows).
+inline int max_mp() {
+    static const int v = [] {
+        const char* e = std::getenv("TENSORFOLD_EXL3_MP");
+        return e ? std::max(1, std::atoi(e)) : 4;
+    }();
+    return v;
+}
+
+inline void mp_cs(int M, bool shuffled, int& mp, int& cs) {
+    // measured on GB10: 4 passes in 2 column parts beat 2 x 2 passes for 49-64 rows (and 2 sweeps of them 3 x 3 passes
+    // for 97-128); 6 or 8 passes a decode, or 4 column parts, lose (register pressure, per-block activation reads)
+    const int need = (M + 15) / 16, cap = max_mp();
+    if ((need == 4 || need >= 7) && !shuffled && cap >= 4) { mp = 4; cs = 2; }
+    else { mp = std::min({need, 3, cap}); cs = 1; }
+}
+
+template <int K2, int CB, int W_>
+auto pick_wk(int mp, int cs) {
+    if constexpr (K2 == 2 || K2 == 4) {
+        return mp == 1 ? linear_kernel<K2, CB, W_, 1, 1> : mp == 2 ? linear_kernel<K2, CB, W_, 2, 1>
+                                                                   : linear_kernel<K2, CB, W_, 3, 1>;
+    } else {
+        return mp == 1 ? linear_kernel<K2, CB, W_, 1, 1> : mp == 2 ? linear_kernel<K2, CB, W_, 2, 1>
+             : mp == 3 ? linear_kernel<K2, CB, W_, 3, 1> : linear_kernel<K2, CB, W_, 4, 2>;
+    }
+}
+
+template <int K2, int CB>
+auto pick_kernel(int64_t WK, int mp, int cs) {
+    return WK == 2 ? pick_wk<K2, CB, 2>(mp, cs) : WK == 4 ? pick_wk<K2, CB, 4>(mp, cs) : pick_wk<K2, CB, 8>(mp, cs);
+}
