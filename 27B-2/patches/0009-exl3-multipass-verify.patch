+// passes of 16 rows one weight decode serves (3 at most: 4 spill registers); TENSORFOLD_EXL3_MP=1 is the stock kernel
+inline int max_mp() {
+    static const int v = [] {
+        const char* e = std::getenv("TENSORFOLD_EXL3_MP");
+        const int x = e ? std::atoi(e) : 3;
+        return x >= 3 ? 3 : x >= 2 ? 2 : 1;
+    }();
+    return v;
+}
+
+template <int K2, int CB>
+auto pick_kernel(int64_t WK, int M) {
+    const int need = (M + 15) / 16, mp = std::min(max_mp(), need <= 3 ? need : need == 4 ? 2 : 3);
+#define TF_MP(W_) (mp == 1 ? linear_kernel<K2, CB, W_, 1> : mp == 2 ? linear_kernel<K2, CB, W_, 2> \
+                                                         : linear_kernel<K2, CB, W_, 3>)
+    return WK == 2 ? TF_MP(2) : WK == 4 ? TF_MP(4) : TF_MP(8);
+#undef TF_MP
+}
