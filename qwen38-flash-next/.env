# Settings for ./qwen38-flash-next/start.sh. Read before that script's own defaults, so a line here only
# changes what it sets; a variable already in the environment (e.g. `PARALLEL=3 ./qwen38-flash-next/start.sh`)
# wins over this file either way. This file is yours, never executed as a script - KEY=value lines, '#'
# comments, quotes optional. Delete it (or ENV_FILE=/dev/null) to run on pure script defaults.
#
# Uncomment and edit a line to override; everything below is already the script's own default.

# MODEL_ID=Vontra/Qwen3.8-Flash-Next-MLX-4bit-MTP
# SERVED_NAME=Qwen3.8-Flash-Next
# HOST=0.0.0.0
# PORT=8888
# NAME=tf-qwen38-flash-next
# FOREGROUND=0
# PATCHES=1              # 0: plain stock image, without the patches in ./patches

# Serving: --parallel 5 --context 262144 --kv-dtype int8 is ~85.75 GiB (~4.47 GiB/stream, 34 GiB free for
# caches on a 128 GB Spark). PARALLEL=6 also fits (~90 GiB); other fits: 3 streams bf16 at 262k, 6-8
# streams int8/int4 at a shorter CONTEXT.
# PARALLEL=5
# CONTEXT=262144
# KV_DTYPE=int8          # bf16 | int8 | int4
# PLE_ON_SSD=1           # 1: read the 29.8 GiB n-gram tables from SSD, leaving that RAM to the KV cache

# Vision (image and video input)
# VISION=1
# VISION_MAX_IMAGES=50
# VISION_IMAGE_TOKENS=16384

# MTP drafting: swept 2026-09-29, 6 drafts / 0.60 confidence beat TensorFold's own 6/0.70 default by
# ~3-4% with identical output.
# MTP_DRAFTS=6
# MTP_CONFIDENCE=0.60

# Sampling: Qwen's recommendation, switching with THINKING. Thinking mode: temperature 1.0, top_p 0.95.
# Instruct/non-thinking mode: temperature 0.7, top_p 0.80. top_k is the same either way.
# (Qwen also recommends presence_penalty 1.5 in instruct mode and a repetition_penalty, but TensorFold
# has neither setting, so they can't be applied.) Reply behaviour:
# THINKING=1
# MAX_TOKENS=32768
# TEMPERATURE=1.0        # instruct/non-thinking mode default: 0.7
# TOP_P=0.95             # instruct/non-thinking mode default: 0.80
# TOP_K=20

# TensorFold switches (exported as TENSORFOLD_*, passed straight into the container)
# TENSORFOLD_VIDEO_TOKENS=16384
# TENSORFOLD_MEMORY_RESERVE_GIB=2
# TENSORFOLD_MTP_COPY=1               # prompt-lookup drafts ahead of MTP (patches/); PATCHES=0 ignores it
# TENSORFOLD_NO_UPDATE_CHECK=1
# TENSORFOLD_PREFILL_ROWS=2048        # only applied by the script when PLE_ON_SSD=1
# TENSORFOLD_VISION_WORKSPACE_MIB=0   # 0: scratch comes from the system reserve only while encoding
TF_VERSION=0.6.5
