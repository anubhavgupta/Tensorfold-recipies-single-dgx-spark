+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+void qmm_tern_pq2_cuda(const at::Tensor& x, const at::Tensor& xs, const std::vector<at::Tensor>& ws,
+                       const std::vector<at::Tensor>& scales, std::vector<at::Tensor>& outs,
+                       const std::vector<int64_t>& ns, const std::vector<int64_t>& sks, bool f32, int tile, int pdl);
+void qmm_tern_prefill_cuda(const at::Tensor& x, const at::Tensor& w, const at::Tensor& scales, at::Tensor& out,
+                           int N, bool f32, int tile);
+void qmm_tern_prefill8_cuda(const at::Tensor& x, const at::Tensor& xs, const at::Tensor& a, const at::Tensor& w,
+                            const at::Tensor& scales, at::Tensor& out, int N, bool f32, int tile);
+
+void pq2_group(const at::Tensor& x, const at::Tensor& xs, const std::vector<at::Tensor>& ws,
+               const std::vector<at::Tensor>& scales, std::vector<at::Tensor> outs,
+               const std::vector<int64_t>& ns, const std::vector<int64_t>& sks, bool f32, int64_t tile, int64_t pdl) {
+    const size_t parts = ws.size();
+    TORCH_CHECK(parts >= 1 && parts <= 4 && scales.size() == parts && outs.size() == parts && ns.size() == parts &&
+                sks.size() == parts, "one to four PQ2 parts");
+    TORCH_CHECK(x.is_cuda() && x.scalar_type() == at::kBFloat16 && x.dim() == 2 && x.size(0) >= 1 &&
+                x.stride(1) == 1 && x.stride(0) >= x.size(1), "x: (M, K) bf16 with contiguous rows");
+    TORCH_CHECK(reinterpret_cast<uintptr_t>(x.data_ptr()) % 16 == 0 && (x.size(0) == 1 || x.stride(0) % 8 == 0),
+                "x rows must start on 16-byte boundaries");
+    const int64_t m = x.size(0), k = x.size(1), kg64 = k / 64, kg128 = k / 128;
+    TORCH_CHECK(k % 128 == 0 && xs.is_cuda() && xs.is_contiguous() && xs.scalar_type() == at::kFloat &&
+                xs.size(0) == m && xs.size(1) == kg64, "K multiple of 128; xs: (M, K/64) fp32");
+    for (size_t i = 0; i < parts; ++i) {
+        const int64_t n = ns[i], npad = (n + 127) / 128 * 128, sk = sks[i];
+        TORCH_CHECK(sk == 1 || sk == 2 || sk == 4 || sk == 8, "K split 1, 2, 4 or 8");
+        TORCH_CHECK(kg64 % sk == 0 && (kg64 / sk) % 2 == 0, "K splits into whole 128-groups per slice");
+        TORCH_CHECK(ws[i].is_cuda() && ws[i].is_contiguous() && ws[i].scalar_type() == at::kInt &&
+                    ws[i].numel() == npad * k / 16, "PQ2 lane weight does not match n and K");
+        TORCH_CHECK(scales[i].is_cuda() && scales[i].scalar_type() == at::kHalf && scales[i].dim() == 2 &&
+                    scales[i].stride(1) == 1 && scales[i].stride(0) >= npad && scales[i].size(0) == kg128 &&
+                    scales[i].size(1) == npad, "scales: fp16 (K/128, n padded to 128), rows may be strided");
+        TORCH_CHECK(outs[i].is_cuda() && outs[i].is_contiguous() && outs[i].size(0) == m && outs[i].size(1) == n &&
+                    outs[i].scalar_type() == (f32 ? at::kFloat : at::kBFloat16), "out: (M, n)");
+    }
+    c10::cuda::CUDAGuard guard(x.device());
+    qmm_tern_pq2_cuda(x, xs, ws, scales, outs, ns, sks, f32, static_cast<int>(tile), static_cast<int>(pdl));
+}
+
+
+void prefill_matmul(const at::Tensor& x, const at::Tensor& w, const at::Tensor& scales, at::Tensor out,
+                    int64_t n, bool f32, int64_t tile) {
+    TORCH_CHECK(x.is_cuda() && x.scalar_type() == at::kBFloat16 && x.dim() == 2 && x.size(0) >= 1 &&
+                x.stride(1) == 1 && x.stride(0) >= x.size(1), "x: (M, K) bf16 with contiguous rows");
+    TORCH_CHECK(reinterpret_cast<uintptr_t>(x.data_ptr()) % 16 == 0 && (x.size(0) == 1 || x.stride(0) % 8 == 0),
+                "x rows must start on 16-byte boundaries");
+    const int64_t k = x.size(1), kg64 = k / 64, kg128 = k / 128, npad = (n + 127) / 128 * 128;
+    TORCH_CHECK(k % 128 == 0 && w.is_cuda() && w.is_contiguous() && w.scalar_type() == at::kInt &&
+                w.numel() == npad * k / 16, "PQ2 lane weight does not match n and K");
+    TORCH_CHECK(scales.is_cuda() && scales.scalar_type() == at::kHalf && scales.dim() == 2 && scales.stride(1) == 1 &&
+                scales.stride(0) >= npad && scales.size(0) == kg128 && scales.size(1) == npad,
+                "scales: fp16 (K/128, n padded to 128), rows may be strided");
+    TORCH_CHECK(out.is_cuda() && out.is_contiguous() && out.size(0) == x.size(0) && out.size(1) == n &&
+                out.scalar_type() == (f32 ? at::kFloat : at::kBFloat16), "out: (M, n)");
+    TORCH_CHECK(kg64 > 0, "empty K");
+    c10::cuda::CUDAGuard guard(x.device());
+    qmm_tern_prefill_cuda(x, w, scales, out, static_cast<int>(n), f32, static_cast<int>(tile));
+}
+
+void prefill_matmul8(const at::Tensor& x, const at::Tensor& xs, const at::Tensor& a, const at::Tensor& w,
+                     const at::Tensor& scales, at::Tensor out, int64_t n, bool f32, int64_t tile) {
+    TORCH_CHECK(x.is_cuda() && x.scalar_type() == at::kByte && x.dim() == 2 && x.is_contiguous(),
+                "x8: contiguous uint8 (M, K)");
+    const int64_t m = x.size(0), k = x.size(1), kg64 = k / 64, kg128 = k / 128, npad = (n + 127) / 128 * 128;
+    TORCH_CHECK(k % 128 == 0 && xs.is_cuda() && xs.scalar_type() == at::kBFloat16 && xs.is_contiguous() &&
+                xs.size(0) == m && xs.size(1) == kg64, "xs: contiguous bf16 (M, K/64)");
+    TORCH_CHECK(a.is_cuda() && a.scalar_type() == at::kFloat && a.is_contiguous() && a.numel() == m,
+                "a: contiguous fp32 (M)");
+    TORCH_CHECK(w.is_cuda() && w.is_contiguous() && w.scalar_type() == at::kInt && w.numel() == npad * k / 16,
+                "PQ2 lane weight does not match n and K");
+    TORCH_CHECK(scales.is_cuda() && scales.scalar_type() == at::kHalf && scales.dim() == 2 && scales.stride(1) == 1 &&
+                scales.stride(0) >= npad && scales.size(0) == kg128 && scales.size(1) == npad,
+                "scales: fp16 (K/128, n padded to 128), rows may be strided");
+    TORCH_CHECK(out.is_cuda() && out.is_contiguous() && out.size(0) == m && out.size(1) == n &&
+                out.scalar_type() == (f32 ? at::kFloat : at::kBFloat16), "out: (M, n)");
+    c10::cuda::CUDAGuard guard(x.device());
+    qmm_tern_prefill8_cuda(x, xs, a, w, scales, out, static_cast<int>(n), f32, static_cast<int>(tile));
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("pq2_group", &pq2_group, "Fast Bonsai PQ2 grouped decode: 2-bit lane weights, fp16 scale per 128, implicit -scale bias");
+    m.def("prefill_matmul", &prefill_matmul, "Bonsai PQ2 bf16 prefill GEMM");
+    m.def("prefill_matmul8", &prefill_matmul8, "Bonsai PQ2 FP8/int8-row prefill GEMM");
+}
--- tensorfold/cuda/kernels/qmm_tern.cu
