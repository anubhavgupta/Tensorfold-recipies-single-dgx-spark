+    if x.dtype != torch.bfloat16 or x.dim() != 2 or x.shape[1] % gs:
+        raise ValueError("x must be bf16 (M, K multiple of group size)")
+    xf = x.float().reshape(x.shape[0], x.shape[1] // gs, gs)
+    scale = (xf.abs().amax(dim=2) / 127.0).clamp_min(1.0e-8)
+    q = torch.round(xf / scale[..., None]).clamp(-127, 127).to(torch.int8).reshape_as(x).contiguous()
