+#pragma once
+
+#include <cuda_fp16.h>
+#include <cuda_bf16.h>
+#include <stdint.h>
+
+namespace qmm_tern {
+
+// Lossless base-3 archival/prefill payload: 26 bytes per 128 trits plus one fp16 scale.
+static constexpr int TERN_GROUP = 128;
+static constexpr int TERN_PAYLOAD_BYTES = 26;
+static constexpr int TERN_MAIN_BYTES = 24;
+static constexpr int TERN_TAIL_BYTES = 2;
+
+__host__ __device__ __forceinline__ uint8_t tern_extract5(uint8_t packed, int i) {
+    static constexpr uint8_t pow3[5] = {1, 3, 9, 27, 81};
+    return (packed / pow3[i]) % 3;
+}
+
+__host__ __device__ __forceinline__ uint8_t tern_extract4(uint8_t packed, int i) {
+    static constexpr uint8_t pow3[4] = {1, 3, 9, 27};
+    return (packed / pow3[i]) % 3;
+}
+
+__device__ __forceinline__ uint8_t tern_payload_get(const uint8_t* payload, int k) {
+    if (k < 120) return tern_extract5(payload[k / 5], k % 5);
+    return tern_extract4(payload[24 + (k - 120) / 4], (k - 120) % 4);
+}
+
+// Fast decode fallback/recommended serving layout (PQ2): the exact qmm_group2 lane order.
+// Tensor shape is int32 [npad/64][K/64][8][32][1].  For one output-row tile and one
+// 64-input group, lane l loads one uint32: low 16 bits are eight 2-bit codes for
+// inputs 32*0 + 2*(l%4) + {0,8,16,24,1,9,17,25}; high 16 bits are the same for
+// inputs 32*1 + ... .  The CUDA kernel expands the two halves with spread2() into
+// qmm_group's nibble words and reuses its bf16 MMA path.  Scales are fp16
+// [K/128][npad], one scale for two adjacent 64-input groups; bias is implicit -scale.
+static constexpr int PQ2_GROUP = 128;
+static constexpr int PQ2_PAYLOAD_BITS = 256; // per 128 weights, plain 2-bit codes
+static constexpr int PQ2_TOTAL_BITS = 272;   // payload + one fp16 scale = 2.125 bpw
+
+} // namespace qmm_tern
