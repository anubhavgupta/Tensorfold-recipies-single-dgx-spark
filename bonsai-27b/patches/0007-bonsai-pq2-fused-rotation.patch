+"""Prism Bonsai ternary (PTQ1_0-style) decode kernels.
+
+The format keeps one fp16 scale per 128 weights and stores the ternary codes
+0/1/2 in 26 base-3 payload bytes, so each group is 28 bytes including scale
+(1.75 bits/weight total). Kernels support decode/speculative batches M=1..32.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+GROUP = 128
+PAYLOAD_BYTES = 26
+_POW5 = torch.tensor([1, 3, 9, 27, 81], dtype=torch.int16)
+_POW4 = torch.tensor([1, 3, 9, 27], dtype=torch.int16)
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tensorfold_qmm_tern_v3", sources=[str(here / "qmm_tern.cpp"), str(here / "qmm_tern.cu")],
+                extra_cuda_cflags=["-O3"], verbose=False)
+
+
+@dataclass
+class TQ:
+    """Packed ternary weight.
+
+    payload: uint8 (n, k/128, 26), row-major. scales: fp16 (n, k/128).
+    Both tensors may be row-slice views. ``n`` is logical rows; no row padding is
+    required by this extension, which makes odd row counts and views cheap.
+    """
+
+    payload: torch.Tensor | None
+    scales: torch.Tensor | None
+    n: int
+    k: int
+    row0: int = 0
+    pq2: torch.Tensor | None = None
+    pq2_scales: torch.Tensor | None = None
+
+    @property
+    def kg(self) -> int:
+        return self.k // GROUP
+
+    def nbytes(self) -> int:
+        if self.pq2 is not None and self.pq2_scales is not None:
+            return self.pq2.numel() * self.pq2.element_size() + self.pq2_scales.numel() * self.pq2_scales.element_size()
+        if self.payload is None or self.scales is None:
+            return 0
+        return self.payload.numel() * self.payload.element_size() + self.scales.numel() * self.scales.element_size()
+
+    def rows(self, a: int, b: int) -> "TQ":
+        return rows(self, a, b)
+
+
+def _as_i32_words(weight: torch.Tensor) -> torch.Tensor:
+    if weight.dtype not in (torch.int32, torch.uint32):
+        raise ValueError("weight words must be int32/uint32")
+    return weight.view(torch.int32) if weight.dtype != torch.int32 else weight
+
+
+def _codes_from_words(words: torch.Tensor) -> torch.Tensor:
+    shifts = torch.arange(0, 32, 2, dtype=torch.int32, device=words.device)
+    return ((words[..., None] >> shifts) & 3).to(torch.uint8).reshape(words.shape[0], words.shape[1] * 16)
+
+
+def _pack_codes(codes: torch.Tensor) -> torch.Tensor:
+    n, k = codes.shape
+    if k % GROUP:
+        raise ValueError("K must be a multiple of 128")
+    kg = k // GROUP
+    dev = codes.device
+    c = codes.reshape(n, kg, GROUP).to(torch.int16)
+    pow5 = _POW5.to(dev)
+    pow4 = _POW4.to(dev)
+    payload = torch.empty((n, kg, PAYLOAD_BYTES), dtype=torch.uint8, device=dev)
+    payload[:, :, :24] = (c[:, :, :120].reshape(n, kg, 24, 5) * pow5).sum(-1).to(torch.uint8)
+    payload[:, :, 24:] = (c[:, :, 120:].reshape(n, kg, 2, 4) * pow4).sum(-1).to(torch.uint8)
+    return payload.contiguous()
+
+
+
+
+def _to_int32(v: torch.Tensor) -> torch.Tensor:
+    return torch.where(v >= 2 ** 31, v - 2 ** 32, v).to(torch.int32)
+
+
+def _lane_offsets(device) -> torch.Tensor:
+    # Same order as tensorfold.cuda.kernels.qmm._offsets(64): input 32*v + 2*c + OFFSETS[p].
+    offs = torch.tensor([0, 8, 16, 24, 1, 9, 17, 25], device=device)
+    v = torch.arange(2, device=device)[:, None, None]
+    c = torch.arange(4, device=device)[None, :, None]
+    return 32 * v + 2 * c + offs[None, None, :]
+
+
+def _pack_pq2_lane(codes: torch.Tensor, chunk: int = 4096) -> torch.Tensor:
+    """Codes (n,k) -> existing qmm_group2 lane layout [npad/64][k/64][8][32][1]."""
+    n, k = map(int, codes.shape)
+    npad = -(-n // 128) * 128
+    kg = k // 64
+    dev = codes.device
+    out = torch.empty((npad // 64, kg, 8, 32, 1), dtype=torch.int32, device=dev)
+    offs = _lane_offsets(dev)
+    shifts = (torch.arange(8, device=dev, dtype=torch.int64) * 2)
+    for start in range(0, npad, chunk):
+        stop = min(start + chunk, npad)
+        rows = stop - start
+        block = torch.zeros((rows, k), dtype=torch.uint8, device=dev)
+        if start < n:
+            block[:min(stop, n) - start] = codes[start:min(stop, n)]
+        q = block.reshape(rows, kg, 64).reshape(rows // 64, 8, 8, kg, 64)
+        picked = q[..., offs]  # (T,j,r,kg,V=2,c=4,p=8)
+        lo = ((picked[..., 0, :, :].to(torch.int64) << shifts).sum(-1))
+        hi = ((picked[..., 1, :, :].to(torch.int64) << shifts).sum(-1))
+        w = _to_int32(lo | (hi << 16))  # (T,j,r,kg,c)
+        out[start // 64:stop // 64] = w.permute(0, 3, 1, 2, 4).reshape(rows // 64, kg, 8, 32, 1)
+    return out.contiguous()
+
+
+def _major_scales(scales: torch.Tensor, n: int) -> torch.Tensor:
+    kg = scales.shape[1]
+    npad = -(-n // 128) * 128
+    out = torch.zeros((kg, npad), dtype=torch.float16, device=scales.device)
+    out[:, :n] = scales.to(torch.float16).t().contiguous()
+    return out.contiguous()
+
+
+def pack_codes(codes: torch.Tensor, scales_fp16: torch.Tensor, *, keep_base3: bool = True) -> TQ:
+    """Pack explicit uint8 codes (n, k) and fp16 scales (n, k/128)."""
+
+    if codes.dtype != torch.uint8 or codes.dim() != 2:
+        raise ValueError("codes must be uint8 (n, k)")
+    if bool((codes > 2).any()):
+        raise ValueError("ternary codes must be <= 2")
+    n, k = map(int, codes.shape)
+    if scales_fp16.shape != (n, k // GROUP):
+        raise ValueError("scales must be (n, k/128)")
+    sc = scales_fp16.to(torch.float16).contiguous()
+    payload = _pack_codes(codes) if keep_base3 else None
+    return TQ(payload, sc if keep_base3 else None, n, k, pq2=_pack_pq2_lane(codes), pq2_scales=_major_scales(sc, n))
+
+
+def pack_mlx(weight_int32: torch.Tensor, scales_fp16: torch.Tensor, biases_fp16: torch.Tensor, *, keep_base3: bool = False) -> TQ | None:
+    """MLX 2-bit affine words -> TQ, or None if the weight is not lossless ternary.
+
+    ``weight_int32`` is (n, k/16) with code p in bits 2p. ``scales`` and
+    ``biases`` are (n, k/128). Bonsai ternary requires all codes <= 2 and
+    bias == -scale bitwise/numerically after fp16 conversion.
+    """
+
+    words = _as_i32_words(weight_int32)
+    if words.dim() != 2:
+        raise ValueError("weight must be a 2-D word matrix")
+    n, w = map(int, words.shape)
+    k = w * 16
+    if k % GROUP or tuple(scales_fp16.shape) != (n, k // GROUP) or tuple(biases_fp16.shape) != (n, k // GROUP):
+        raise ValueError("shape mismatch for 2-bit group-128 affine weight")
+    s = scales_fp16.to(torch.float16)
+    b = biases_fp16.to(torch.float16)
+    if not bool((b == -s).all()):
+        return None
+    codes = _codes_from_words(words)
+    if bool((codes > 2).any()):
+        return None
+    sc = s.contiguous()
+    payload = _pack_codes(codes) if keep_base3 else None
+    return TQ(payload, sc if keep_base3 else None, n, k, pq2=_pack_pq2_lane(codes), pq2_scales=_major_scales(sc, n))
+
+
+def unpack(tq: TQ) -> tuple[torch.Tensor, torch.Tensor]:
+    """Reference unpack: returns codes uint8 (n, k) and scales fp16 bit-exact."""
+
+    p = tq.payload
+    if p is None or tq.scales is None:
+        raise ValueError("TQ was packed without base-3 payload; unpack is unavailable")
+    dev = p.device
+    out = torch.empty((tq.n, tq.k), dtype=torch.uint8, device=dev)
+    pow5 = _POW5.to(dev, dtype=torch.uint8)
+    pow4 = _POW4.to(dev, dtype=torch.uint8)
+    # Division is exact because every byte is < 243 (or < 81 for the tail).
+    main = ((p[:, :, :24, None] // pow5) % 3).reshape(tq.n, tq.k // GROUP, 120)
+    tail = ((p[:, :, 24:, None] // pow4) % 3).reshape(tq.n, tq.k // GROUP, 8)
+    out.reshape(tq.n, tq.k // GROUP, GROUP)[:, :, :120] = main
+    out.reshape(tq.n, tq.k // GROUP, GROUP)[:, :, 120:] = tail
+    return out, tq.scales.clone()
+
+
+def rows(tq: TQ, a: int, b: int) -> TQ:
+    """Cheap row view/copy for rows [a,b). Contiguous row ranges are zero-copy views."""
+
+    if not (0 <= a <= b <= tq.n):
+        raise ValueError("invalid row range")
+    pq2 = tq.pq2[a // 64:b // 64] if tq.pq2 is not None and a % 64 == 0 and (b - a) % 128 == 0 else None
+    pq2s = tq.pq2_scales[:, a:b] if tq.pq2_scales is not None else None
+    if pq2 is None and tq.pq2 is not None:
+        # Non tile-aligned row views are uncommon; repack the small base3 slice through explicit codes.
+        codes, scales = unpack(TQ(tq.payload[a:b], tq.scales[a:b], b - a, tq.k, tq.row0 + a))
+        return pack_codes(codes.contiguous(), scales.contiguous())
+    payload = None if tq.payload is None else tq.payload[a:b]
+    scales = None if tq.scales is None else tq.scales[a:b]
+    return TQ(payload, scales, b - a, tq.k, tq.row0 + a, pq2, pq2s)
+
+
+def stack(parts: list[TQ]) -> TQ:
+    """Stack several weights with the same K for grouped launches/fused projections."""
+
+    if not parts:
+        raise ValueError("need at least one TQ")
+    if len({p.k for p in parts}) != 1:
+        raise ValueError("all stacked ternary weights must share K")
+    n = sum(p.n for p in parts)
+    # Concatenating independently padded tiled layouts is only valid when every previous part ends on a 128-row pad
+    # boundary and the final padded tile count matches the logical stacked shape. Otherwise repack from base3 codes.
+    if all(p.pq2 is not None and p.pq2_scales is not None and p.n % 128 == 0 for p in parts[:-1]):
+        pq2 = torch.cat([p.pq2 for p in parts], dim=0).contiguous()
+        pq2s = torch.cat([p.pq2_scales[:, :p.n] for p in parts], dim=1)
+        pq2s = _major_scales(pq2s.t().contiguous(), n)
+        if pq2.shape[0] == -(-n // 128) * 2:
+            payload = (torch.cat([p.payload for p in parts], dim=0).contiguous()
+                               if all(p.payload is not None for p in parts) else None)
+            scales = (torch.cat([p.scales for p in parts], dim=0).contiguous()
+                              if all(p.scales is not None for p in parts) else None)
+            return TQ(payload, scales, n, parts[0].k, pq2=pq2, pq2_scales=pq2s)
+    codes_scales = [unpack(p) for p in parts]
+    return pack_codes(torch.cat([c for c, _ in codes_scales], dim=0).contiguous(),
+                      torch.cat([sc for _, sc in codes_scales], dim=0).contiguous())
+
+
+def _check_x(x: torch.Tensor, tq: TQ) -> torch.Tensor:
+    if x.dtype != torch.bfloat16 or x.dim() != 2 or x.shape[1] != tq.k:
+        raise ValueError(f"x must be bf16 (M, {tq.k})")
+    if not (1 <= x.shape[0] <= 128):
+        raise ValueError("qmm_tern PQ2 decode supports 1 <= M <= 128; use the prefill GEMM above that")
+    if x.stride(1) != 1:
+        x = x.contiguous()
+    return x
+
+
+def matmul(x: torch.Tensor, tq: TQ, *, f32: bool = False, out: torch.Tensor | None = None,
+           int8: bool = False) -> torch.Tensor:
+    """x @ dequant(tq).T for decode M=1..32. Accumulation is fp32; output bf16 unless f32=True."""
+
+    x = _check_x(x, tq)
+    dtype = torch.float32 if f32 else torch.bfloat16
+    if out is None:
+        out = torch.empty((x.shape[0], tq.n), dtype=dtype, device=x.device)
+    if int8:
+        # Accuracy/reference path retained for tests; the fast serving path is PQ2 bf16.
+        xq, xscale = quantize_int8_groups(x, GROUP)
+        xf = (xq.float().reshape(x.shape[0], x.shape[1] // GROUP, GROUP) * xscale[..., None]).reshape_as(x.float())
+        out.copy_((xf @ dequant_weight(tq).t()).to(out.dtype))
+        return out
+    if tq.pq2 is None or tq.pq2_scales is None:
+        raise ValueError("TQ lacks PQ2 fast layout; repack with pack_mlx/pack_codes")
+    from tensorfold.cuda.kernels import qmm as shared
+    from .qmm_tiles import group_tile
+    xs = shared.group_sums(x, 64)
+    sk = shared.split_k(tq.n, tq.k, 64)
+    major, minor = torch.cuda.get_device_capability(x.device)
+    sms = torch.cuda.get_device_properties(x.device).multi_processor_count
+    _ext().pq2_group(x, xs, [tq.pq2], [tq.pq2_scales], [out], [tq.n], [sk], f32,
+                     group_tile(x.shape[0], major, minor, sms), -1)
+    return out
+
+
+def matmul_group(x: torch.Tensor, qs: list[TQ], *, f32: bool = False, int8: bool = False) -> list[torch.Tensor]:
+    """Grouped API: same input against several TQ weights. Current v1 dispatches one kernel per part."""
+
+    if not qs:
+        return []
+    if len({q.k for q in qs}) != 1:
+        raise ValueError("all grouped ternary weights must share K")
+    if int8 or any(q.pq2 is None or q.pq2_scales is None for q in qs) or len(qs) > 4:
+        return [matmul(x, q, f32=f32, int8=int8) for q in qs]
+    x = _check_x(x, qs[0])
+    if x.stride(1) != 1 or (x.shape[0] > 1 and x.stride(0) % 8) or x.data_ptr() % 16:
+        x = x.clone(memory_format=torch.contiguous_format)
+    from tensorfold.cuda.kernels import qmm as shared
+    from .qmm_tiles import group_tile
+    xs = shared.group_sums(x, 64)
+    sks = [shared.split_k(q.n, q.k, 64) for q in qs]
+    dtype = torch.float32 if f32 else torch.bfloat16
