--- tensorfold/cuda/kernels/prism_rot.cpp
+++ tensorfold/cuda/kernels/prism_rot.cpp
@@ -0,0 +1,59 @@
+#include <torch/extension.h>
+#include <c10/cuda/CUDAGuard.h>
+
+void prism_rotate_cuda(const at::Tensor&, const at::Tensor&, at::Tensor&, bool);
+void prism_rmsnorm_rotate_cuda(const at::Tensor&, const c10::optional<at::Tensor>&, const at::Tensor&, const at::Tensor&, at::Tensor&, const c10::optional<at::Tensor>&, double);
+void prism_silu_mul_rotate_cuda(const at::Tensor&, const at::Tensor&, const at::Tensor&, at::Tensor&);
+void prism_quantize_rows_cuda(const at::Tensor&, at::Tensor&, at::Tensor&, at::Tensor&, int64_t);
+
+static int64_t rows_of(const at::Tensor& x) { return x.numel() / x.size(-1); }
+
+void check_x(const at::Tensor& x, const at::Tensor& signs) {
+    TORCH_CHECK(x.is_cuda() && (x.scalar_type() == at::kBFloat16 || x.scalar_type() == at::kFloat || x.scalar_type() == at::kHalf), "x CUDA bf16/fp32/fp16");
+    TORCH_CHECK(x.dim() >= 2 && x.size(-1) % 1024 == 0, "last dim must be a multiple of 1024");
+    TORCH_CHECK(x.stride(-1) == 1, "last dim contiguous");
+    TORCH_CHECK(signs.is_cuda() && signs.is_contiguous() && signs.scalar_type() == at::kFloat && signs.numel() == x.size(-1), "signs: contiguous CUDA fp32 matching K");
+}
+
+void rotate(const at::Tensor& x, const at::Tensor& signs, at::Tensor& out, bool inverse) {
+    check_x(x, signs);
+    TORCH_CHECK(out.is_cuda() && out.scalar_type() == at::kBFloat16 && out.sizes() == x.sizes() && out.is_contiguous(), "out: contiguous bf16 same shape");
+    c10::cuda::CUDAGuard guard(x.device());
+    prism_rotate_cuda(x, signs, out, inverse);
+}
+
+void rmsnorm_rotate(const at::Tensor& x, const c10::optional<at::Tensor>& residual, const at::Tensor& w,
+                    double eps, const at::Tensor& signs, at::Tensor& out, const c10::optional<at::Tensor>& h) {
+    check_x(x, signs);
+    TORCH_CHECK(w.is_cuda() && w.is_contiguous() && w.scalar_type() == at::kFloat && w.numel() == x.size(-1), "norm weight fp32 CUDA K");
+    TORCH_CHECK(out.is_cuda() && out.scalar_type() == at::kBFloat16 && out.sizes() == x.sizes() && out.is_contiguous(), "out: contiguous bf16 same shape");
+    if (residual.has_value()) TORCH_CHECK((*residual).is_cuda() && (*residual).sizes() == x.sizes() && (*residual).stride(-1) == 1, "residual same CUDA shape");
+    if (h.has_value()) TORCH_CHECK((*h).is_cuda() && (*h).scalar_type() == at::kBFloat16 && (*h).sizes() == x.sizes() && (*h).is_contiguous(), "h: contiguous bf16 same shape");
+    c10::cuda::CUDAGuard guard(x.device());
+    prism_rmsnorm_rotate_cuda(x, residual, w, signs, out, h, eps);
+}
+
+void silu_mul_rotate(const at::Tensor& gate, const at::Tensor& up, const at::Tensor& signs, at::Tensor& out) {
+    check_x(gate, signs);
+    TORCH_CHECK(up.is_cuda() && up.sizes() == gate.sizes() && up.stride(-1) == 1 && up.scalar_type() == gate.scalar_type(), "up same shape/dtype as gate");
+    TORCH_CHECK(out.is_cuda() && out.scalar_type() == at::kBFloat16 && out.sizes() == gate.sizes() && out.is_contiguous(), "out: contiguous bf16 same shape");
+    c10::cuda::CUDAGuard guard(gate.device());
+    prism_silu_mul_rotate_cuda(gate, up, signs, out);
+}
+
+void quantize_rows(const at::Tensor& x, at::Tensor& x8, at::Tensor& xs, at::Tensor& a, int64_t gs) {
+    TORCH_CHECK(x.is_cuda() && x.is_contiguous() && (x.scalar_type() == at::kBFloat16 || x.scalar_type() == at::kFloat) && x.dim() == 2, "x contiguous CUDA rows");
+    TORCH_CHECK(x.size(1) % gs == 0 && x.size(1) % 32 == 0, "K multiple of gs and 32");
+    TORCH_CHECK(x8.is_cuda() && x8.is_contiguous() && x8.scalar_type() == at::kByte && x8.sizes() == x.sizes(), "x8 uint8 same shape");
+    TORCH_CHECK(xs.is_cuda() && xs.is_contiguous() && xs.scalar_type() == at::kBFloat16 && xs.size(0) == x.size(0) && xs.size(1) == x.size(1) / gs, "xs bf16 (M,K/gs)");
+    TORCH_CHECK(a.is_cuda() && a.is_contiguous() && a.scalar_type() == at::kFloat && a.numel() == x.size(0), "a fp32 (M,)");
+    c10::cuda::CUDAGuard guard(x.device());
+    prism_quantize_rows_cuda(x, x8, xs, a, gs);
+}
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+    m.def("rotate", &rotate);
+    m.def("rmsnorm_rotate", &rmsnorm_rotate);
+    m.def("silu_mul_rotate", &silu_mul_rotate);
+    m.def("quantize_rows", &quantize_rows);
+}
--- tensorfold/cuda/kernels/prism_rot.cu
+++ tensorfold/cuda/kernels/prism_rot.cu
@@ -0,0 +1,245 @@
+#include <cuda.h>
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <cuda_fp8.h>
+#include <ATen/cuda/CUDAContext.h>
+#include <torch/extension.h>
+#include <stdint.h>
+
+namespace {
+constexpr int BLOCK = 1024;
+constexpr int THREADS = 256;
+
+template <typename T> __device__ __forceinline__ float load_as_float(const T *p) { return static_cast<float>(*p); }
+template <> __device__ __forceinline__ float load_as_float<__nv_bfloat16>(const __nv_bfloat16 *p) { return __bfloat162float(*p); }
+template <> __device__ __forceinline__ float load_as_float<half>(const half *p) { return __half2float(*p); }
+
+__device__ __forceinline__ __nv_bfloat16 bf16_rn(float x) { return __float2bfloat16_rn(x); }
+
+__device__ __forceinline__ void fwht_shared_1024(float *s) {
+    __syncthreads();
+#pragma unroll 1
+    for (int h = 1; h < BLOCK; h <<= 1) {
+        for (int idx = threadIdx.x; idx < BLOCK / 2; idx += blockDim.x) {
+            int j = (idx / h) * (2 * h) + (idx % h);
+            float a = s[j];
+            float b = s[j + h];
+            s[j] = a + b;
+            s[j + h] = a - b;
+        }
+        __syncthreads();
+    }
+}
+
+template <typename T, bool INVERSE>
+__global__ void rotate_kernel(const T *__restrict__ x, const float *__restrict__ signs,
+                              __nv_bfloat16 *__restrict__ out, int64_t rows, int K, int64_t ldx) {
+    __shared__ float s[BLOCK];
+    int64_t bid = blockIdx.x;
+    int64_t row = bid / (K / BLOCK);
+    int blk = bid - row * (K / BLOCK);
+    if (row >= rows) return;
+    int base = blk * BLOCK;
+    for (int i = threadIdx.x; i < BLOCK; i += blockDim.x) {
+        float v = load_as_float(reinterpret_cast<const T *>(x) + row * ldx + base + i);
+        float sg = signs[base + i];
+        s[i] = INVERSE ? v : v * sg;
+    }
+    fwht_shared_1024(s);
+    for (int i = threadIdx.x; i < BLOCK; i += blockDim.x) {
+        float v = s[i] * (1.0f / 32.0f);
+        if constexpr (INVERSE) v *= signs[base + i];
+        out[row * (int64_t)K + base + i] = bf16_rn(v);
+    }
+}
+
+template <typename T, typename R, bool HAS_R, bool STORE_H>
+__global__ void rmsnorm_rotate_kernel(const T *__restrict__ x, const R *__restrict__ r, const float *__restrict__ w,
+                                      const float *__restrict__ signs, __nv_bfloat16 *__restrict__ out,
+                                      __nv_bfloat16 *__restrict__ h_out, int64_t rows, int D, int64_t ldx,
+                                      int64_t ldr, float eps) {
+    __shared__ float smem[BLOCK];
+    __shared__ float sums[THREADS / 32];
+    __shared__ float inv_s;
+    int64_t row = blockIdx.x;
+    if (row >= rows) return;
+    float local = 0.0f;
+    for (int i = threadIdx.x; i < D; i += blockDim.x) {
+        float v = load_as_float(reinterpret_cast<const T *>(x) + row * ldx + i);
+        if constexpr (HAS_R) {
+            float rv = load_as_float(reinterpret_cast<const R *>(r) + row * ldr + i);
+            __nv_bfloat16 hb = bf16_rn(v + rv);
+            if constexpr (STORE_H) h_out[row * (int64_t)D + i] = hb;
+            v = __bfloat162float(hb);
+        }
+        local += v * v;
+    }
+    // warp/block reduction, deterministic enough because the reference uses one Triton program-wide reduction.
+    for (int off = 16; off > 0; off >>= 1) local += __shfl_down_sync(0xffffffff, local, off);
+    if ((threadIdx.x & 31) == 0) sums[threadIdx.x >> 5] = local;
+    __syncthreads();
+    if (threadIdx.x < 32) {
+        float v = threadIdx.x < (blockDim.x / 32) ? sums[threadIdx.x] : 0.0f;
+        for (int off = 16; off > 0; off >>= 1) v += __shfl_down_sync(0xffffffff, v, off);
+        if (threadIdx.x == 0) inv_s = rsqrtf(v / (float)D + eps);
+    }
+    __syncthreads();
+    for (int blk = 0; blk < D / BLOCK; ++blk) {
+        int base = blk * BLOCK;
+        for (int i = threadIdx.x; i < BLOCK; i += blockDim.x) {
+            float v = load_as_float(reinterpret_cast<const T *>(x) + row * ldx + base + i);
+            if constexpr (HAS_R) {
+                float rv = load_as_float(reinterpret_cast<const R *>(r) + row * ldr + base + i);
+                v = __bfloat162float(bf16_rn(v + rv));
+            }
+            float y = __bfloat162float(bf16_rn(v * inv_s * w[base + i]));
+            smem[i] = y * signs[base + i];
+        }
+        fwht_shared_1024(smem);
+        for (int i = threadIdx.x; i < BLOCK; i += blockDim.x) {
+            out[row * (int64_t)D + base + i] = bf16_rn(smem[i] * (1.0f / 32.0f));
+        }
+        __syncthreads();
+    }
+}
+
+template <typename G, typename U>
+__global__ void silu_mul_rotate_kernel(const G *__restrict__ gate, const U *__restrict__ up,
+                                       const float *__restrict__ signs, __nv_bfloat16 *__restrict__ out,
+                                       int64_t rows, int K, int64_t ldg, int64_t ldu) {
+    __shared__ float s[BLOCK];
+    int64_t bid = blockIdx.x;
+    int64_t row = bid / (K / BLOCK);
+    int blk = bid - row * (K / BLOCK);
+    if (row >= rows) return;
+    int base = blk * BLOCK;
+    for (int i = threadIdx.x; i < BLOCK; i += blockDim.x) {
+        float g = load_as_float(reinterpret_cast<const G *>(gate) + row * ldg + base + i);
+        float u = load_as_float(reinterpret_cast<const U *>(up) + row * ldu + base + i);
+        float a = __bfloat162float(bf16_rn((g / (1.0f + expf(-g))) * u));
+        s[i] = a * signs[base + i];
+    }
+    fwht_shared_1024(s);
+    for (int i = threadIdx.x; i < BLOCK; i += blockDim.x) out[row * (int64_t)K + base + i] = bf16_rn(s[i] * (1.0f / 32.0f));
+}
+
+template <typename T>
+__global__ void quantize_rows_kernel(const T *__restrict__ x, uint8_t *__restrict__ x8, __nv_bfloat16 *__restrict__ xs,
+                                     float *__restrict__ aout, int64_t rows, int K, int GS) {
+    __shared__ float shared[THREADS / 32];
+    __shared__ float a_s;
+    int64_t row = blockIdx.x;
+    if (row >= rows) return;
+    float m = 0.0f;
+    for (int i = threadIdx.x; i < K; i += blockDim.x) {
+        float v = load_as_float(reinterpret_cast<const T *>(x) + row * (int64_t)K + i);
+        m = fmaxf(m, fabsf(v));
+    }
+    for (int off = 16; off > 0; off >>= 1) m = fmaxf(m, __shfl_down_sync(0xffffffff, m, off));
+    if ((threadIdx.x & 31) == 0) shared[threadIdx.x >> 5] = m;
+    __syncthreads();
+    if (threadIdx.x < 32) {
+        float v = threadIdx.x < (blockDim.x / 32) ? shared[threadIdx.x] : 0.0f;
+        for (int off = 16; off > 0; off >>= 1) v = fmaxf(v, __shfl_down_sync(0xffffffff, v, off));
+        if (threadIdx.x == 0) {
+            a_s = v > 0.0f ? v * (1.0f / 448.0f) : 1.0f;
+            aout[row] = a_s;
+        }
+    }
+    __syncthreads();
+    float a = a_s;
+    for (int g = threadIdx.x; g < K / GS; g += blockDim.x) {
+        float sum = 0.0f;
+        for (int j = 0; j < GS; ++j) sum += load_as_float(reinterpret_cast<const T *>(x) + row * (int64_t)K + g * GS + j);
+        xs[row * (int64_t)(K / GS) + g] = bf16_rn(sum / a);
+    }
+    for (int k0 = 0; k0 < K; k0 += 256) {
+        for (int mm = threadIdx.x; mm < 256 && k0 + mm < K; mm += blockDim.x) {
+            int j = mm & 3;
+            int src = (mm / 32) * 32 + ((mm % 32) / 16) * 16 + ((mm % 16) / 4) * 2 + (j & 1) + (j / 2) * 8;
+            float v = load_as_float(reinterpret_cast<const T *>(x) + row * (int64_t)K + k0 + src) / a;
+            __nv_fp8_e4m3 q(v);
+            x8[row * (int64_t)K + k0 + mm] = *reinterpret_cast<uint8_t *>(&q);
+        }
+    }
+}
+
+template <typename scalar_t, bool INV>
+void launch_rotate_t(const at::Tensor& x, const at::Tensor& signs, at::Tensor& out) {
+    const int64_t rows = x.numel() / x.size(-1);
+    const int K = static_cast<int>(x.size(-1));
+    if (rows == 0) return;
+    auto stream = at::cuda::getCurrentCUDAStream();
+    rotate_kernel<scalar_t, INV><<<dim3(rows * (K / BLOCK)), dim3(THREADS), 0, stream>>>(
+        reinterpret_cast<const scalar_t *>(x.data_ptr()), signs.data_ptr<float>(), reinterpret_cast<__nv_bfloat16 *>(out.data_ptr()),
+        rows, K, x.stride(-2));
+}
+
+template <typename T, typename R, bool HAS_R, bool STORE_H>
+void launch_rms_t(const at::Tensor& x, const at::Tensor& r, const at::Tensor& w, const at::Tensor& signs,
+                  at::Tensor& out, at::Tensor& h, float eps) {
+    int64_t rows = x.numel() / x.size(-1);
+    if (rows == 0) return;
+    auto stream = at::cuda::getCurrentCUDAStream();
+    rmsnorm_rotate_kernel<T, R, HAS_R, STORE_H><<<dim3(rows), dim3(THREADS), 0, stream>>>(
+        reinterpret_cast<const T *>(x.data_ptr()), reinterpret_cast<const R *>(r.defined() ? r.data_ptr() : x.data_ptr()),
+        w.data_ptr<float>(), signs.data_ptr<float>(), reinterpret_cast<__nv_bfloat16 *>(out.data_ptr()),
+        reinterpret_cast<__nv_bfloat16 *>(h.defined() ? h.data_ptr() : out.data_ptr()), rows, static_cast<int>(x.size(-1)),
+        x.stride(-2), r.defined() ? r.stride(-2) : x.stride(-2), eps);
+}
+
+template <typename G, typename U>
+void launch_silu_t(const at::Tensor& g, const at::Tensor& u, const at::Tensor& signs, at::Tensor& out) {
+    int64_t rows = g.numel() / g.size(-1);
+    if (rows == 0) return;
+    int K = static_cast<int>(g.size(-1));
+    auto stream = at::cuda::getCurrentCUDAStream();
+    silu_mul_rotate_kernel<G, U><<<dim3(rows * (K / BLOCK)), dim3(THREADS), 0, stream>>>(
+        reinterpret_cast<const G *>(g.data_ptr()), reinterpret_cast<const U *>(u.data_ptr()), signs.data_ptr<float>(),
+        reinterpret_cast<__nv_bfloat16 *>(out.data_ptr()), rows, K, g.stride(-2), u.stride(-2));
+}
+} // namespace
+
+void prism_rotate_cuda(const at::Tensor& x, const at::Tensor& signs, at::Tensor& out, bool inverse) {
+    if (x.scalar_type() == at::kBFloat16) {
+        inverse ? launch_rotate_t<__nv_bfloat16, true>(x, signs, out) : launch_rotate_t<__nv_bfloat16, false>(x, signs, out);
+    } else if (x.scalar_type() == at::kHalf) {
+        inverse ? launch_rotate_t<half, true>(x, signs, out) : launch_rotate_t<half, false>(x, signs, out);
+    } else if (x.scalar_type() == at::kFloat) {
+        inverse ? launch_rotate_t<float, true>(x, signs, out) : launch_rotate_t<float, false>(x, signs, out);
+    }
+}
+
+void prism_rmsnorm_rotate_cuda(const at::Tensor& x, const c10::optional<at::Tensor>& residual, const at::Tensor& w,
+                               const at::Tensor& signs, at::Tensor& out, const c10::optional<at::Tensor>& h,
+                               double eps) {
+#define DISPATCH_R(XT, RT, HAS, STORE) launch_rms_t<XT, RT, HAS, STORE>(x, residual.has_value()?*residual:at::Tensor(), w, signs, out, const_cast<at::Tensor&>(h.has_value()?*h:out), static_cast<float>(eps))
+    bool store = h.has_value();
+    if (!residual.has_value()) {
+        if (x.scalar_type() == at::kBFloat16) { if (store) DISPATCH_R(__nv_bfloat16, __nv_bfloat16, false, true); else DISPATCH_R(__nv_bfloat16, __nv_bfloat16, false, false); }
+        else if (x.scalar_type() == at::kHalf) { if (store) DISPATCH_R(half, half, false, true); else DISPATCH_R(half, half, false, false); }
+        else if (x.scalar_type() == at::kFloat) { if (store) DISPATCH_R(float, float, false, true); else DISPATCH_R(float, float, false, false); }
+    } else {
+        const at::Tensor& r = *residual;
+        if (x.scalar_type() == at::kBFloat16 && r.scalar_type() == at::kBFloat16) { if (store) DISPATCH_R(__nv_bfloat16, __nv_bfloat16, true, true); else DISPATCH_R(__nv_bfloat16, __nv_bfloat16, true, false); }
+        else if (x.scalar_type() == at::kBFloat16 && r.scalar_type() == at::kFloat) { if (store) DISPATCH_R(__nv_bfloat16, float, true, true); else DISPATCH_R(__nv_bfloat16, float, true, false); }
+        else if (x.scalar_type() == at::kFloat && r.scalar_type() == at::kBFloat16) { if (store) DISPATCH_R(float, __nv_bfloat16, true, true); else DISPATCH_R(float, __nv_bfloat16, true, false); }
+        else if (x.scalar_type() == at::kFloat && r.scalar_type() == at::kFloat) { if (store) DISPATCH_R(float, float, true, true); else DISPATCH_R(float, float, true, false); }
+        else if (x.scalar_type() == at::kHalf && r.scalar_type() == at::kHalf) { if (store) DISPATCH_R(half, half, true, true); else DISPATCH_R(half, half, true, false); }
+    }
+#undef DISPATCH_R
+}
+
+void prism_silu_mul_rotate_cuda(const at::Tensor& gate, const at::Tensor& up, const at::Tensor& signs, at::Tensor& out) {
+    if (gate.scalar_type() == at::kBFloat16 && up.scalar_type() == at::kBFloat16) launch_silu_t<__nv_bfloat16, __nv_bfloat16>(gate, up, signs, out);
+    else if (gate.scalar_type() == at::kFloat && up.scalar_type() == at::kFloat) launch_silu_t<float, float>(gate, up, signs, out);
+    else if (gate.scalar_type() == at::kHalf && up.scalar_type() == at::kHalf) launch_silu_t<half, half>(gate, up, signs, out);
+}
+
+void prism_quantize_rows_cuda(const at::Tensor& x, at::Tensor& x8, at::Tensor& xs, at::Tensor& a, int64_t gs) {
+    int64_t rows = x.size(0); if (rows == 0) return;
+    auto stream = at::cuda::getCurrentCUDAStream();
+    if (x.scalar_type() == at::kBFloat16) quantize_rows_kernel<__nv_bfloat16><<<dim3(rows), dim3(THREADS), 0, stream>>>(reinterpret_cast<const __nv_bfloat16 *>(x.data_ptr()), x8.data_ptr<uint8_t>(), reinterpret_cast<__nv_bfloat16 *>(xs.data_ptr()), a.data_ptr<float>(), rows, static_cast<int>(x.size(1)), static_cast<int>(gs));
+    else if (x.scalar_type() == at::kFloat) quantize_rows_kernel<float><<<dim3(rows), dim3(THREADS), 0, stream>>>(x.data_ptr<float>(), x8.data_ptr<uint8_t>(), reinterpret_cast<__nv_bfloat16 *>(xs.data_ptr()), a.data_ptr<float>(), rows, static_cast<int>(x.size(1)), static_cast<int>(gs));
+}
--- tensorfold/cuda/kernels/prism_rot.py
+++ tensorfold/cuda/kernels/prism_rot.py
@@ -0,0 +1,312 @@
+from __future__ import annotations
+
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+
+@lru_cache(maxsize=1)
+def _ext():
+    from tensorfold.cuda.build import load
+
+    here = Path(__file__).parent
+    return load(name="tensorfold_prism_rot_v1", sources=[str(here / "prism_rot.cpp"), str(here / "prism_rot.cu")],
+                extra_cuda_cflags=["-O3"], verbose=False)
+
+
+def _shape(x: torch.Tensor) -> tuple[int, int]:
+    if x.dim() < 2:
+        raise ValueError("expected at least 2-D tensor with rows in the last dimension")
+    return x.numel() // x.shape[-1], int(x.shape[-1])
+
+
+def _out(x: torch.Tensor, out: torch.Tensor | None) -> torch.Tensor:
+    return torch.empty_like(x, dtype=torch.bfloat16, memory_format=torch.contiguous_format) if out is None else out
+
+
+def rotate(x: torch.Tensor, signs: torch.Tensor, *, out: torch.Tensor | None = None) -> torch.Tensor:
+    y = _out(x, out)
+    _ext().rotate(x.contiguous() if x.stride(-1) != 1 else x, signs.to(device=x.device, dtype=torch.float32).contiguous(), y, False)
+    return y
+
+
+def inverse(x: torch.Tensor, signs: torch.Tensor, *, out: torch.Tensor | None = None) -> torch.Tensor:
+    y = _out(x, out)
+    _ext().rotate(x.contiguous() if x.stride(-1) != 1 else x, signs.to(device=x.device, dtype=torch.float32).contiguous(), y, True)
+    return y
+
+
+def rmsnorm_rotate(x: torch.Tensor, norm_weight: torch.Tensor, eps: float, signs: torch.Tensor,
+                   residual: torch.Tensor | None = None, *, out: torch.Tensor | None = None,
+                   h_out: torch.Tensor | None = None) -> torch.Tensor | tuple[torch.Tensor, torch.Tensor]:
+    y = _out(x, out)
+    w = norm_weight.to(device=x.device, dtype=torch.float32).contiguous()
+    s = signs.to(device=x.device, dtype=torch.float32).contiguous()
+    xx = x.contiguous() if x.stride(-1) != 1 else x
+    rr = None if residual is None else (residual.contiguous() if residual.stride(-1) != 1 else residual)
+    _ext().rmsnorm_rotate(xx, rr, w, float(eps), s, y, h_out)
+    return (h_out, y) if h_out is not None else y
+
+
+def silu_mul_rotate(gate: torch.Tensor, up: torch.Tensor, signs: torch.Tensor, *, out: torch.Tensor | None = None) -> torch.Tensor:
+    y = _out(gate, out)
+    g = gate.contiguous() if gate.stride(-1) != 1 else gate
+    u = up.contiguous() if up.stride(-1) != 1 else up
+    _ext().silu_mul_rotate(g, u, signs.to(device=gate.device, dtype=torch.float32).contiguous(), y)
+    return y
+
+
+def quantize_rows(x: torch.Tensor, gs: int = 64) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    if x.dim() != 2:
+        raise ValueError("quantize_rows expects a 2-D contiguous row tensor")
+    x = x.contiguous()
+    m, k = x.shape
+    x8 = torch.empty((m, k), dtype=torch.uint8, device=x.device)
+    xs = torch.empty((m, k // gs), dtype=torch.bfloat16, device=x.device)
+    a = torch.empty((m,), dtype=torch.float32, device=x.device)
+    _ext().quantize_rows(x, x8, xs, a, int(gs))
+    return x8, xs, a
+
+
+def rotate_quantize_rows(x: torch.Tensor, signs: torch.Tensor, gs: int = 64) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    # Exact public path: reuse TensorFold's Triton fragment quantizer after the CUDA FWHT.
+    # The CUDA quantizer binding above is kept for experimentation, but can differ by 1 FP8 code on ties.
+    from tensorfold.cuda.kernels import qmm
+
+    return qmm.quantize_rows(rotate(x, signs), gs)
+
+# Exact Triton fusions. These mirror tensorfold.families.qwen3_5.cuda.glue and
+# tensorfold.cuda.kernels.qmm producer arithmetic, then append the Bonsai FWHT
+# butterfly from tensorfold.families.bonsai.cuda._fwht.
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _fwht1024(v):
+    for stage in tl.static_range(10):
+        v = tl.reshape(v, (512 >> stage, 2, 1 << stage))
+        a, b = tl.split(tl.permute(v, (0, 2, 1)))
+        v = tl.reshape(tl.permute(tl.join(a + b, a - b), (0, 2, 1)), (1024,))
+    return v
+
+
+@triton.jit
+def _store_xs(Y, XS, row, blk: tl.constexpr, K: tl.constexpr, GS: tl.constexpr):
+    yg = tl.reshape(Y.to(tl.float32), (1024 // GS, GS))
+    g = tl.arange(0, 1024 // GS)
+    tl.store(XS + row * (K // GS) + blk * (1024 // GS) + g, tl.sum(yg, axis=1))
+
+
+@triton.jit
+def _add_rmsnorm_rotate(X, R, W, S, H, Y, XS, eps, D: tl.constexpr, BLOCKD: tl.constexpr,
+                        HAS_R: tl.constexpr, STORE_H: tl.constexpr, GS: tl.constexpr):
+    row = tl.program_id(0)
+    blk = tl.program_id(1)
+    offs = tl.arange(0, BLOCKD)
+    ok = offs < D
+    x = tl.load(X + row * D + offs, mask=ok, other=0.0).to(tl.float32)
+    if HAS_R:
+        r = tl.load(R + row * D + offs, mask=ok, other=0.0).to(tl.float32)
+        h = (x + r).to(tl.bfloat16)
+        if STORE_H:
+            tl.store(H + row * D + offs, h, mask=ok)
+        x = h.to(tl.float32)
+    ss = tl.sum(x * x, axis=0)
+    inv = 1.0 / tl.sqrt(ss / D + eps)
+    i = blk * 1024 + tl.arange(0, 1024)
+    xb = tl.load(X + row * D + i).to(tl.float32)
+    if HAS_R:
+        rb = tl.load(R + row * D + i).to(tl.float32)
+        xb = (xb + rb).to(tl.bfloat16).to(tl.float32)
+    wb = tl.load(W + i).to(tl.float32)
+    y = (xb * inv * wb).to(tl.bfloat16).to(tl.float32) * tl.load(S + i)
+    out = (_fwht1024(y) * (1.0 / 32.0)).to(tl.bfloat16)
+    tl.store(Y + row * D + i, out)
+    _store_xs(out, XS, row, blk, D, GS)
+
+
+@triton.jit
+def _swiglu_rotate(GATE, UP, S, OUT, XS, N: tl.constexpr, GS: tl.constexpr):
+    row = tl.program_id(0)
+    blk = tl.program_id(1)
+    offs = blk * 1024 + tl.arange(0, 1024)
+    g = tl.load(GATE + row * N + offs).to(tl.float32)
+    u = tl.load(UP + row * N + offs).to(tl.float32)
+    a = (g * tl.sigmoid(g) * u).to(tl.bfloat16).to(tl.float32) * tl.load(S + offs)
+    out = (_fwht1024(a) * (1.0 / 32.0)).to(tl.bfloat16)
+    tl.store(OUT + row * N + offs, out)
+    _store_xs(out, XS, row, blk, N, GS)
+
+
+@triton.jit
+def _gate_mul_rotate(O, QG, S, OUT, XS, H: tl.constexpr, D: tl.constexpr, GS: tl.constexpr):
+    row = tl.program_id(0)
+    blk = tl.program_id(1)
+    k = blk * 1024 + tl.arange(0, 1024)
+    head = k // D
+    d = k - head * D
+    o = tl.load(O + (row * H + head) * D + d).to(tl.float32)
+    g = tl.load(QG + (row * H + head) * 2 * D + D + d).to(tl.float32)
+    a = (o * tl.sigmoid(g)).to(tl.bfloat16).to(tl.float32) * tl.load(S + k)
+    out = (_fwht1024(a) * (1.0 / 32.0)).to(tl.bfloat16)
+    tl.store(OUT + row * (H * D) + k, out)
+    _store_xs(out, XS, row, blk, H * D, GS)
+
+
+@triton.jit
+def _gated_norm_rotate(YR, Z, W, S, OUT, XS, eps, VH: tl.constexpr, DV: tl.constexpr, GS: tl.constexpr):
+    row = tl.program_id(0)
+    blk = tl.program_id(1)
+    d = tl.arange(0, DV)
+    # 1024 Bonsai block == 8 value heads when DV=128.
+    heads = blk * (1024 // DV) + tl.arange(0, 1024 // DV)
+    y = tl.load(YR + (row * VH + heads[:, None]) * DV + d[None, :]).to(tl.float32)
+    z = tl.load(Z + (row * VH + heads[:, None]) * DV + d[None, :]).to(tl.float32)
+    ww = tl.load(W + d).to(tl.float32)
+    yn = y * (1.0 / tl.sqrt(tl.sum(y * y, axis=1) / DV + eps))[:, None] * ww[None, :]
+    prod = (z * tl.sigmoid(z) * yn).to(tl.bfloat16)
+    flat = tl.reshape(prod, (1024,)).to(tl.float32)
+    k = blk * 1024 + tl.arange(0, 1024)
+    out = (_fwht1024(flat * tl.load(S + k)) * (1.0 / 32.0)).to(tl.bfloat16)
+    tl.store(OUT + row * (VH * DV) + k, out)
+    _store_xs(out, XS, row, blk, VH * DV, GS)
+
+
+@triton.jit
+def _rotate_quantize_rows(X, S, X8, XS, A, K: tl.constexpr, GS: tl.constexpr):
+    row = tl.program_id(0)
+    offs = tl.arange(0, 1024)
+    # First pass: exact Bonsai FWHT per 1024 block; reduce max across the row.
+    top = tl.full((), 0.0, tl.float32)
+    for blk in tl.static_range(0, K // 1024):
+        k = blk * 1024 + offs
+        x = tl.load(X + row * K + k).to(tl.float32) * tl.load(S + k)
+        r = (_fwht1024(x) * (1.0 / 32.0)).to(tl.bfloat16).to(tl.float32)
+        top = tl.maximum(top, tl.max(tl.abs(r), axis=0))
+    a = tl.where(top > 0.0, top / 448.0, 1.0)
+    tl.store(A + row, a)
+    # Second pass: recompute and emit qmm.quantize_rows' exact fragment order and group sums.
+    for blk in tl.static_range(0, K // 1024):
+        k = blk * 1024 + offs
+        r = _fwht1024(tl.load(X + row * K + k).to(tl.float32) * tl.load(S + k)) * (1.0 / 32.0)
+        # group sums and FP8 codes over bf16 rotated row, matching quantize_rows(rotate(...)).
+        rb = r.to(tl.bfloat16).to(tl.float32)
+        rg = tl.reshape(rb, (1024 // GS, GS))
+        gi = blk * (1024 // GS) + tl.arange(0, 1024 // GS)
+        tl.store(XS + row * (K // GS) + gi, (tl.sum(rg, axis=1) / a).to(tl.bfloat16))
+        idx = offs
+        p = idx % 256
+        b32 = p // 32
+        rem = p - b32 * 32
+        hi16 = rem // 16
+        rest = rem - hi16 * 16
+        half = rest // 8
+        rest2 = rest - half * 8
+        pair = rest2 // 2
+        bit = rest2 - pair * 2
+        m = b32 * 32 + hi16 * 16 + pair * 4 + bit + half * 2
+        chunk = idx // 256
+        q = (rb / a).to(tl.float8e4nv).to(tl.uint8, bitcast=True)
+        tl.store(X8 + row * K + blk * 1024 + chunk * 256 + m, q)
+
+
+def add_rmsnorm_rotate(x: torch.Tensor, residual: torch.Tensor | None, weight: torch.Tensor, eps: float,
+                       signs: torch.Tensor, *, out: torch.Tensor | None = None,
+                       h_out: torch.Tensor | None = None, gs: int = 64, return_xs: bool = True):
+    rows, d = x.shape
+    y = torch.empty_like(x, dtype=torch.bfloat16) if out is None else out
+    h = (torch.empty_like(x, dtype=torch.bfloat16) if residual is not None and h_out is None else h_out)
+    xs = torch.empty((rows, d // gs), dtype=torch.float32, device=x.device)
+    block = triton.next_power_of_2(d)
+    _add_rmsnorm_rotate[(rows, d // 1024)](x, residual if residual is not None else x,
+                                           weight, signs, h if h is not None else y, y, xs, eps,
+                                           D=d, BLOCKD=block, HAS_R=residual is not None,
+                                           STORE_H=h is not None, GS=gs,
+                                           num_warps=8)
+    if return_xs:
+        from tensorfold.cuda.kernels import qmm
+        xs = qmm.group_sums(y, gs)
+    return (h if h is not None else x), y, xs if return_xs else None
+
+
+def swiglu_rotate(gate: torch.Tensor, up: torch.Tensor, signs: torch.Tensor, *, out: torch.Tensor | None = None,
+                  gs: int = 64, return_xs: bool = True):
+    rows, n = gate.shape
+    y = torch.empty_like(gate, dtype=torch.bfloat16) if out is None else out
+    xs = torch.empty((rows, n // gs), dtype=torch.float32, device=gate.device)
+    _swiglu_rotate[(rows, n // 1024)](gate, up, signs, y, xs, N=n, GS=gs, num_warps=4)
+    if return_xs:
+        from tensorfold.cuda.kernels import qmm
+        xs = qmm.group_sums(y, gs)
+    return y, xs if return_xs else None
+
+
+def gate_mul_rotate(o: torch.Tensor, qg: torch.Tensor, signs: torch.Tensor, *, heads: int, head_dim: int,
+                    out: torch.Tensor | None = None, gs: int = 64, return_xs: bool = True):
+    rows = o.shape[0]
+    k = heads * head_dim
+    y = torch.empty((rows, k), dtype=torch.bfloat16, device=o.device) if out is None else out
+    xs = torch.empty((rows, k // gs), dtype=torch.float32, device=o.device)
+    _gate_mul_rotate[(rows, k // 1024)](o, qg, signs, y, xs, H=heads, D=head_dim, GS=gs, num_warps=4)
+    if return_xs:
+        from tensorfold.cuda.kernels import qmm
+        xs = qmm.group_sums(y, gs)
+    return y, xs if return_xs else None
+
+
+def gated_norm_rotate(y: torch.Tensor, z: torch.Tensor, weight: torch.Tensor, eps: float, signs: torch.Tensor,
+                      *, out: torch.Tensor | None = None, gs: int = 64, return_xs: bool = True):
+    rows, vh, dv = y.shape
+    k = vh * dv
+    o = torch.empty((rows, k), dtype=torch.bfloat16, device=y.device) if out is None else out
+    xs = torch.empty((rows, k // gs), dtype=torch.float32, device=y.device)
+    _gated_norm_rotate[(rows, k // 1024)](y, z, weight, signs, o, xs, eps, VH=vh, DV=dv, GS=gs, num_warps=4)
+    if return_xs:
+        from tensorfold.cuda.kernels import qmm
+        xs = qmm.group_sums(o, gs)
+    return o, xs if return_xs else None
+
+
+def rotate_quantize_rows_triton(x: torch.Tensor, signs: torch.Tensor, gs: int = 64):
+    if x.dim() != 2:
+        raise ValueError("rotate_quantize_rows expects a 2-D row tensor")
+    x = x.contiguous()
+    m, k = x.shape
+    x8 = torch.empty((m, k), dtype=torch.uint8, device=x.device)
+    xs = torch.empty((m, k // gs), dtype=torch.bfloat16, device=x.device)
+    a = torch.empty((m,), dtype=torch.float32, device=x.device)
+    _rotate_quantize_rows[(m,)](x, signs, x8, xs, a, K=k, GS=gs, num_warps=4)
+    return x8, xs, a
+
+
+# Promote the exact single-kernel implementation to the public name requested by the integration plan.
+rotate_quantize_rows = rotate_quantize_rows_triton
+
+
+def add_rmsnorm_rotate_quantize(x: torch.Tensor, residual: torch.Tensor | None, weight: torch.Tensor, eps: float,
+                                signs: torch.Tensor, gs: int = 64):
+    h, y, _ = add_rmsnorm_rotate(x, residual, weight, eps, signs, gs=gs, return_xs=False)
+    from tensorfold.cuda.kernels import qmm
+    return h, qmm.quantize_rows(y, gs)
+
+
+def swiglu_rotate_quantize(gate: torch.Tensor, up: torch.Tensor, signs: torch.Tensor, gs: int = 64):
+    y, _ = swiglu_rotate(gate, up, signs, gs=gs, return_xs=False)
+    from tensorfold.cuda.kernels import qmm
+    return qmm.quantize_rows(y, gs)
+
+
+def gate_mul_rotate_quantize(o: torch.Tensor, qg: torch.Tensor, signs: torch.Tensor, *, heads: int, head_dim: int,
+                             gs: int = 64):
+    y, _ = gate_mul_rotate(o, qg, signs, heads=heads, head_dim=head_dim, gs=gs, return_xs=False)
+    from tensorfold.cuda.kernels import qmm
+    return qmm.quantize_rows(y, gs)
+
+
+def gated_norm_rotate_quantize(y: torch.Tensor, z: torch.Tensor, weight: torch.Tensor, eps: float,
+                               signs: torch.Tensor, gs: int = 64):
+    out, _ = gated_norm_rotate(y, z, weight, eps, signs, gs=gs, return_xs=False)
+    from tensorfold.cuda.kernels import qmm
+    return qmm.quantize_rows(out, gs)
