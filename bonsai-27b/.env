# Settings for ./bonsai-27b/start.sh (Ternary-Bonsai-2-27B on one DGX Spark). Uncomment a line to change it.
# KEY=value lines; # starts a comment; quotes are optional. Never executed as a script.
# A variable set in the environment (e.g. `PARALLEL=4 ./bonsai-27b/start.sh`) wins over this file.
# Each value shown is the default the script uses when the line is commented out.

# --- Model ---
# MODEL_ID=prism-ml/Ternary-Bonsai-2-27B-mlx-2bit
# Drafter for speculative decoding (Qwen3.8-27B's DFlash2: replies are unchanged, ~2x faster at one stream);
# leave it empty (DRAFT_ID=) to serve without drafts (--no-drafts)
# DRAFT_ID=z-lab/Qwen3.8-27B-DFlash2
# SERVED_NAME=Ternary-Bonsai-2-27B

# --- Server ---
# HOST=0.0.0.0
# PORT=8888
# NAME=tf-bonsai-27b
# TensorFold release to run (default: latest)
# TF_VERSION=v0.6.5
# 1: run attached (Ctrl+C stops it) instead of in the background
# FOREGROUND=0

# --- Patches ---
# 1: run the derived image with bonsai-27b/patches (fp8 KV, video, bigger limits, reserve 0, KV pool; built once,
# only this script uses it). 0: unsupported for Bonsai CUDA on stock v0.6.5.
# PATCHES=1

# --- Capacity ---
# Attention cache: fp8 (default; 32 KiB a token, 8 GiB per full 262k window) or bf16 (64 KiB a token, 16 GiB)
KV_DTYPE=fp8
# Attention cache pinned at startup. <n>: n GiB (default 92: 10 full 262k fp8 windows plus prefix cache; needs
# ~114 GiB free, so stop other GPU workloads first); auto: free memory now - 24 GiB (- 1 GiB a stream over 8),
# at most 90; 0: no pool, the caches grow and shrink on demand
KV_POOL_GB=92
# Requests decoded together. With fp8 and the 92 GiB pool all 10 streams can use a full 262k window
# (measured; with bf16 only ~5 can at once: use PARALLEL=4, or CONTEXT=163840 with 8).
PARALLEL=10
# Prompt plus reply window, in tokens (262144 is the model's native maximum)
CONTEXT=262144
# Cached conversation prefixes kept in memory (empty: TensorFold's default, 3 per parallel lane, at least 8)
# CHECKPOINT_SLOTS=

# --- Prefill ---
# 1: FP8 prompt activations (~35-50% faster prefill, slightly lower prompt precision); 0: bf16
# PREFILL_FP8=0

# --- Vision ---
VISION=0
# 1: also accept public https:// image URLs (default: data URLs only)
# VISION_URLS=0
# VISION_MAX_IMAGES=50
# VISION_IMAGE_TOKENS=16384
# TENSORFOLD_VIDEO_TOKENS=16384
# Size limits in MiB (stock: 32, 20, 16, 20): a request body, all images of a request, one video, all videos
# REQUEST_BODY_MIB=96
# IMAGE_TOTAL_MIB=64
# VIDEO_MIB=64
# VIDEO_TOTAL_MIB=96

# --- Reasoning and sampling ---
# THINKING=1
# Default max reply length when a request does not set one
# MAX_TOKENS=131072
# Qwen's recommended values. When unset, TEMPERATURE and TOP_P follow THINKING:
#   thinking (THINKING=1):     TEMPERATURE=1.0  TOP_P=0.95
#   instruct (THINKING=0):     TEMPERATURE=0.7  TOP_P=0.80
# TEMPERATURE=1.0
# TOP_P=0.95
# TOP_K=20
# MIN_P=0.0
# (presence_penalty / repetition_penalty: not supported by TensorFold)

# --- Memory ---
# GiB of RAM TensorFold leaves free for the rest of the system (0: budget all of it; stock floor: 2)
# MEMORY_RESERVE_GIB=0
