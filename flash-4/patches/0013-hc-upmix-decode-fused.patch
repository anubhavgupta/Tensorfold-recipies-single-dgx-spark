+/// Decode-sized fused BF16 up-projection + dense stream mix (fn_hcn_up1, mt=1, 16 rows/CTA, 80 CTAs at n<=16).
+pub fn fusedUpMixDecode(k: *const Kernels, stream: cuda.Stream, act: u64, up: cuda.qmmf.Weight, h: u64, pss: u64, scale: u64, mixed: u64, xsm: u64, n: usize, e: f32) !void {
+    var b: cuda.Args = .{};
+    for ([_]u64{ act, up.codes, h, pss, scale, mixed, xsm }) |v| b.add(v);
+    for ([_]usize{ n, dims, dims / 256 }) |v| b.add(cint(v));
+    b.add(e);
+    try cuda.launch.launch(k.tiles.hcn_up1, .{ .grid = .{ .x = @intCast(cdiv(n, 16) * (dims / 32)) }, .block = .{ .x = 256 }, .shared = tk.hcnUpSmem(1) }, stream, &b);
+}
