+// A wide radix pass's cut (nbins = 1024 or 2048, blockDim.x = 1024): highest bin whose suffix sum reaches need.
+__device__ __forceinline__ void fn_qsa_bin_cut_wide(const int* hist, int nbins, int need, uint32_t cut, int shift,
+                                                    uint32_t* cut_s, int* need_s, int* warp_sums) {
+    const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
+    const int per_t = nbins >> 10;  // 1 for 1024 bins, 2 for 2048 bins
+    int c0 = hist[tid * per_t];
+    int c1 = per_t == 2 ? hist[tid * 2 + 1] : 0;
+    int wsum = c0 + c1;
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) wsum += __shfl_xor_sync(0xffffffffu, wsum, o);
+    if (lane == 0) warp_sums[warp] = wsum;
+    __syncthreads();
+    // Suffix sum across 32 warps in warp 0 (and broadcast warp_above to each warp).
+    if (warp == 0) {
+        int val = warp_sums[lane];
+        int above = val;
+#pragma unroll
+        for (int o = 1; o < 32; o <<= 1) {
+            const int v = __shfl_down_sync(0xffffffffu, above, o);
+            if (lane + o < 32) above += v;
+        }
+        warp_sums[lane] = above - val;  // sum of all warps > lane
+    }
+    __syncthreads();
+    const int w_above = warp_sums[warp];
+    // Suffix sum within this warp (lanes > lane).
+    int l_local = c0 + c1;
+    int l_above = l_local;
+#pragma unroll
+    for (int o = 1; o < 32; o <<= 1) {
+        const int v = __shfl_down_sync(0xffffffffu, l_above, o);
+        if (lane + o < 32) l_above += v;
+    }
+    l_above = w_above + (l_above - l_local);
+    // Check highest bin in this thread: bin1 = tid*2+1 (if per_t==2), then bin0 = tid*per_t.
+    int s = l_above;
+    if (per_t == 2) {
+        if (s < need && s + c1 >= need) {
+            *need_s = need - s;
+            *cut_s = cut | (static_cast<uint32_t>(tid * 2 + 1) << shift);
+        }
+        s += c1;
+    }
+    if (s < need && s + c0 >= need) {
+        *need_s = need - s;
+        *cut_s = cut | (static_cast<uint32_t>(tid * per_t) << shift);
+    }
+}
