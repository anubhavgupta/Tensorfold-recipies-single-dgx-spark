+// The same warp loop for MTL 16-row tiles at once: each tile of weights is decoded once and feeds every row tile's mma, so a
+// prompt item of up to 16 * MTL members pays for one decode. Every row's accumulation is the one grouped_body's: same k order.
+template <int CB, int K2, int NT, int LOAD, int MTL>
+__device__ __forceinline__ void warp_tiles_mtl(const uint32_t* T, int ntiles, int kt0, int nkt, int nt0, const half* const (&x0)[MTL],
+                                               const half* const (&x1)[MTL], const bool (&ok0)[MTL], const bool (&ok1)[MTL],
+                                               const bool (&live)[MTL], int lane, float (&acc)[MTL][NT][2][4]) {
+    constexpr int TW = tile_words<K2>(), LW = lane_words<K2>();
+    const size_t kstride = (size_t)ntiles * TW;
+    const uint32_t* tb = T + (size_t)kt0 * kstride + (size_t)nt0 * TW;
+    uint32_t nx[NT][LW];
+    if (LOAD != PLAIN && nkt > 0)
+#pragma unroll
+        for (int j = 0; j < NT; ++j) ldg_lane_words<K2>(tb + j * TW, lane, nx[j]);
+    for (int i = 0; i < nkt; ++i) {
+        uint32_t w[NT][LW];
+        if constexpr (LOAD == PLAIN) {
+            const uint32_t* t0 = T + (size_t)(kt0 + i) * kstride + (size_t)nt0 * TW;
+#pragma unroll
+            for (int j = 0; j < NT; ++j) ldg_lane_words<K2>(t0 + j * TW, lane, w[j]);
+        } else {
+#pragma unroll
+            for (int j = 0; j < NT; ++j)
+#pragma unroll
+                for (int l = 0; l < LW; ++l) w[j][l] = nx[j][l];
+            if (i + 1 < nkt)
+#pragma unroll
+                for (int j = 0; j < NT; ++j) ldg_lane_words<K2>(tb + (size_t)(i + 1) * kstride + j * TW, lane, nx[j]);
+        }
+        const int k = (kt0 + i) * 16;
+        uint32_t a[MTL][4];
+#pragma unroll
+        for (int m = 0; m < MTL; ++m) {
+            a[m][0] = ok0[m] ? *reinterpret_cast<const uint32_t*>(x0[m] + k) : 0u;
+            a[m][1] = ok1[m] ? *reinterpret_cast<const uint32_t*>(x1[m] + k) : 0u;
+            a[m][2] = ok0[m] ? *reinterpret_cast<const uint32_t*>(x0[m] + k + 8) : 0u;
+            a[m][3] = ok1[m] ? *reinterpret_cast<const uint32_t*>(x1[m] + k + 8) : 0u;
+        }
+#pragma unroll
+        for (int j = 0; j < NT; ++j) {
+            uint32_t b0[2], b1[2];
+            decode_lane<K2, CB>(w[j], lane, b0, b1);
+#pragma unroll
+            for (int m = 0; m < MTL; ++m)
+                if (live[m]) {
+                    mma16816(acc[m][j][0], a[m], b0);
+                    mma16816(acc[m][j][1], a[m], b1);
+                }
+        }
+    }
+}
+
+// grouped_body for the plan's items (standard mode) of up to a.maxm members, in groups of MTL 16-row tiles a program: one
+// decode of the weights for all of them. nblock counts NT-tile column blocks. Rows' sums equal grouped_body's bit for bit.
+template <int CB, int NT, int W, int LOAD, int MTL>
+__device__ __forceinline__ void grouped_body_mtl(const GroupedArgs a, int u, int nblock, int zz) {
+    if (u >= a.ucount[0]) return;
+    const int MG = (a.maxm + 16 * MTL - 1) / (16 * MTL);
+    const int mgroup = zz % MG;
+    const int split = (zz / MG) % a.sk;
+    const int mat = zz / MG / a.sk;
+    const half* X = mat ? a.x1 : a.x0;
+    const int e = a.uids[3 * u];
+    if (e == a.skip) return;
+    const uint32_t* T = reinterpret_cast<const uint32_t*>(mat ? a.tp1[e] : a.tp0[e]);
+    const int k2 = mat ? a.k2_1[e] : a.k2_0[e];
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int g = lane >> 2, t = lane & 3;
+    const int NTILES = a.ns > 0 ? a.ns : (a.n >> 4);
+
+    __shared__ int rows_sh[MTL][16];
+    const int count = a.uids[3 * u + 2], first = a.uids[3 * u + 1];
+    for (int q = threadIdx.x; q < MTL * 16; q += W * 32) {
+        const int m = mgroup * MTL * 16 + q;
+        rows_sh[q / 16][q % 16] = m < count ? a.members[first + m] : -1;
+    }
+    __syncthreads();
+    if (rows_sh[0][0] < 0) return;  // members come first, so this group is empty
+    const half* x0[MTL];
+    const half* x1[MTL];
+    bool ok0[MTL], ok1[MTL], live[MTL];
+#pragma unroll
+    for (int m = 0; m < MTL; ++m) {
+        const int r0 = rows_sh[m][g], r1 = rows_sh[m][g + 8];
+        x0[m] = X + (size_t)(r0 < 0 ? 0 : r0) * a.k + 2 * t;
+        x1[m] = X + (size_t)(r1 < 0 ? 0 : r1) * a.k + 2 * t;
+        ok0[m] = r0 >= 0;
+        ok1[m] = r1 >= 0;
+        live[m] = rows_sh[m][0] >= 0;
+    }
+    const int per_warp = (a.k >> 4) / a.sk / W;
+    const int kt0 = split * (per_warp * W) + warp * per_warp;
+    const int nt0 = nblock * NT;
+
+    float acc[MTL][NT][2][4];
+#pragma unroll
+    for (int m = 0; m < MTL; ++m)
+#pragma unroll
+        for (int i = 0; i < NT; ++i)
+#pragma unroll
+            for (int h = 0; h < 2; ++h)
+#pragma unroll
+                for (int c = 0; c < 4; ++c) acc[m][i][h][c] = 0.f;
+
+    switch (k2) {
+#define TF_EXL3X_CASE(K2_)                                                                                                  \
+    case K2_:                                                                                                               \
+        warp_tiles_mtl<CB, K2_, NT, LOAD, MTL>(T, NTILES, kt0, per_warp, nt0, x0, x1, ok0, ok1, live, lane, acc);           \
+        break;
+        TF_EXL3X_CASE(2)
+        TF_EXL3X_CASE(3)
+        TF_EXL3X_CASE(4)
+        TF_EXL3X_CASE(5)
+        TF_EXL3X_CASE(6)
+        TF_EXL3X_CASE(7)
+        TF_EXL3X_CASE(8)
+        TF_EXL3X_CASE(9)
+        TF_EXL3X_CASE(10)
+        TF_EXL3X_CASE(11)
+        TF_EXL3X_CASE(12)
+        TF_EXL3X_CASE(13)
+        TF_EXL3X_CASE(14)
+        TF_EXL3X_CASE(15)
+        TF_EXL3X_CASE(16)
+#undef TF_EXL3X_CASE
+        default:
+            __trap();
+    }
+
+    __shared__ __align__(16) float red[W][16][NT * 16];
+#pragma unroll
+    for (int m = 0; m < MTL; ++m) {
+        if (m) __syncthreads();
+        if (!live[m]) continue;  // uniform across the block
+#pragma unroll
+        for (int i = 0; i < NT; ++i)
+#pragma unroll
+            for (int h = 0; h < 2; ++h) {
+                const int col = i * 16 + h * 8 + 2 * t;
+                red[warp][g][col] = acc[m][i][h][0];
+                red[warp][g][col + 1] = acc[m][i][h][1];
+                red[warp][g + 8][col] = acc[m][i][h][2];
+                red[warp][g + 8][col + 1] = acc[m][i][h][3];
+            }
+        __syncthreads();
+        for (int idx = threadIdx.x; idx < 16 * NT * 16; idx += W * 32) {
+            const int row = idx / (NT * 16), col = idx % (NT * 16);
+            const int r = rows_sh[m][row];
+            if (r < 0) continue;
+            float s = red[0][row][col];
+#pragma unroll
+            for (int w = 1; w < W; ++w) s += red[w][row][col];
+            a.z[(((size_t)mat * a.sk + split) * a.p + r) * a.n + nt0 * 16 + col] = s;
+        }
+    }
+}
+
 }  // namespace tf_exl3
