+
+// ExLlamaV3-style prefill staging: unpack EXL3 trellis [K/16, N/16] into row-major W_f16 [N, K] for cuBLASLt FP16 GEMM.
+template <int K2, int CB>
+__device__ __forceinline__ void unpack_f16_nk_body(const uint32_t* __restrict__ t, long long stride_k, long long stride_nb,
+                                                   half* __restrict__ out, int K, int N) {
+    constexpr int TW = tile_words<K2>(), LW = lane_words<K2>();
+    const int tn = blockIdx.x, tk = blockIdx.y, lane = threadIdx.x;
+    const int nb = tn >> 3, j_in_nb = tn & 7;
+    const uint32_t* tile = t + nb * stride_nb + (long long)tk * stride_k + j_in_nb * TW;
+    uint32_t w[LW];
+    ldg_lane_words<K2>(tile, lane, w);
+    uint32_t b0[2], b1[2];
+    decode_lane<K2, CB>(w, lane, b0, b1);
+    const half2 h0 = *reinterpret_cast<const half2*>(&b0[0]);
+    const half2 h1 = *reinterpret_cast<const half2*>(&b0[1]);
+    const half2 h2 = *reinterpret_cast<const half2*>(&b1[0]);
+    const half2 h3 = *reinterpret_cast<const half2*>(&b1[1]);
+    const half hv[8] = {__low2half(h0), __high2half(h0), __low2half(h1), __high2half(h1),
+                        __low2half(h2), __high2half(h2), __low2half(h3), __high2half(h3)};
+    __shared__ __align__(16) half sh[16][24];
+#pragma unroll
+    for (int j = 0; j < 8; ++j) sh[value_col(lane, j)][value_row(lane, j)] = hv[j];
+    __syncwarp();
+    const int r = lane >> 1, c8 = (lane & 1) * 8;
+    *reinterpret_cast<uint4*>(out + (size_t)(tn * 16 + r) * K + tk * 16 + c8) = *reinterpret_cast<const uint4*>(&sh[r][c8]);
+}
+
+extern "C" __global__ void __launch_bounds__(32)
+    tf_exl3_unpack_f16_nk_12_2(const uint32_t* __restrict__ t, long long stride_k, long long stride_nb,
+                               half* __restrict__ out, int K, int N) {
+    unpack_f16_nk_body<12, CB_MUL1>(t, stride_k, stride_nb, out, K, N);
+}
+
+extern "C" __global__ void __launch_bounds__(32)
+    tf_exl3_unpack_f16_nk_8_2(const uint32_t* __restrict__ t, long long stride_k, long long stride_nb,
+                              half* __restrict__ out, int K, int N) {
+    unpack_f16_nk_body<8, CB_MUL1>(t, stride_k, stride_nb, out, K, N);
+}
+
+// Post-rotation of Z [M, N] (fp32) by H / sqrt(128) * svh + bias -> Y [M, y_stride] (bf16 or fp32).
+extern "C" __global__ void __launch_bounds__(32)
+    tf_exl3_rot_out(const void* __restrict__ z, void* __restrict__ y, const half* __restrict__ svh,
+                    const half* __restrict__ bias, int in_dtype, int out_dtype, int m, int n, int y_stride) {
+    const int row = blockIdx.y, blk = blockIdx.x, lane = threadIdx.x;
+    if (row >= m) return;
+    const int col = blk * 128 + 4 * lane;
+    const int ys = y_stride ? y_stride : n;
+    float v[4];
+    load4(z, in_dtype, (size_t)row * n + col, v);
+    finish(v, lane, svh, bias, col);
+    store4(y, out_dtype, (size_t)row * ys + col, v);
+}
 #undef TF_EXL3_CODEBOOK
 #undef TF_EXL3_WIDTHS
 }  // namespace tf_exl3
