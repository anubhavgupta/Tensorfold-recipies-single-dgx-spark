+++ b/zig/src/server/tool_stream.zig
@@ -231,7 +231,8 @@ pub const Streamer = struct {
                 .call => {
                     if (opening(rest, "<function=")) |m| {
                         const lower = try std.ascii.allocLowerString(s.a, reply_text.pyStrip(m.name));
-                        const name = s.known.get(lower) orelse {
+                        const written = reply_text.pyStrip(m.name);
+                        const name = s.known.get(lower) orelse if (tool_parse.unofferedPass(written)) try s.a.dupe(u8, written) else {
                             s.buffered_close = "</tool_call>";
                             s.dsml_searched = s.pos;
                             if (!s.giveUp()) return;
diff --git a/zig/src/server/tool_stream_test.zig b/zig/src/server/tool_stream_test.zig
index b1177ce..4dce930 100644
--- a/zig/src/server/tool_stream_test.zig
+++ b/zig/src/server/tool_stream_test.zig
@@ -251,3 +251,43 @@ test "a malformed DSML block's header stands: its nested XML is argument text an
         try std.testing.expectEqualStrings("{\"q\":\"<tool_call><function=lookup></function></tool_call>\"{}", try sentArguments(a, out.items));
     }
 }
+
+test "TF_TOOL_UNOFFERED_PREFIX returns a prefixed unoffered call, final and streamed, and keeps other names as text" {
+    const env = @import("sys").env;
+    defer _ = env.unsetenv("TF_TOOL_UNOFFERED_PREFIX");
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const tools = (try json.parse(a, "[{\"type\":\"function\",\"function\":{\"name\":\"codemode\"}}]")).ok.array;
+    const mcp = "Opening. <tool_call>\n<function=mcp__chrome__new_page>\n<parameter=url>\nhttps://x.test/?q=a\n</parameter>\n</function>\n</tool_call>";
+    const other = "Opening. <tool_call><function=launch><parameter=when>now</parameter></function></tool_call>";
+
+    _ = env.unsetenv("TF_TOOL_UNOFFERED_PREFIX");
+    const off = try tool_parse.parse(a, mcp, tools, null);
+    try std.testing.expect(off.calls == null and off.kept_unoffered == 1);
+
+    _ = env.setenv("TF_TOOL_UNOFFERED_PREFIX", "mcp__", 1);
+    const on = try tool_parse.parse(a, mcp, tools, null);
+    try std.testing.expectEqual(@as(usize, 1), on.calls.?.len);
+    try std.testing.expectEqualStrings("mcp__chrome__new_page", on.calls.?[0].get("function").?.strField("name").?);
+    try std.testing.expectEqualStrings("{\"url\":\"https://x.test/?q=a\"}", on.calls.?[0].get("function").?.strField("arguments").?);
+    try std.testing.expectEqualStrings("Opening.", on.content);
+    try std.testing.expectEqual(@as(usize, 0), on.rejected_envelopes);
+
+    const kept = try tool_parse.parse(a, other, tools, null);
+    try std.testing.expect(kept.calls == null and kept.kept_unoffered == 1);
+
+    // streamed through every prefix: exactly one call, with the same arguments
+    for (0..mcp.len + 1) |n| {
+        var s = try Streamer.init(a, tools);
+        var out: std.ArrayList(Value) = .empty;
+        try s.feed(mcp[0..n], &out);
+        try s.feed(mcp, &out);
+        var names: usize = 0;
+        for (out.items) |d| for (d.get("tool_calls").?.array) |c| {
+            if (c.get("id") != null) names += 1;
+        };
+        try std.testing.expectEqual(@as(usize, 1), names);
+        try std.testing.expectEqualStrings("{\"url\":\"https://x.test/?q=a\"}", try canonical(a, try sentArguments(a, out.items)));
+    }
+}
