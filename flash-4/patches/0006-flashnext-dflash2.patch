diff --git a/zig/src/families/flashnext/cuda_dflash.zig b/zig/src/families/flashnext/cuda_dflash.zig
new file mode 100644
index 0000000..6276ef6
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_dflash.zig
@@ -0,0 +1,504 @@
+//! DFlash2 drafts for Flash Next (--drafter): incoai/Qwen3.8-Flash-Next-DFlash2 (Apache-2.0, read unmodified), after z-lab
+//! (MIT) and TensorFold's GLM port (glm/dflash.zig). The drafter reads the target's taps (cuda_dflash_taps.zig), keeps
+//! them as keys and values of five sliding-window layers, and drafts a block of 8 from the pending token; the target
+//! verifies every draft, so drafts only change speed. Its linears run on the engine's 4-bit lane, its logits over the
+//! MTP head's draft vocabulary (the target's lm_head rows at 4 bits), its token embeddings are the target's.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const prompt = @import("cuda_prompt.zig");
+const mtp = @import("cuda_mtp.zig");
+const tiles = @import("cuda_tiles.zig");
+const taps_mod = @import("cuda_dflash_taps.zig");
+const select = @import("cuda_dflash_select.zig");
+
+const Q4 = wt.Q4;
+
+pub const BLOCK: usize = 8;
+pub const MASK: u32 = 248077;
+pub const WIN: usize = 2048; // the context window (and a ring's slots)
+pub const LAYERS: usize = 5;
+pub const D: usize = wt.dims;
+pub const HD: usize = 128;
+pub const QH: usize = 32;
+pub const KVH: usize = 8;
+pub const QW: usize = QH * HD;
+pub const KVW: usize = KVH * HD;
+pub const QKV: usize = QW + 2 * KVW;
+pub const FF: usize = 7680;
+pub const RANK: usize = 256;
+pub const TOPK: usize = 16;
+pub const VOCAB: usize = wt.vocab;
+pub const THETA: f32 = 10000;
+pub const EPS: f32 = 1e-6;
+pub const SCALE: f32 = 0.08838834764831845; // 128^-0.5
+pub const CH: usize = 16; // key chunks of the chunked attention (df_attn_part)
+pub const CW: usize = 2 * TOPK; // a row's gathered ints: 16 columns, then 16 values' bits
+pub const MAX_S: usize = 16; // streams one block pass drafts for
+pub const MAX_M: usize = MAX_S * BLOCK; // block rows at most
+pub const MAX_CTX: usize = 2048; // context rows one ingest takes
+pub const TAP_ROW: usize = taps_mod.row_bytes;
+pub const DYN: usize = 4 * D / 16; // a convolution's dynamic tap weights a row: in and out, 2 taps, 160 groups
+pub const head_cols: usize = 4096; // columns a top-16 part takes
+pub const max_drafts: usize = BLOCK - 1;
+
+/// Device bytes a stream's context ring takes (K and V of every layer).
+pub const ring_bytes: u64 = LAYERS * 2 * @as(u64, WIN) * KVW * 2;
+/// A stream's tap rows of its last verify window.
+pub fn tapBytes() u64 {
+    return @as(u64, mtp.bufferRows()) * TAP_ROW;
+}
+/// Device bytes each admitted stream takes beside its target's caches.
+pub fn streamBytes() u64 {
+    return ring_bytes + tapBytes();
+}
+
+/// TF_FLASHNEXT_DFLASH_DRAFTS: drafts a round at most (a block holds 7).
+pub fn drafts() !usize {
+    const n = try @import("sys").environment.read(usize, "TF_FLASHNEXT_DFLASH_DRAFTS", max_drafts);
+    return @max(1, @min(max_drafts, n));
+}
+
+/// TF_FLASHNEXT_DFLASH_CONFIDENCE: a chain stops where the product of its picks' probabilities falls under this (the first
+/// draft always stays). A draft row costs about 3 ms of the target's verify however many streams share it, so a row
+/// must land at least 0.3 of the time (one stream) to pay; 0.5 held up from one stream to nine.
+pub fn confidence() !f64 {
+    return @import("sys").environment.read(f64, "TF_FLASHNEXT_DFLASH_CONFIDENCE", 0.5);
+}
+
+/// TF_FLASHNEXT_DFLASH_COPIES: whether the lane core also proposes copies of the context (0: the drafter alone drafts).
+/// Copies make a copy-heavy reply (echoing a file) 2.4x faster and cost JSON-like replies about 6%.
+pub fn copies() !bool {
+    return @import("sys").environment.read(bool, "TF_FLASHNEXT_DFLASH_COPIES", true);
+}
+
+/// flashnext_dflash's functions.
+pub const Kernels = struct {
+    tap: cuda.Function,
+    block_qkv: cuda.Function,
+    ctx_kv: cuda.Function,
+    conv: cuda.Function,
+    swiglu: cuda.Function,
+    attn_part: cuda.Function,
+    attn_merge: cuda.Function,
+    top16_part: cuda.Function,
+    top16_merge: cuda.Function,
+    gsum: cuda.Function,
+    proj: cuda.Function,
+
+    pub fn load(m: cuda.Module) !Kernels {
+        var k: Kernels = undefined;
+        inline for (@typeInfo(Kernels).@"struct".field_names) |n| @field(k, n) = try m.function("df_" ++ n);
+        return k;
+    }
+};
+
+/// One layer's device tensors: norm weights fp32, q/k norms and conv bases bf16, linears on the 4-bit lane.
+pub const LayerW = struct { in_norm: u64, post_norm: u64, qn: u64, kn: u64, a_base: u64, m_base: u64, qkv: Q4, kv: Q4, o: Q4, gu: Q4, down: Q4, a_proj: Q4, m_proj: Q4 };
+
+/// A stream's drafter state: its context ring, the tap rows of its last verify window, where its context starts and ends.
+pub const LaneState = struct {
+    ring: cuda.DeviceBuffer,
+    taps: cuda.DeviceBuffer,
+    from: i64 = 0, // the first position the ring holds for this sequence
+    end: i64 = -1, // the next position it takes (-1: none yet)
+
+    /// `n` rows at `pos0` went into the ring: a gap restarts the context there.
+    pub fn took(l: *LaneState, pos0: i64, n: usize) void {
+        if (pos0 != l.end) l.from = pos0;
+        l.end = pos0 + @as(i64, @intCast(n));
+    }
+
+    pub fn free(l: *LaneState) void {
+        l.ring.free();
+        l.taps.free();
+    }
+};
+
+/// Context runs: `n` tap rows at `taps` (consecutive), positions pos0.., into `ring`.
+pub const Run = struct { ring: u64, taps: u64, n: usize, pos0: i64 };
+
+/// One stream's block: the pending token at `start`, its ring, up to `depth` drafts into `out`.
+pub const Req = struct { lane: *const LaneState, anchor: u32, start: i64, depth: usize, out: *mtp.Chain, sampling: ?mtp.Sampling = null, position: u64 = 0 };
+
+/// The loaded drafter: weights, scratch, the selector's codebooks and the host tables of a pass.
+pub const Drafter = struct {
+    gpa: std.mem.Allocator,
+    d: *cuda.Driver,
+    module: cuda.Module,
+    k: Kernels,
+    layers: [LAYERS]LayerW = undefined,
+    fc: Q4 = undefined,
+    bufs: std.ArrayList(cuda.DeviceBuffer) = .empty, // the small tensors, freed with it
+    hproj: u64 = 0,
+    hnorm: u64 = 0,
+    norm: u64 = 0,
+    pred: []u16 = &.{}, // the selector's codebooks, bf16 [VOCAB][RANK] (host: a draft reads 16 rows)
+    succ: []u16 = &.{},
+    ids: []const u32 = &.{}, // the draft vocabulary: head column j is token ids[j]
+    head: Q4 = undefined, // the target's lm_head rows at `ids`, 4 bits (the MTP head's, borrowed)
+    confidence: f64 = 0.5,
+    copies: bool = true,
+    depth: usize = max_drafts,
+    spare: std.ArrayList(LaneState) = .empty, // rings and tap rows of finished streams
+    scratch: cuda.DeviceBuffer = undefined,
+    timing: bool = false, // TF_FLASHNEXT_DFLASH_TIMING=1: each phase synchronized and timed, logged every 64 rounds (also the lanes' round timing)
+    timed_calls: u64 = 0,
+    phase_ms: [3]f64 = @splat(0),
+    // device scratch (carved by carve)
+    x: u64 = 0,
+    y: u64 = 0,
+    y2: u64 = 0,
+    dyn: u64 = 0,
+    qkv: u64 = 0,
+    q: u64 = 0,
+    kb: u64 = 0,
+    vb: u64 = 0,
+    att: u64 = 0,
+    a: u64 = 0,
+    gu: u64 = 0,
+    act: u64 = 0,
+    hn: u64 = 0,
+    xs: u64 = 0,
+    g: u64 = 0,
+    logits: u64 = 0,
+    cin: u64 = 0,
+    c1: u64 = 0,
+    ctx: u64 = 0,
+    ckv: u64 = 0,
+    ids_d: u64 = 0,
+    bpos: u64 = 0,
+    rings: u64 = 0,
+    starts: u64 = 0,
+    froms: u64 = 0,
+    cpos: u64 = 0,
+    crings: u64 = 0,
+    pv: u64 = 0,
+    pi: u64 = 0,
+    pm: u64 = 0,
+    pl: u64 = 0,
+    pacc: u64 = 0,
+    gtk: u64 = 0,
+    // host tables
+    h_ids: [MAX_M]i32 = undefined,
+    h_bpos: [MAX_M]i32 = undefined,
+    h_rings: [MAX_S]u64 = undefined,
+    h_starts: [MAX_S]i64 = undefined,
+    h_froms: [MAX_S]i64 = undefined,
+    h_cpos: []i64 = &.{},
+    h_crings: []u64 = &.{},
+    cand: []i32 = &.{}, // the candidates [MAX_M][CW]
+    gh: []f32 = &.{}, // the selector's hidden projections [MAX_M][RANK]
+
+    pub fn deinit(dr: *Drafter) void {
+        for (dr.spare.items) |*l| l.free();
+        dr.spare.deinit(dr.gpa);
+        dr.scratch.free();
+        for (&dr.layers) |*l| for ([_]*Q4{ &l.qkv, &l.kv, &l.o, &l.gu, &l.down, &l.a_proj, &l.m_proj }) |q| q.free();
+        dr.fc.free();
+        for (dr.bufs.items) |*b| b.free();
+        dr.bufs.deinit(dr.gpa);
+        dr.module.unload();
+        const g = dr.gpa;
+        g.free(dr.pred);
+        g.free(dr.succ);
+        g.free(dr.h_cpos);
+        g.free(dr.h_crings);
+        g.free(dr.cand);
+        g.free(dr.gh);
+        g.destroy(dr);
+    }
+
+    /// Device bytes the weights and scratch take (the startup log's figure).
+    pub fn nbytes(dr: *const Drafter) u64 {
+        var n: u64 = dr.scratch.len + dr.fc.w.len + dr.fc.s.len + dr.fc.b.len;
+        for (dr.layers) |l| for ([_]Q4{ l.qkv, l.kv, l.o, l.gu, l.down, l.a_proj, l.m_proj }) |q| {
+            n += q.w.len + q.s.len + q.b.len;
+        };
+        for (dr.bufs.items) |b| n += b.len;
+        return n;
+    }
+
+    /// A stream's state (its ring and tap rows from the spares, or new), its context empty.
+    pub fn lane(dr: *Drafter) !LaneState {
+        if (dr.spare.pop()) |l| {
+            var s = l;
+            s.from = 0;
+            s.end = -1;
+            return s;
+        }
+        var ring = try cuda.DeviceBuffer.alloc(dr.d, ring_bytes);
+        errdefer ring.free();
+        const taps = try cuda.DeviceBuffer.alloc(dr.d, tapBytes());
+        return .{ .ring = ring, .taps = taps };
+    }
+
+    /// A finished stream's buffers back to the spares (or freed when none can be kept).
+    pub fn give(dr: *Drafter, l: LaneState) void {
+        dr.spare.append(dr.gpa, l) catch {
+            var m = l;
+            m.free();
+        };
+    }
+
+    /// The device pointer the prompt passes tap into, and its rows.
+    pub fn promptTaps(dr: *const Drafter) u64 {
+        return dr.cin;
+    }
+};
+
+/// The drafter's passes over an engine: `tri` launches the engine's norms and embeddings.
+pub fn Ops(comptime Tri: type) type {
+    return struct {
+        e: *prompt.Engine,
+        tri: Tri,
+        dr: *Drafter,
+
+        const Self = @This();
+
+        fn go(o: Self, f: cuda.Function, grid: cuda.Dim3, threads: u32, a: *cuda.Args) !void {
+            try cuda.launch.launch(f, .{ .grid = grid, .block = .{ .x = threads } }, o.e.stream.*, a);
+        }
+
+        /// out[m, n] = x[m, k] . w^T on the engine's 4-bit lane (xs: x's 32-group sums).
+        fn lin(o: Self, x: u64, xs: u64, w: Q4, out: u64, m: usize) !void {
+            const s = try o.e.reserve(1);
+            _ = try tiles.matmul(&o.e.batch_k, o.e.stream.*, x, xs, w, out, s.dummy, s.native_part, m, 1);
+        }
+
+        fn gsum(o: Self, x: u64, k: usize, m: usize, xs: u64) !void {
+            var a: cuda.Args = .{};
+            a.add(x);
+            a.add(@as(i32, @intCast(k)));
+            a.add(xs);
+            try o.go(o.dr.k.gsum, .{ .x = @intCast(m) }, 256, &a);
+        }
+
+        fn upload(o: Self, dst: u64, bytes: []const u8) !void {
+            const b: cuda.DeviceBuffer = .{ .d = o.e.driver, .ptr = dst, .len = bytes.len, .borrowed = true };
+            try b.uploadAsync(0, bytes, o.e.stream.handle);
+        }
+
+        fn copy(o: Self, dst: u64, src: u64, n: usize) !void {
+            if (dst == src or n == 0) return;
+            const d = o.e.driver;
+            try d.check(d.api.cuMemcpyDtoDAsync_v2(dst, src, n, o.e.stream.handle), "cuMemcpyDtoDAsync");
+        }
+
+        /// The runs' rows through fc, the hidden norm and each layer's k, v into their rings.
+        pub fn ingest(o: Self, runs: []const Run) !void {
+            const dr = o.dr;
+            var n: usize = 0;
+            for (runs) |r| n += r.n;
+            if (n == 0) return;
+            if (n > MAX_CTX) return error.DrafterContextTooWide;
+            var row: usize = 0;
+            for (runs) |r| {
+                try o.copy(dr.cin + row * TAP_ROW, r.taps, r.n * TAP_ROW);
+                for (0..r.n) |j| {
+                    dr.h_cpos[row + j] = r.pos0 + @as(i64, @intCast(j));
+                    dr.h_crings[row + j] = r.ring;
+                }
+                row += r.n;
+            }
+            try o.upload(dr.cpos, std.mem.sliceAsBytes(dr.h_cpos[0..n]));
+            try o.upload(dr.crings, std.mem.sliceAsBytes(dr.h_crings[0..n]));
+            try o.ingestPass(n);
+        }
+
+        /// `N` context rows (cin, cpos, crings in place) through fc, the hidden norm and each layer's k, v into the rings.
+        fn ingestPass(o: Self, N: usize) !void {
+            const dr = o.dr;
+            try o.gsum(dr.cin, taps_mod.layers.len * D, N, dr.xs);
+            try o.lin(dr.cin, dr.xs, dr.fc, dr.c1, N);
+            try o.tri.rmsnorm(dr.c1, dr.hnorm, dr.ctx, dr.xs, EPS, D, N, D, D);
+            for (dr.layers, 0..) |l, li| {
+                try o.lin(dr.ctx, dr.xs, l.kv, dr.ckv, N);
+                var a: cuda.Args = .{};
+                a.add(dr.ckv);
+                a.add(l.kn);
+                a.add(dr.cpos);
+                a.add(dr.crings);
+                a.add(@as(i32, @intCast(li)));
+                a.add(EPS);
+                a.add(THETA);
+                try o.go(dr.k.ctx_kv, .{ .x = @intCast(N), .y = KVH }, 64, &a);
+            }
+        }
+
+        fn conv(o: Self, z: u64, which: i32, base: u64, out: u64, add: bool, M: usize) !void {
+            var a: cuda.Args = .{};
+            a.add(z);
+            a.add(o.dr.dyn);
+            a.add(which);
+            a.add(base);
+            a.add(out);
+            a.add(@as(i32, @intFromBool(add)));
+            try o.go(o.dr.k.conv, .{ .x = @intCast(M), .y = @intCast((D + 1023) / 1024) }, 256, &a);
+        }
+
+        /// The block pass for `S` streams (tables uploaded): embed, 5 layers, norm, the draft head, each row's 16 best.
+        fn pass(o: Self, S: usize) !void {
+            const dr = o.dr;
+            const e = o.e;
+            const M = S * BLOCK;
+            if (e.table.dense) try o.tri.embedDense(dr.ids_d, e.table.w.ptr, dr.x, D, 1, M) else try o.tri.embed(dr.ids_d, e.table.w.ptr, e.table.s.ptr, e.table.b.ptr, dr.x, D, 1, M);
+            for (dr.layers, 0..) |l, li| {
+                // attention, wrapped in the attention convolution
+                try o.tri.rmsnorm(dr.x, l.in_norm, dr.y, dr.xs, EPS, D, M, D, D);
+                try o.lin(dr.y, dr.xs, l.a_proj, dr.dyn, M);
+                try o.conv(dr.y, 0, l.a_base, dr.y2, false, M);
+                try o.gsum(dr.y2, D, M, dr.xs);
+                try o.lin(dr.y2, dr.xs, l.qkv, dr.qkv, M);
+                {
+                    var a: cuda.Args = .{};
+                    a.add(dr.qkv);
+                    a.add(@as(i32, @intCast(QKV)));
+                    a.add(l.qn);
+                    a.add(l.kn);
+                    a.add(dr.bpos);
+                    a.add(EPS);
+                    a.add(THETA);
+                    a.add(dr.q);
+                    a.add(dr.kb);
+                    a.add(dr.vb);
+                    try o.go(dr.k.block_qkv, .{ .x = @intCast(M), .y = @intCast(QH + KVH) }, 64, &a);
+                }
+                {
+                    var a: cuda.Args = .{};
+                    for ([_]u64{ dr.q, dr.kb, dr.vb, dr.rings, dr.starts, dr.froms }) |p| a.add(p);
+                    a.add(@as(i32, @intCast(li)));
+                    a.add(SCALE);
+                    for ([_]u64{ dr.pm, dr.pl, dr.pacc }) |p| a.add(p);
+                    try o.go(dr.k.attn_part, .{ .x = @intCast(S), .y = KVH, .z = CH }, 256, &a);
+                    var b: cuda.Args = .{};
+                    for ([_]u64{ dr.pm, dr.pl, dr.pacc, dr.att }) |p| b.add(p);
+                    try o.go(dr.k.attn_merge, .{ .x = @intCast(M), .y = QH }, HD, &b);
+                }
+                try o.gsum(dr.att, QW, M, dr.xs);
+                try o.lin(dr.att, dr.xs, l.o, dr.a, M);
+                try o.conv(dr.a, 1, l.a_base + 2 * D * 2, dr.x, true, M);
+                // the MLP, wrapped in the MLP convolution
+                try o.tri.rmsnorm(dr.x, l.post_norm, dr.y, dr.xs, EPS, D, M, D, D);
+                try o.lin(dr.y, dr.xs, l.m_proj, dr.dyn, M);
+                try o.conv(dr.y, 0, l.m_base, dr.y2, false, M);
+                try o.gsum(dr.y2, D, M, dr.xs);
+                try o.lin(dr.y2, dr.xs, l.gu, dr.gu, M);
+                {
+                    var a: cuda.Args = .{};
+                    a.add(dr.gu);
+                    a.add(dr.act);
+                    a.add(@as(i32, @intCast(FF)));
+                    try o.go(dr.k.swiglu, .{ .x = @intCast(M), .y = @intCast((FF + 1023) / 1024) }, 256, &a);
+                }
+                try o.gsum(dr.act, FF, M, dr.xs);
+                try o.lin(dr.act, dr.xs, l.down, dr.a, M);
+                try o.conv(dr.a, 1, l.m_base + 2 * D * 2, dr.x, true, M);
+            }
+            try o.tri.rmsnorm(dr.x, dr.norm, dr.hn, dr.xs, EPS, D, M, D, D);
+            // every row through the draft head (a few rows a launch: the lane's tile), its 16 best columns
+            const n = dr.head.n;
+            var r0: usize = 0;
+            while (r0 < M) : (r0 += 32) {
+                const rows = @min(32, M - r0);
+                try o.lin(dr.hn + r0 * D * 2, dr.xs + r0 * (D / 32) * 4, dr.head, dr.logits + r0 * n * 2, rows);
+            }
+            const chunks = (n + head_cols - 1) / head_cols;
+            {
+                var a: cuda.Args = .{};
+                a.add(dr.logits);
+                a.add(@as(i32, @intCast(n)));
+                a.add(@as(i32, 0));
+                a.add(dr.pv);
+                a.add(dr.pi);
+                try o.go(dr.k.top16_part, .{ .x = @intCast(M), .y = @intCast(chunks) }, 256, &a);
+                var b: cuda.Args = .{};
+                b.add(dr.pv);
+                b.add(dr.pi);
+                b.add(@as(i32, @intCast(chunks)));
+                b.add(dr.gtk);
+                try o.go(dr.k.top16_merge, .{ .x = @intCast(M) }, 256, &b);
+            }
+            var pj: cuda.Args = .{};
+            pj.add(dr.hn);
+            pj.add(dr.hproj);
+            pj.add(dr.g);
+            try o.go(dr.k.proj, .{ .x = @intCast(M), .y = RANK / 8 }, 256, &pj);
+        }
+
+        /// Kept rows into each context (`runs`), then every request's block: its drafts into `out`, chance by chance.
+        pub fn draft(o: Self, runs: []const Run, reqs: []const Req) !void {
+            const dr = o.dr;
+            const timed = dr.timing;
+            var t0: i96 = 0;
+            if (timed) {
+                try o.e.stream.synchronize();
+                t0 = std.Io.Clock.awake.now(o.e.io).toNanoseconds();
+            }
+            try o.ingest(runs);
+            var t1 = t0;
+            if (timed) {
+                try o.e.stream.synchronize();
+                t1 = std.Io.Clock.awake.now(o.e.io).toNanoseconds();
+            }
+            var at: usize = 0;
+            while (at < reqs.len) : (at += MAX_S) try o.block(reqs[at..@min(reqs.len, at + MAX_S)]);
+            if (timed and reqs.len > 0) {
+                const t2 = std.Io.Clock.awake.now(o.e.io).toNanoseconds();
+                dr.phase_ms[0] += @as(f64, @floatFromInt(t1 - t0)) / 1e6;
+                dr.phase_ms[1] += @as(f64, @floatFromInt(t2 - t1)) / 1e6;
+                dr.phase_ms[2] += @as(f64, @floatFromInt(reqs.len));
+                dr.timed_calls += 1;
+                if (dr.timed_calls % 64 == 0) {
+                    const k: f64 = 64;
+                    std.log.info("dflash2 a round: ingest {d:.2} ms, block pass and selection {d:.2} ms, {d:.1} streams", .{ dr.phase_ms[0] / k, dr.phase_ms[1] / k, dr.phase_ms[2] / k });
+                    dr.phase_ms = @splat(0);
+                }
+            }
+        }
+
+        fn block(o: Self, reqs: []const Req) !void {
+            const dr = o.dr;
+            const S = reqs.len;
+            for (reqs, 0..) |q, i| {
+                dr.h_rings[i] = q.lane.ring.ptr;
+                dr.h_starts[i] = q.start;
+                dr.h_froms[i] = q.lane.from;
+                for (0..BLOCK) |t| {
+                    dr.h_ids[i * BLOCK + t] = @intCast(if (t == 0) q.anchor else MASK);
+                    dr.h_bpos[i * BLOCK + t] = @intCast(q.start + @as(i64, @intCast(t)));
+                }
+            }
+            const M = S * BLOCK;
+            try o.upload(dr.ids_d, std.mem.sliceAsBytes(dr.h_ids[0..M]));
+            try o.upload(dr.bpos, std.mem.sliceAsBytes(dr.h_bpos[0..M]));
+            try o.upload(dr.rings, std.mem.sliceAsBytes(dr.h_rings[0..S]));
+            try o.upload(dr.starts, std.mem.sliceAsBytes(dr.h_starts[0..S]));
+            try o.upload(dr.froms, std.mem.sliceAsBytes(dr.h_froms[0..S]));
+            try o.pass(S);
+            try o.e.stream.synchronize();
+            const d = o.e.driver;
+            try cuda.memory.download(d, dr.gtk, std.mem.sliceAsBytes(dr.cand[0 .. M * CW]));
+            try cuda.memory.download(d, dr.g, std.mem.sliceAsBytes(dr.gh[0 .. M * RANK]));
+            for (reqs, 0..) |q, i| select.select(dr, i, q);
+        }
+    };
+}
+
+test "dflash2: a context restarts where its rows leave a gap" {
+    var l: LaneState = .{ .ring = undefined, .taps = undefined };
+    l.took(0, 40);
+    try std.testing.expectEqual(@as(i64, 0), l.from);
+    l.took(40, 3);
+    try std.testing.expectEqual(@as(i64, 0), l.from);
+    try std.testing.expectEqual(@as(i64, 43), l.end);
+    l.took(50, 2); // rows 43..49 never arrived
+    try std.testing.expectEqual(@as(i64, 50), l.from);
+    try std.testing.expectEqual(@as(i64, 52), l.end);
+}
