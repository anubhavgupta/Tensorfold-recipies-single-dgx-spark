+//! The DFlash2 checkpoint onto the device: its bf16 tensors read from model.safetensors, the linears quantized to 4 bits
+//! (affine, group 32, as the engine's lane reads them; they only propose), scratch carved from one buffer.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const wt = @import("cuda_prompt_wt.zig");
+const prompt = @import("cuda_prompt.zig");
+const mtp = @import("cuda_mtp.zig");
+const taps_mod = @import("cuda_dflash_taps.zig");
+const df = @import("cuda_dflash.zig");
+
+const Q4 = wt.Q4;
+const D = df.D;
+
+const Ent = struct { off: u64, n: u64 };
+
+/// Whether `dir`'s config.json declares a DFlash2 drafter (an architecture named DFlash2 and a dflash_config).
+pub fn declares(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) bool {
+    const path = std.fs.path.join(gpa, &.{ dir, "config.json" }) catch return false;
+    defer gpa.free(path);
+    const text = std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 20)) catch return false;
+    defer gpa.free(text);
+    const p = std.json.parseFromSlice(std.json.Value, gpa, text, .{}) catch return false;
+    defer p.deinit();
+    if (p.value != .object) return false;
+    const o = p.value.object;
+    if (o.get("dflash_config") == null) return false;
+    const arch = o.get("architectures") orelse return false;
+    if (arch != .array) return false;
+    for (arch.array.items) |a| if (a == .string and std.mem.indexOf(u8, a.string, "DFlash2") != null) return true;
+    return false;
+}
+
+fn number(v: ?std.json.Value) ?f64 {
+    const x = v orelse return null;
+    return switch (x) {
+        .integer => |i| @floatFromInt(i),
+        .float => |f| f,
+        else => null,
+    };
+}
+
+/// config.json's geometry against the constants the kernels are built for.
+pub fn checkConfig(gpa: std.mem.Allocator, io: std.Io, dir: []const u8) !void {
+    const path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+    defer gpa.free(path);
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 20));
+    defer gpa.free(text);
+    const p = try std.json.parseFromSlice(std.json.Value, gpa, text, .{});
+    defer p.deinit();
+    if (p.value != .object) return error.DrafterConfigUnexpected;
+    const o = p.value.object;
+    const dc = (o.get("dflash_config") orelse return error.NotDFlash2).object;
+    const rope = (o.get("rope_parameters") orelse return error.DrafterConfigUnexpected).object;
+    const want = [_]struct { v: ?f64, n: f64 }{
+        .{ .v = number(o.get("hidden_size")), .n = D },
+        .{ .v = number(o.get("num_hidden_layers")), .n = df.LAYERS },
+        .{ .v = number(o.get("num_attention_heads")), .n = df.QH },
+        .{ .v = number(o.get("num_key_value_heads")), .n = df.KVH },
+        .{ .v = number(o.get("head_dim")), .n = df.HD },
+        .{ .v = number(o.get("intermediate_size")), .n = df.FF },
+        .{ .v = number(o.get("vocab_size")), .n = df.VOCAB },
+        .{ .v = number(o.get("sliding_window")), .n = df.WIN },
+        .{ .v = number(rope.get("rope_theta")), .n = df.THETA },
+        .{ .v = number(dc.get("block_size")), .n = df.BLOCK },
+        .{ .v = number(dc.get("mask_token_id")), .n = df.MASK },
+        .{ .v = number(dc.get("selector_top_k")), .n = df.TOPK },
+        .{ .v = number(dc.get("selector_rank")), .n = df.RANK },
+        .{ .v = number(dc.get("conv_kernel_size")), .n = 2 },
+        .{ .v = number(dc.get("conv_group_size")), .n = 16 },
+    };
+    for (want) |w| if (w.v == null or w.v.? != w.n) return error.DrafterConfigUnexpected;
+    const eps = number(o.get("rms_norm_eps")) orelse return error.DrafterConfigUnexpected;
+    if (@abs(eps - df.EPS) > 1e-9) return error.DrafterConfigUnexpected;
+    const taps = (dc.get("target_layer_ids") orelse return error.DrafterConfigUnexpected).array.items;
+    if (taps.len != taps_mod.layers.len) return error.DrafterConfigUnexpected;
+    for (taps, taps_mod.layers) |t, l| if (t != .integer or t.integer != l) return error.DrafterConfigUnexpected;
+}
+
+fn bf16(x: u16) f32 {
+    return @bitCast(@as(u32, x) << 16);
+}
+
+fn toBf16(x: f32) u16 {
+    const b: u32 = @bitCast(x);
+    return @intCast((b +% 0x7FFF +% ((b >> 16) & 1)) >> 16);
+}
+
+/// A linear's 4-bit planes as MLX stores them: u32 words [n][k / 8], bf16 scales and biases [n][k / 32].
+const Planes = struct {
+    n: usize,
+    k: usize,
+    words: []u32,
+    scales: []u16,
+    biases: []u16,
+
+    fn alloc(gpa: std.mem.Allocator, n: usize, k: usize) !Planes {
+        const words = try gpa.alloc(u32, n * k / 8);
+        errdefer gpa.free(words);
+        const scales = try gpa.alloc(u16, n * k / 32);
+        errdefer gpa.free(scales);
+        return .{ .n = n, .k = k, .words = words, .scales = scales, .biases = try gpa.alloc(u16, n * k / 32) };
+    }
+
+    fn free(p: Planes, gpa: std.mem.Allocator) void {
+        gpa.free(p.words);
+        gpa.free(p.scales);
+        gpa.free(p.biases);
+    }
+};
+
+const QuantJob = struct { src: []const u16, pl: Planes, row0: usize, r0: usize, r1: usize };
+
+/// Rows r0..r1 of `src` ([rows][k] bf16) into planes' rows from row0 on: each group of 32 by its min and max.
+fn quantRows(j: QuantJob) void {
+    const k = j.pl.k;
+    for (j.r0..j.r1) |r| {
+        const o = j.row0 + r;
+        for (0..k / 32) |g| {
+            const v = j.src[r * k + g * 32 ..][0..32];
+            var lo: f32 = std.math.inf(f32);
+            var hi: f32 = -std.math.inf(f32);
+            for (v) |b| {
+                const x = bf16(b);
+                lo = @min(lo, x);
+                hi = @max(hi, x);
+            }
+            const sb = toBf16(if (hi > lo) (hi - lo) / 15.0 else 1.0);
+            const bb = toBf16(lo);
+            const s = bf16(sb);
+            const bias = bf16(bb);
+            j.pl.scales[o * (k / 32) + g] = sb;
+            j.pl.biases[o * (k / 32) + g] = bb;
+            var word: u32 = 0;
+            for (v, 0..) |b, i| {
+                const q = std.math.clamp(@round((bf16(b) - bias) / s), 0, 15);
+                word |= @as(u32, @intFromFloat(q)) << @intCast(4 * (i % 8));
+                if (i % 8 == 7) {
+                    j.pl.words[o * (k / 8) + g * 4 + i / 8] = word;
+                    word = 0;
+                }
+            }
+        }
+    }
+}
+
+/// `rows` rows of `src` quantized into `pl` from its row `row0`, over the machine's threads.
+fn quantize(src: []const u16, pl: Planes, row0: usize, rows: usize) !void {
+    const threads = @max(1, @min(16, std.Thread.getCpuCount() catch 1));
+    const each = (rows + threads - 1) / threads;
+    var ts: [16]std.Thread = undefined;
+    var started: usize = 0;
+    var r: usize = 0;
+    while (r < rows) {
+        const r1 = @min(rows, r + each);
+        const job: QuantJob = .{ .src = src, .pl = pl, .row0 = row0, .r0 = r, .r1 = r1 };
+        if (r1 == rows) {
+            quantRows(job);
+        } else {
+            ts[started] = try std.Thread.spawn(.{}, quantRows, .{job});
+            started += 1;
+        }
+        r = r1;
+    }
+    for (ts[0..started]) |t| t.join();
+}
+
+const Reader = struct {
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    file: std.Io.File,
+    ents: *const std.StringHashMap(Ent),
+
+    fn read(r: *Reader, name: []const u8, comptime T: type, count: usize) ![]T {
+        const e = r.ents.get(name) orelse {
+            std.log.err("dflash2: no {s} in the drafter's checkpoint", .{name});
+            return error.DrafterTensorMissing;
+        };
+        if (e.n != count * @sizeOf(T)) {
+            std.log.err("dflash2: {s} holds {d} bytes, not {d}", .{ name, e.n, count * @sizeOf(T) });
+            return error.DrafterTensorShape;
+        }
+        const out = try r.gpa.alloc(T, count);
+        errdefer r.gpa.free(out);
+        if (try r.file.readPositionalAll(r.io, std.mem.sliceAsBytes(out), e.off) != e.n) return error.BadDrafterHeader;
+        return out;
+    }
+
+    /// `names`' rows ([rows[i]][k] each) stacked and quantized.
+    fn stack(r: *Reader, names: []const []const u8, rows: []const usize, k: usize) !Planes {
+        var n: usize = 0;
+        for (rows) |x| n += x;
+        const pl = try Planes.alloc(r.gpa, n, k);
+        errdefer pl.free(r.gpa);
+        var at: usize = 0;
+        for (names, rows) |name, x| {
+            const src = try r.read(name, u16, x * k);
+            defer r.gpa.free(src);
+            try quantize(src, pl, at, x);
+            at += x;
+        }
+        return pl;
+    }
+};
+
+fn upload(gpa: std.mem.Allocator, d: *cuda.Driver, pl: Planes, row0: usize, rows: usize) !Q4 {
+    const k8 = pl.k / 8;
+    const k32 = pl.k / 32;
+    return wt.uploadQ4(gpa, d, std.mem.sliceAsBytes(pl.words[row0 * k8 ..][0 .. rows * k8]), std.mem.sliceAsBytes(pl.scales[row0 * k32 ..][0 .. rows * k32]), std.mem.sliceAsBytes(pl.biases[row0 * k32 ..][0 .. rows * k32]), rows, k8);
+}
+
+fn addEntries(arena: std.mem.Allocator, json: []const u8, data_len: u64, ents: *std.StringHashMap(Ent)) !void {
+    const names = try core.safetensors.parseHeader(arena, json, std.math.cast(usize, data_len) orelse return error.BadDrafterHeader);
+    for (names.keys(), names.values()) |name, e| {
+        if (e.dtype != .bf16) return error.DrafterNotBf16;
+        try ents.put(name, .{ .off = 8 + json.len + e.begin, .n = e.end - e.begin });
+    }
+}
+
+fn layerName(b: *[96]u8, li: usize, s: []const u8) ![]const u8 {
+    return std.fmt.bufPrint(b, "layers.{d}.{s}", .{ li, s });
+}
+
+const Small = struct {
+    dr: *df.Drafter,
+
+    /// A tensor as stored (bf16), on the device.
+    fn bf(s: Small, r: *Reader, name: []const u8, count: usize) !u64 {
+        const t = try r.read(name, u16, count);
+        defer r.gpa.free(t);
+        return s.put(std.mem.sliceAsBytes(t));
+    }
+
+    /// A norm weight widened to fp32 (the engine's norms read fp32).
+    fn f32w(s: Small, r: *Reader, name: []const u8, count: usize) !u64 {
+        const t = try r.read(name, u16, count);
+        defer r.gpa.free(t);
+        const w = try r.gpa.alloc(f32, count);
+        defer r.gpa.free(w);
+        for (w, t) |*o, x| o.* = bf16(x);
+        return s.put(std.mem.sliceAsBytes(w));
+    }
+
+    fn put(s: Small, bytes: []const u8) !u64 {
+        var b = try cuda.DeviceBuffer.fromHost(s.dr.d, bytes);
+        errdefer b.free();
+        try s.dr.bufs.append(s.dr.gpa, b);
+        return b.ptr;
+    }
+};
+
+/// The drafter from `dir` (config.json and model.safetensors, bf16) on engine `e`, drafting over `head`'s vocabulary.
+pub fn load(gpa: std.mem.Allocator, io: std.Io, e: *prompt.Engine, head: *mtp.Head, dir: []const u8) !*df.Drafter {
+    try checkConfig(gpa, io, dir);
+    const path = try std.fs.path.join(gpa, &.{ dir, "model.safetensors" });
+    defer gpa.free(path);
+    const file = try std.Io.Dir.cwd().openFile(io, path, .{});
+    defer file.close(io);
+    const size = try file.length(io);
+    var lenb: [8]u8 = undefined;
+    if (size < 8 or try file.readPositionalAll(io, &lenb, 0) != 8) return error.BadDrafterHeader;
+    const hlen = core.safetensors.headerSize(std.mem.readInt(u64, &lenb, .little), size) catch return error.BadDrafterHeader;
+    if (hlen > 1 << 20) return error.BadDrafterHeader;
+    var names: std.heap.ArenaAllocator = .init(gpa);
+    defer names.deinit();
+    const text = try names.allocator().alloc(u8, hlen);
+    if (try file.readPositionalAll(io, text, 8) != hlen) return error.BadDrafterHeader;
+    var ents = std.StringHashMap(Ent).init(gpa);
+    defer ents.deinit();
+    try addEntries(names.allocator(), text, size - 8 - hlen, &ents);
+    var r: Reader = .{ .gpa = gpa, .io = io, .file = file, .ents = &ents };
+
+    const d = e.driver;
+    var module = try cuda.Module.load(d, cuda.kernels.flashnext_dflash);
+    errdefer module.unload();
+    const dr = try gpa.create(df.Drafter);
+    errdefer gpa.destroy(dr);
+    dr.* = .{ .gpa = gpa, .d = d, .module = module, .k = try df.Kernels.load(module), .ids = head.ids, .head = head.draft, .depth = try df.drafts(), .confidence = try df.confidence(), .copies = try df.copies(), .timing = try @import("sys").environment.read(bool, "TF_FLASHNEXT_DFLASH_TIMING", false) };
+    const small: Small = .{ .dr = dr };
+    var nb: [4][96]u8 = undefined;
+    for (&dr.layers, 0..) |*lw, i| {
+        lw.in_norm = try small.f32w(&r, try layerName(&nb[0], i, "input_layernorm.weight"), D);
+        lw.post_norm = try small.f32w(&r, try layerName(&nb[0], i, "post_attention_layernorm.weight"), D);
+        lw.qn = try small.bf(&r, try layerName(&nb[0], i, "self_attn.q_norm.weight"), df.HD);
+        lw.kn = try small.bf(&r, try layerName(&nb[0], i, "self_attn.k_norm.weight"), df.HD);
+        lw.a_base = try small.bf(&r, try layerName(&nb[0], i, "attention_conv.base_kernel"), 4 * D);
+        lw.m_base = try small.bf(&r, try layerName(&nb[0], i, "mlp_conv.base_kernel"), 4 * D);
+        const q = try layerName(&nb[1], i, "self_attn.q_proj.weight");
+        const kq = try layerName(&nb[2], i, "self_attn.k_proj.weight");
+        const v = try layerName(&nb[3], i, "self_attn.v_proj.weight");
+        {
+            const pl = try r.stack(&.{ q, kq, v }, &.{ df.QW, df.KVW, df.KVW }, D);
+            defer pl.free(gpa);
+            lw.qkv = try upload(gpa, d, pl, 0, df.QKV);
+            lw.kv = try upload(gpa, d, pl, df.QW, 2 * df.KVW); // k and v again, as the context rows take them
+        }
+        lw.o = try linear(&r, d, &.{try layerName(&nb[1], i, "self_attn.o_proj.weight")}, &.{D}, df.QW);
+        const gate = try layerName(&nb[1], i, "mlp.gate_proj.weight");
+        const up = try layerName(&nb[2], i, "mlp.up_proj.weight");
+        lw.gu = try linear(&r, d, &.{ gate, up }, &.{ df.FF, df.FF }, D);
+        lw.down = try linear(&r, d, &.{try layerName(&nb[3], i, "mlp.down_proj.weight")}, &.{D}, df.FF);
+        lw.a_proj = try linear(&r, d, &.{try layerName(&nb[1], i, "attention_conv.kernel_projection.weight")}, &.{df.DYN}, D);
+        lw.m_proj = try linear(&r, d, &.{try layerName(&nb[1], i, "mlp_conv.kernel_projection.weight")}, &.{df.DYN}, D);
+    }
+    dr.fc = try linear(&r, d, &.{"fc.weight"}, &.{D}, taps_mod.layers.len * D);
+    dr.hproj = try small.bf(&r, "candidate_selector.hidden_projection.weight", df.RANK * D);
+    dr.hnorm = try small.f32w(&r, "hidden_norm.weight", D);
+    dr.norm = try small.f32w(&r, "norm.weight", D);
+    dr.pred = try r.read("candidate_selector.predecessor_codebook", u16, df.VOCAB * df.RANK);
+    dr.succ = try r.read("candidate_selector.successor_codebook", u16, df.VOCAB * df.RANK);
+    dr.h_cpos = try gpa.alloc(i64, df.MAX_CTX);
+    dr.h_crings = try gpa.alloc(u64, df.MAX_CTX);
+    dr.cand = try gpa.alloc(i32, df.MAX_M * df.CW);
+    dr.gh = try gpa.alloc(f32, df.MAX_M * df.RANK);
+    try carve(dr, head.draft.n);
+    e.batch_k.df_tap = dr.k.tap;
+    std.log.info("dflash2: drafter from {s} (Apache-2.0), linears at 4 bits, {d:.2} GiB on the device, up to {d} drafts a round, chains stop under {d:.2}, copies {s}", .{ dir, @as(f64, @floatFromInt(dr.nbytes())) / (1 << 30), dr.depth, dr.confidence, if (dr.copies) "on" else "off" });
+    return dr;
+}
+
+/// `names` stacked, quantized and uploaded as one 4-bit linear of [sum of rows][k].
+fn linear(r: *Reader, d: *cuda.Driver, names: []const []const u8, rows: []const usize, k: usize) !Q4 {
+    const pl = try r.stack(names, rows, k);
+    defer pl.free(r.gpa);
+    return upload(r.gpa, d, pl, 0, pl.n);
+}
+
+/// The drafter's scratch, every field one carved piece of one buffer.
+fn carve(dr: *df.Drafter, head_n: usize) !void {
+    const M: u64 = df.MAX_M;
+    const C: u64 = df.MAX_CTX;
+    const chunks: u64 = (head_n + df.head_cols - 1) / df.head_cols;
+    const xs_row: u64 = @max(@max(df.FF, df.QW), taps_mod.layers.len * D) / 32;
+    const fields = .{
+        .{ "x", M * D * 2 },                      .{ "y", M * D * 2 },                    .{ "y2", M * D * 2 },                   .{ "dyn", M * df.DYN * 2 },
+        .{ "qkv", M * df.QKV * 2 },               .{ "q", M * df.QW * 2 },                .{ "kb", M * df.KVW * 2 },              .{ "vb", M * df.KVW * 2 },
+        .{ "att", M * df.QW * 2 },                .{ "a", M * D * 2 },                    .{ "gu", M * 2 * df.FF * 2 },           .{ "act", M * df.FF * 2 },
+        .{ "hn", M * D * 2 },                     .{ "xs", @max(M, C) * xs_row * 4 },     .{ "g", M * df.RANK * 4 },              .{ "logits", M * head_n * 2 },
+        .{ "cin", C * df.TAP_ROW },               .{ "c1", C * D * 2 },                   .{ "ctx", C * D * 2 },                  .{ "ckv", C * 2 * df.KVW * 2 },
+        .{ "ids_d", M * 4 },                      .{ "bpos", M * 4 },                     .{ "rings", df.MAX_S * 8 },             .{ "starts", df.MAX_S * 8 },
+        .{ "froms", df.MAX_S * 8 },               .{ "cpos", C * 8 },                     .{ "crings", C * 8 },                   .{ "gtk", M * df.CW * 4 },
+        .{ "pv", M * chunks * df.TOPK * 4 },      .{ "pi", M * chunks * df.TOPK * 4 },    .{ "pm", M * df.QH * df.CH * 4 },       .{ "pl", M * df.QH * df.CH * 4 },
+        .{ "pacc", M * df.QH * df.CH * df.HD * 4 },
+    };
+    var at: u64 = 0;
+    inline for (fields) |f| {
+        @field(dr, f[0]) = at;
+        at += std.mem.alignForward(u64, f[1], 256);
+    }
+    dr.scratch = try cuda.DeviceBuffer.alloc(dr.d, at);
+    errdefer dr.scratch.free();
+    inline for (fields) |f| @field(dr, f[0]) += dr.scratch.ptr;
+    try dr.d.check(dr.d.api.cuMemsetD8_v2(dr.scratch.ptr, 0, at), "cuMemsetD8");
+}
+
+/// Device bytes the drafter takes before it is loaded (the startup estimate): 4-bit weights with their scales and
+/// biases, the selector's projection, and the scratch of an ingest and of a block pass over `head_n` draft columns.
+pub fn estimateBytes(head_n: usize) u64 {
+    const per_layer: u64 = df.QKV * D + 2 * df.KVW * D + D * df.QW + 3 * D * df.FF + 2 * df.DYN * D;
+    const weights: u64 = (df.LAYERS * per_layer + D * taps_mod.layers.len * D) * 5 / 8;
+    const ingest: u64 = df.MAX_CTX * (taps_mod.row_bytes + 2 * D * 2 + 2 * df.KVW * 2 + taps_mod.layers.len * D / 8);
+    const block: u64 = df.MAX_M * (head_n * 2 + df.QH * df.CH * df.HD * 4 + 4 * df.FF * 2 + 8 * D * 2);
+    return weights + ingest + block + df.RANK * D * 2;
+}
+
+test "dflash2: 4-bit planes dequantize within half a step of each weight" {
+    const gpa = std.testing.allocator;
+    const n = 3;
+    const k = 64;
+    var src: [n * k]u16 = undefined;
+    var x: u32 = 12345;
+    for (&src, 0..) |*v, i| {
+        x = x *% 1664525 +% 1013904223;
+        const f: f32 = (@as(f32, @floatFromInt(x >> 8)) / 16777216.0 - 0.5) * (if (i < k) @as(f32, 0.1) else 4.0);
+        v.* = toBf16(f);
+    }
+    const pl = try Planes.alloc(gpa, n, k);
+    defer pl.free(gpa);
+    try quantize(&src, pl, 0, n);
+    for (0..n) |r| for (0..k) |c| {
+        const g = r * (k / 32) + c / 32;
+        const word = pl.words[r * (k / 8) + c / 8];
+        const q: f32 = @floatFromInt((word >> @intCast(4 * (c % 8))) & 15);
+        const got = q * bf16(pl.scales[g]) + bf16(pl.biases[g]);
+        try std.testing.expect(@abs(got - bf16(src[r * k + c])) <= 0.5 * bf16(pl.scales[g]) * 1.01 + 1e-6);
+    };
+}
+
+test "dflash2: a drafter checkpoint's geometry is checked against the kernels' constants" {
+    const gpa = std.testing.allocator;
+    try std.testing.expect(!declares(gpa, std.testing.io, "/no/such/folder"));
+}
diff --git a/zig/src/families/flashnext/cuda_dflash_select.zig b/zig/src/families/flashnext/cuda_dflash_select.zig
new file mode 100644
index 0000000..fb266da
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_dflash_select.zig
@@ -0,0 +1,112 @@
+//! DFlash2's path selector on the host: each draft among a row's 16 likeliest by the previous draft's codebook row.
+const std = @import("std");
+const lanes = @import("lanes");
+const mtp = @import("cuda_mtp.zig");
+const df = @import("cuda_dflash.zig");
+const CW = df.CW;
+const RANK = df.RANK;
+const TOPK = df.TOPK;
+
+const Cand = struct { v: f32, id: u32 };
+
+fn bf(x: u16) f32 {
+    return @bitCast(@as(u32, x) << 16);
+}
+
+/// Stream `i`'s drafts (the block's rows 1..): each row's best of its 16 by logit plus codebook score; a sampled stream's
+/// pick is the target's own keyed draw over those 16 scores at the draft's position, which lands when the target's
+/// distribution looks like the drafter's. Each pick's chance goes to `out.probs`, and a chain stops where the product
+/// of its chances falls under the drafter's confidence (the first draft always stays).
+pub fn select(dr: *const df.Drafter, i: usize, q: df.Req) void {
+    const out = q.out;
+    out.n = 0;
+    var prev: usize = q.anchor;
+    var chain: f64 = 1;
+    for (1..@min(df.BLOCK, q.depth + 1)) |t| {
+        const r = i * df.BLOCK + t;
+        const blk = dr.cand[r * CW ..][0..CW];
+        var c: [TOPK]Cand = undefined;
+        var n: usize = 0;
+        for (0..TOPK) |j| {
+            if (blk[j] < 0) continue;
+            c[n] = .{ .v = @bitCast(blk[TOPK + j]), .id = dr.ids[@intCast(blk[j])] };
+            n += 1;
+        }
+        if (n == 0) return;
+        const g = dr.gh[r * RANK ..][0..RANK];
+        const P = dr.pred[prev * RANK ..][0..RANK];
+        var pg: [RANK]f32 = undefined;
+        for (&pg, P, g) |*o, p, x| o.* = bf(p) * x;
+        var sc: [TOPK]f32 = undefined;
+        var best: usize = 0;
+        for (0..n) |m| {
+            const S = dr.succ[@as(usize, c[m].id) * RANK ..][0..RANK];
+            var dot: f32 = 0;
+            for (pg, S) |a, b| dot += a * bf(b);
+            sc[m] = c[m].v + dot;
+            if (sc[m] > sc[best]) best = m;
+        }
+        var z: f64 = 0;
+        for (sc[0..n]) |x| z += @exp(@as(f64, x - sc[best]));
+        var pick = best;
+        if (q.sampling) |sm| if (mtp.isSampled(sm)) {
+            var vals: [TOPK]f64 = undefined;
+            var keys: [TOPK]u64 = undefined;
+            for (0..n) |m| {
+                vals[m] = sc[m];
+                keys[m] = c[m].id;
+            }
+            if (lanes.sampling.choose(dr.gpa, vals[0..n], keys[0..n], q.position + (t - 1), sm)) |id| {
+                for (0..n) |m| if (c[m].id == id) {
+                    pick = m;
+                };
+            } else |_| {}
+        };
+        const p = @exp(@as(f64, sc[pick] - sc[best])) / z;
+        chain *= p;
+        if (t > 1 and chain < dr.confidence) return;
+        out.tokens[t - 1] = c[pick].id;
+        out.probs[t - 1] = p;
+        out.n += 1;
+        prev = c[pick].id;
+    }
+}
+
+test "dflash2: the selector follows the codebooks and a chain stops under the confidence" {
+    const gpa = std.testing.allocator;
+    var dr: df.Drafter = .{ .gpa = gpa, .d = undefined, .module = undefined, .k = undefined };
+    dr.confidence = 0.5;
+    const vocab = 8;
+    dr.ids = &.{ 2, 5, 7 };
+    dr.pred = try gpa.alloc(u16, vocab * RANK);
+    defer gpa.free(dr.pred);
+    dr.succ = try gpa.alloc(u16, vocab * RANK);
+    defer gpa.free(dr.succ);
+    @memset(dr.pred, 0x3f80); // bf16 1.0
+    @memset(dr.succ, 0);
+    dr.cand = try gpa.alloc(i32, df.MAX_M * CW);
+    defer gpa.free(dr.cand);
+    dr.gh = try gpa.alloc(f32, df.MAX_M * RANK);
+    defer gpa.free(dr.gh);
+    @memset(dr.gh, 0);
+    // row 1: columns 0, 1, 2 (tokens 2, 5, 7) at logits 3, 1, 0; row 2: three equal logits, so a chance of a third
+    @memset(dr.cand, -1);
+    const rows = [_][3]f32{ .{ 3, 1, 0 }, .{ 1, 1, 1 } };
+    for (rows, 1..) |vals, t| for (vals, 0..) |v, j| {
+        dr.cand[t * CW + j] = @intCast(j);
+        dr.cand[t * CW + TOPK + j] = @bitCast(v);
+    };
+    // token 5's successor row favors nothing, so the best logit stands: row 1 picks token 2
+    var chain: mtp.Chain = .{};
+    select(&dr, 0, .{ .lane = undefined, .anchor = 1, .start = 10, .depth = 2, .out = &chain });
+    try std.testing.expectEqual(@as(usize, 1), chain.n); // row 2's chance is 1/3 and the product falls under 0.5
+    try std.testing.expectEqual(@as(u32, 2), chain.tokens[0]);
+    try std.testing.expect(chain.probs[0] > 0.8 and chain.probs[0] < 0.9);
+    dr.confidence = 0.1;
+    select(&dr, 0, .{ .lane = undefined, .anchor = 1, .start = 10, .depth = 2, .out = &chain });
+    try std.testing.expectEqual(@as(usize, 2), chain.n);
+    // the first draft always stays, whatever its chance
+    dr.confidence = 0.99;
+    select(&dr, 0, .{ .lane = undefined, .anchor = 1, .start = 10, .depth = 2, .out = &chain });
+    try std.testing.expectEqual(@as(usize, 1), chain.n);
+}
diff --git a/zig/src/families/flashnext/cuda_dflash_taps.zig b/zig/src/families/flashnext/cuda_dflash_taps.zig
new file mode 100644
index 0000000..5f37d93
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_dflash_taps.zig
@@ -0,0 +1,77 @@
+//! DFlash2's taps on the batched pass: after each tapped decoder layer, the mean of its four hyper-connection streams.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+
+/// The target layers the drafter reads (incoai/Qwen3.8-Flash-Next-DFlash2's target_layer_ids), in tap-slot order.
+pub const layers = [_]usize{ 5, 15, 25, 35, 45 };
+/// Bytes of one row's taps: every tapped layer's mean, bf16.
+pub const row_bytes: usize = layers.len * wt.dims * 2;
+pub const max_jobs = 32;
+
+/// The tap kernel's runs (flashnext_dflash.cu's TapJobs): run j takes `rows[j]` rows from row `src0[j]` of the pass into `dst[j]`.
+pub const Jobs = extern struct {
+    n: c_int = 0,
+    slot: c_int = 0,
+    rows: [max_jobs]c_int = @splat(0),
+    src0: [max_jobs]c_int = @splat(0),
+    dst: [max_jobs]u64 = @splat(0),
+
+    pub fn add(j: *Jobs, src0: usize, rows: usize, dst: u64) !void {
+        if (rows == 0 or dst == 0) return;
+        if (j.n >= max_jobs) return error.TooManyTapRuns;
+        const i: usize = @intCast(j.n);
+        j.rows[i] = @intCast(rows);
+        j.src0[i] = @intCast(src0);
+        j.dst[i] = dst;
+        j.n += 1;
+    }
+
+    pub fn total(j: *const Jobs) usize {
+        var n: usize = 0;
+        for (j.rows[0..@intCast(j.n)]) |r| n += @intCast(r);
+        return n;
+    }
+};
+
+/// The tap slot read at the start of layer `layer` (the previous layer's output, once its write-back lands), or null.
+pub fn slotAt(layer: usize) ?usize {
+    if (layer == 0) return null;
+    for (layers, 0..) |l, i| if (l + 1 == layer) return i;
+    return null;
+}
+
+/// The launch: rows of `h` ([row][4][dims] bf16) into each run's destination, column block `slot`.
+pub fn launch(f: cuda.Function, stream: cuda.Stream, h: u64, jobs: Jobs, slot: usize) !void {
+    const n = jobs.total();
+    if (n == 0) return;
+    var j = jobs;
+    j.slot = @intCast(slot);
+    var a: cuda.Args = .{};
+    a.add(h);
+    a.add(j);
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(n), .y = @intCast((wt.dims + 1023) / 1024) }, .block = .{ .x = 256 } }, stream, &a);
+}
+
+comptime {
