index 0000000..ba3d9fd
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_exl3_moe.zig
@@ -0,0 +1,63 @@
+//! An EXL3 layer's routed experts and its shared expert (expert 512 of the same tables) on the grouped kernels.
+const std = @import("std");
+const cuda = @import("cuda");
+const wt = @import("cuda_prompt_wt.zig");
+const kit_mod = @import("cuda_exl3_kit.zig");
+
+const dims = wt.dims;
+const experts_n = wt.experts_n;
+const moe_w = wt.moe_w;
+
+/// Rows a grouped call takes: each call reads every picked expert's weights, so a prompt pass wants few of them,
+/// and the scratch grows with the pairs (the Python engine's 1,024-row windows).
+pub const window_rows: usize = 1024;
+
+/// Rows from which a call takes the 64-pair prompt items (below: the 16-pair decode items), as the NVFP4 path does.
+const prompt_rows: usize = 64;
+
+pub const Experts = struct {
+    layer: cuda.experts.Layer,
+    bufs: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    gpa: std.mem.Allocator,
+
+    pub fn free(self: *Experts) void {
+        for (self.bufs.items) |*b| b.free();
+        self.bufs.deinit(self.gpa);
+    }
+};
+
+/// Routed experts' and the shared one's picks for `n` rows (slots a row, the shared one last) through the grouped kernels:
+/// the routed and shared slot rows go to y [pairs, dims] fp32, the up activations to moe_act.
+pub fn run(self: anytype, kit: *kit_mod.Kit, x: *const Experts, n: usize, plan: cuda.grouped.Plan) !void {
+    const s = self.s;
+    const e = experts_n + 1;
+    var at: usize = 0;
+    while (at < n) : (at += window_rows) {
+        const rows = @min(window_rows, n - at);
+        const pairs = rows * s.slots;
+        const tile: usize = if (rows >= prompt_rows) 64 else 16;
+        const picks = s.picks + at * s.slots * 4;
+        try self.k.router.route(self.stream, picks, pairs, e, tile, plan);
+        const items = cuda.grouped.maxItems(pairs, e, tile);
+        const grp: cuda.experts.Grouped = .{ .exl3 = &kit.grouped };
+        const act = s.moe_act + at * s.slots * moe_w * 2;
+        const y = s.y + at * s.slots * dims * 4;
+        const mixed = s.mixed + at * dims * 2;
+        if (tile == 64) {
+            try grp.prompt(self.stream, .up, .{ .x = mixed, .stride = dims, .slots = s.slots }, x.layer, plan, act, items, pairs, tile, -1);
+            try grp.prompt(self.stream, .down_f32, .{ .x = act, .stride = moe_w }, x.layer, plan, y, items, pairs, tile, -1);
+        } else {
+            try grp.decode(self.stream, .up, .{ .x = mixed, .stride = dims, .slots = s.slots }, x.layer, plan, act, items, pairs, tile, -1);
+            try grp.decode(self.stream, .down_f32, .{ .x = act, .stride = moe_w }, x.layer, plan, y, items, pairs, tile, -1);
+        }
+    }
+}
+
+/// The scratch `Grouped` keeps for a call of `rows` rows: its largest of the up and down projections.
+pub fn storageBytes(rows: usize, slots: usize) !usize {
+    const pairs = @min(rows, window_rows) * slots;
+    const tile: usize = 64;
+    const up = try cuda.exl3_grouped.Grouped.bytes(dims, moe_w, pairs, tile, try cuda.exl3_experts.plan(dims, moe_w, true), 2);
+    const down = try cuda.exl3_grouped.Grouped.bytes(moe_w, dims, pairs, tile, try cuda.exl3_experts.plan(moe_w, dims, false), 1);
+    return @max(up, down);
+}
