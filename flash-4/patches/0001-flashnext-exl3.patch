+/// One EXL3 n-gram row (ExLlamaV3's ngram_dequant): an fp16 scale word, then out.len values of `bits` bits in a
+/// tail-biting mul1 trellis; value i is fp16(mul1(state_i)) * scale + bias[i] rounded once to bf16.
+pub fn decodeExl3Row(bits: usize, row: []const u8, bias: []const f16, out: []u16) void {
+    const dh = out.len;
+    const scale: f32 = @floatCast(@as(f16, @bitCast(std.mem.readInt(u16, row[0..2], .little))));
+    var v: [256]u16 = undefined;
+    for (0..dh) |j| {
+        var x: u16 = 0;
+        for (0..bits) |b| {
+            const s = j * bits + b;
+            const word = std.mem.readInt(u16, row[2 + 2 * (s >> 4) ..][0..2], .little);
+            x |= ((word >> @intCast(s & 15)) & 1) << @intCast(b);
+        }
+        v[j] = x;
+    }
+    for (0..dh) |i| {
+        var state: u32 = 0;
+        for (0..16) |m| {
+            const back = m / bits;
+            const pos = if (i >= back) i - back else i + dh - back;
+            state |= @as(u32, (v[pos] >> @intCast(m % bits)) & 1) << @intCast(m);
+        }
+        const prod = state *% 0x83DCD12D;
+        const hs: u32 = (prod & 255) + ((prod >> 8) & 255) + ((prod >> 16) & 255) + (prod >> 24);
+        const cb: f32 = @floatCast(@as(f16, @floatCast(@mulAdd(f32, @floatFromInt(1024 + hs), k_inv, k_bias))));
+        out[i] = toBf16(@mulAdd(f32, cb, scale, @floatCast(bias[i])));
+    }
+}
 
