diff --git a/zig/src/families/flashnext/cuda_exl3_group.zig b/zig/src/families/flashnext/cuda_exl3_group.zig
new file mode 100644
index 0000000..0eb1d6d
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_exl3_group.zig
@@ -0,0 +1,66 @@
+//! An EXL3 checkpoint's projection as the engine holds it: one or more parts side by side in the output columns
+//! (a stitched DeltaNet or attention input is EXL3 trellises for the big parts and a plain bf16 matrix for the rest).
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const max_parts = 4;
+/// Rows a stitched projection's parts go through at once: the temporary holds one part's block of rows.
+pub const block_rows: usize = 1024;
+/// The widest part of any stitched projection (the attention q|gate).
+pub const widest: usize = 12288;
+
+/// One output block of a projection: an EXL3 trellis weight, or a small plain bf16 matrix on the lane.
+pub const Part = struct {
+    kind: enum { trellis, plain },
+    w: cuda.exl3.Weight = undefined,
+    plain: cuda.qmmf.Weight = undefined,
+    /// The first output column this part writes, and how many columns it has.
+    col: usize,
+    n: usize,
+};
+
+/// The device buffers of a group (the trellises, scales and plain matrices), freed together with it.
+pub const Group = struct {
+    gpa: std.mem.Allocator,
+    parts: [max_parts]Part = undefined,
+    count: usize = 0,
+    n: usize,
+    k: usize,
+    bufs: std.ArrayList(cuda.DeviceBuffer) = .empty,
+
+    pub fn create(gpa: std.mem.Allocator, n: usize, k: usize) !*Group {
+        const g = try gpa.create(Group);
+        g.* = .{ .gpa = gpa, .n = n, .k = k };
+        return g;
+    }
+
+    pub fn destroy(g: *Group) void {
+        for (g.bufs.items) |*b| b.free();
+        g.bufs.deinit(g.gpa);
+        g.gpa.destroy(g);
+    }
+
+    /// `bytes` on the device, owned by the group.
+    pub fn put(g: *Group, d: *const cuda.Driver, bytes: []const u8) !u64 {
+        try g.bufs.ensureUnusedCapacity(g.gpa, 1);
+        const b = try cuda.DeviceBuffer.fromHost(d, bytes);
+        g.bufs.appendAssumeCapacity(b);
+        return b.ptr;
+    }
+
+    pub fn add(g: *Group, part: Part) !void {
+        if (g.count == max_parts) return error.UnexpectedTensor;
+        g.parts[g.count] = part;
+        g.count += 1;
+    }
+
+    /// Every output column is covered once, in order.
+    pub fn check(g: *const Group) !void {
+        var at: usize = 0;
+        for (g.parts[0..g.count]) |p| {
+            if (p.col != at) return error.UnexpectedTensor;
+            at += p.n;
+        }
+        if (at != g.n) return error.UnexpectedTensor;
+    }
+};
diff --git a/zig/src/families/flashnext/cuda_exl3_kit.zig b/zig/src/families/flashnext/cuda_exl3_kit.zig
new file mode 100644
index 0000000..471ec1b
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_exl3_kit.zig
@@ -0,0 +1,38 @@
+//! The EXL3 kernels beside the engine's own: dense rows, the grouped experts, and their shared scratch.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const Kit = struct {
+    gpa: std.mem.Allocator,
+    dense: cuda.exl3.Dense,
+    experts: cuda.exl3_experts.Experts,
+    grouped: cuda.exl3_grouped.Grouped,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver) !*Kit {
+        const k = try gpa.create(Kit);
+        errdefer gpa.destroy(k);
+        k.gpa = gpa;
+        k.dense = try cuda.exl3.Dense.load(d);
+        errdefer k.dense.unload();
+        k.experts = try cuda.exl3_experts.Experts.load(d);
+        errdefer k.experts.unload();
+        k.grouped = .{ .d = d, .kernels = &k.experts };
+        return k;
+    }
+
+    pub fn deinit(k: *Kit) void {
+        k.grouped.deinit();
+        k.experts.unload();
+        k.dense.unload();
+        k.gpa.destroy(k);
+    }
+
+    /// The grouped experts' scratch for `bytes`, allocated now: a graph capture later allocates nothing.
+    pub fn reserveExperts(k: *Kit, d: *const cuda.Driver, bytes: usize) !void {
+        if (k.grouped.storage) |*b| {
+            if (b.len >= bytes) return;
+            b.free();
+        }
+        k.grouped.storage = try cuda.DeviceBuffer.alloc(d, bytes);
+    }
+};
diff --git a/zig/src/families/flashnext/cuda_exl3_lane.zig b/zig/src/families/flashnext/cuda_exl3_lane.zig
new file mode 100644
index 0000000..4a34c0b
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_exl3_lane.zig
@@ -0,0 +1,46 @@
+//! Rows through an EXL3 projection into `out` (bf16) or `part` (fp32), each part of a stitched one into its columns.
+const std = @import("std");
+const cuda = @import("cuda");
+const grp = @import("cuda_exl3_group.zig");
+const ops = @import("cuda_batch_ops.zig");
+
+const block_rows = grp.block_rows;
+
+/// Rows from which the dense weights take the prompt path (the same bits as the decode path's).
+const prompt_rows: usize = 64;
+
+fn decodeRows(kit: anytype, stream: cuda.Stream, w: cuda.exl3.Weight, x: u64, m: usize, y: u64, dtype: cuda.exl3.DType) !void {
+    if (m >= prompt_rows) return kit.dense.prompt(stream, w, x, .bf16, m, y, dtype);
+    return kit.dense.decode(stream, w, x, .bf16, m, y, dtype);
+}
+
+/// The slices written to `part` (always 1: an EXL3 projection sums its own K), or the one bf16 block in `out`.
+pub fn run(self: anytype, g: *const grp.Group, x: u64, out: u64, part: u64, m: usize, sk: usize) !usize {
+    const kit = self.k.exl3 orelse return error.FormatNotLoaded;
+    const stream = self.stream;
+    if (g.count == 1 and g.parts[0].kind == .trellis) {
+        const w = g.parts[0].w;
+        if (sk == 1) {
+            try decodeRows(kit, stream, w, x, m, out, .bf16);
+        } else {
+            try decodeRows(kit, stream, w, x, m, part, .f32);
+        }
+        return 1;
+    }
+    if (sk != 1 or out == 0) return error.UnexpectedTensor;
+    const tmp = self.s.exl3_tmp;
+    if (tmp == 0) return error.UnexpectedTensor;
+    var r0: usize = 0;
+    while (r0 < m) : (r0 += block_rows) {
+        const rows = @min(block_rows, m - r0);
+        const xr = x + r0 * g.k * 2;
+        for (g.parts[0..g.count]) |p| {
+            switch (p.kind) {
+                .trellis => try decodeRows(kit, stream, p.w, xr, rows, tmp, .bf16),
+                .plain => try self.k.nativeMatmul(stream, xr, g.k, rows, p.plain, tmp, self.s.native_part, .bf16),
+            }
+            try ops.copyCols(self.k, stream, tmp, p.n, out + (r0 * g.n + p.col) * 2, g.n, p.n, rows);
+        }
+    }
+    return 1;
+}
diff --git a/zig/src/families/flashnext/cuda_exl3_load.zig b/zig/src/families/flashnext/cuda_exl3_load.zig
new file mode 100644
index 0000000..02c5d1d
--- /dev/null
+++ b/zig/src/families/flashnext/cuda_exl3_load.zig
@@ -0,0 +1,300 @@
+//! Loading an EXL3 pack (turboderp's Flash Next quantization): its trellis projections, the grouped experts with the
+//! shared expert as expert 512, and the plain f16 tensors the pack leaves unquantized, as the engine's types.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const wt = @import("cuda_prompt_wt.zig");
+const grp = @import("cuda_exl3_group.zig");
+const kit_mod = @import("cuda_exl3_kit.zig");
+const moe = @import("cuda_exl3_moe.zig");
+const projection = @import("cuda_projection.zig");
+
+const Tensor = core.safetensors.Tensor;
+const Store = wt.Store;
+const mul1_magic: u32 = 0x83DCD12D;
+const mcg_magic: u32 = 0xCBAC1FED;
+
+const dims = wt.dims;
+const experts_n = wt.experts_n;
+const moe_w = wt.moe_w;
+
+/// Whether the pack under `store` is EXL3: layer 0's input projection has a trellis.
+pub fn isExl3(store: *const Store) bool {
+    return store.has("language_model.model.layers.0.linear_attn.in_proj_qkv.trellis");
+}
+
+/// One EXL3 group's tensors, held mapped until the store releases them.
+const Info = struct { trellis: Tensor, suh: Tensor, svh: Tensor, halves: u32, codebook: cuda.exl3.Codebook, n: usize, k: usize };
+
+fn info(store: *Store, base: []const u8) !Info {
+    var buf: [256]u8 = undefined;
+    const t = try store.holdAhead(try std.fmt.bufPrint(&buf, "{s}.trellis", .{base}));
+    if (t.dtype != .i16 or t.rank != 3 or t.dim(2) % 8 != 0) return error.UnexpectedTensor;
+    const halves = t.dim(2) / 8;
+    if (halves < 2 or halves > 16) return error.UnsupportedQuantization;
+    const k = t.dim(0) * 16;
+    const n = t.dim(1) * 16;
+    if (k % 128 != 0 or n % 128 != 0 or t.bytes.len != t.numel() * 2) return error.UnexpectedTensor;
+    var codebook: cuda.exl3.Codebook = .inst3;
+    const mul1 = store.has(try std.fmt.bufPrint(&buf, "{s}.mul1", .{base}));
+    var mbuf: [256]u8 = undefined;
+    const mcg = store.has(try std.fmt.bufPrint(&mbuf, "{s}.mcg", .{base}));
+    if (mul1 == mcg) return error.UnsupportedQuantization;
+    const marker = try store.hold(try std.fmt.bufPrint(&buf, "{s}.{s}", .{ base, if (mul1) "mul1" else "mcg" }));
+    if (marker.bytes.len != 4 or std.mem.readInt(u32, marker.bytes[0..4], .little) != (if (mul1) mul1_magic else mcg_magic)) return error.UnsupportedQuantization;
+    codebook = if (mul1) .mul1 else .mcg;
+    if (codebook == .mcg and halves % 2 != 0) return error.UnsupportedQuantization;
+    const suh = try store.hold(try std.fmt.bufPrint(&buf, "{s}.suh", .{base}));
+    const svh = try store.hold(try std.fmt.bufPrint(&buf, "{s}.svh", .{base}));
+    if (!suh.is(.f16, &.{k}) or !svh.is(.f16, &.{n})) return error.UnexpectedTensor;
+    return .{ .trellis = t, .suh = suh, .svh = svh, .halves = @intCast(halves), .codebook = codebook, .n = n, .k = k };
+}
+
+/// The trellis part `base` of a group, uploaded as stored (the Dense kernels read the stored tile layout).
+fn trellisPart(d: *const cuda.Driver, g: *grp.Group, kit: *kit_mod.Kit, stream: cuda.Stream, store: *Store, base: []const u8, col: usize) !void {
+    const i = try info(store, base);
+    const st = cuda.exl3.strides(i.k, i.n, i.halves, false);
+    const w: cuda.exl3.Weight = .{
+        .trellis = try g.put(d, i.trellis.bytes),
+        .suh = try g.put(d, i.suh.bytes),
+        .svh = try g.put(d, i.svh.bytes),
+        .k = @intCast(i.k),
+        .n = @intCast(i.n),
+        .halves = i.halves,
+        .codebook = i.codebook,
+        .stride_k = st.k,
+        .stride_nb = st.nb,
+    };
+    if (cuda.exl3.variantIndex(w.halves, w.codebook, cuda.exl3.planOf(w).wk) == null) return error.UnsupportedQuantization;
+    try kit.dense.reserve(stream, w);
+    try g.add(.{ .kind = .trellis, .w = w, .col = col, .n = i.n });
+}
+
+/// bf16 rows of a bf16 or f16 tensor.
+pub fn bf16Rows(gpa: std.mem.Allocator, t: Tensor) ![]u16 {
+    const out = try gpa.alloc(u16, t.bytes.len / 2);
+    errdefer gpa.free(out);
+    switch (t.dtype) {
+        .bf16 => for (out, 0..) |*o, i| {
+            o.* = std.mem.readInt(u16, t.bytes[2 * i ..][0..2], .little);
+        },
+        .f16 => for (out, 0..) |*o, i| {
+            const h: f16 = @bitCast(std.mem.readInt(u16, t.bytes[2 * i ..][0..2], .little));
+            o.* = core.bf16_round.bits(@floatCast(h));
+        },
+        else => return error.UnexpectedTensor,
+    }
+    return out;
+}
+
+/// The plain matrices `bases` (f16 or bf16 [n_i, k] each) stacked into one bf16 part on the lane.
+fn plainPart(gpa: std.mem.Allocator, d: *const cuda.Driver, g: *grp.Group, store: *Store, bases: []const []const u8, k: usize, col: usize) !void {
+    var rows: usize = 0;
+    var data: std.ArrayList(u16) = .empty;
+    defer data.deinit(gpa);
+    var buf: [256]u8 = undefined;
+    for (bases) |base| {
+        const t = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.weight", .{base}));
+        if (t.rank != 2 or t.dim(1) != k or t.bytes.len != t.dim(0) * k * 2) return error.UnexpectedTensor;
+        const r = try bf16Rows(gpa, t);
+        defer gpa.free(r);
+        try data.appendSlice(gpa, r);
+        rows += t.dim(0);
+    }
+    var p = try projection.dense(gpa, d, .{ .dtype = .bf16, .rank = 2, .shape = .{ rows, k, 1, 1, 1 }, .bytes = std.mem.sliceAsBytes(data.items) });
+    errdefer p.free();
+    try g.bufs.ensureUnusedCapacity(g.gpa, 1);
+    g.bufs.appendAssumeCapacity(p.w);
+    try g.add(.{ .kind = .plain, .plain = p.native.?, .col = col, .n = rows });
+}
+
+/// A projection made of parts side by side: `prefix` joined with each name; n columns in all, k inputs. A name with a
+/// trellis is an EXL3 part; the others (f16 or bf16 matrices) are stacked into one plain part after them.
+pub fn stitched(gpa: std.mem.Allocator, d: *const cuda.Driver, store: *Store, kit: *kit_mod.Kit, stream: cuda.Stream, prefix: []const u8, names: []const []const u8, n: usize, k: usize) !wt.Q4 {
+    const g = try grp.Group.create(gpa, n, k);
+    var q = wt.Q4.empty(d);
+    q.n = n;
+    q.k = k;
+    q.exl3 = g;
+    errdefer q.free();
+    var col: usize = 0;
+    var bases: [grp.max_parts][160]u8 = undefined;
+    var plain: [grp.max_parts][]const u8 = undefined;
+    var plain_n: usize = 0;
+    var plain_col: usize = 0;
+    var buf: [256]u8 = undefined;
+    for (names, 0..) |name, i| {
+        const base = try std.fmt.bufPrint(&bases[i], "{s}{s}", .{ prefix, name });
+        if (store.has(try std.fmt.bufPrint(&buf, "{s}.trellis", .{base}))) {
+            if (plain_n != 0) return error.UnexpectedTensor;
+            try trellisPart(d, g, kit, stream, store, base, col);
+            col += g.parts[g.count - 1].n;
+        } else {
+            const t = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.weight", .{base}));
+            if (plain_n == 0) plain_col = col;
+            plain[plain_n] = base;
+            plain_n += 1;
+            col += t.dim(0);
+        }
+    }
+    if (plain_n != 0) try plainPart(gpa, d, g, store, plain[0..plain_n], k, plain_col);
+    try g.check();
+    return q;
+}
+
+/// A single trellis projection `base` (n outputs, k inputs).
+pub fn single(gpa: std.mem.Allocator, d: *const cuda.Driver, store: *Store, kit: *kit_mod.Kit, stream: cuda.Stream, base: []const u8, n: usize, k: usize) !wt.Q4 {
+    const g = try grp.Group.create(gpa, n, k);
+    var q = wt.Q4.empty(d);
+    q.n = n;
+    q.k = k;
+    q.exl3 = g;
+    errdefer q.free();
+    try trellisPart(d, g, kit, stream, store, base, 0);
+    if (g.parts[0].n != n or g.parts[0].w.k != k) return error.UnexpectedTensor;
+    try g.check();
+    return q;
+}
+
+/// The router as bf16 [experts + 1][dims]: the gate's rows, then the shared expert's gate row (both stored f16).
+pub fn router(gpa: std.mem.Allocator, store: *Store, mlp: []const u8) ![]u16 {
+    var buf: [256]u8 = undefined;
+    const rows = try gpa.alloc(u16, (experts_n + 1) * dims);
+    errdefer gpa.free(rows);
+    const gate = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.gate.weight", .{mlp}));
+    if (gate.rank != 2 or gate.dim(0) != experts_n or gate.dim(1) != dims) return error.UnexpectedTensor;
+    const a = try bf16Rows(gpa, gate);
+    defer gpa.free(a);
+    @memcpy(rows[0 .. experts_n * dims], a);
+    const sg = try store.tensor(try std.fmt.bufPrint(&buf, "{s}.shared_expert_gate.weight", .{mlp}));
+    if (sg.rank != 2 or sg.dim(0) != 1 or sg.dim(1) != dims) return error.UnexpectedTensor;
+    const b = try bf16Rows(gpa, sg);
+    defer gpa.free(b);
+    @memcpy(rows[experts_n * dims ..], b);
+    return rows;
+}
+
+/// A layer's routed experts and its shared expert as expert 512, on the grouped EXL3 kernels.
+pub fn experts(gpa: std.mem.Allocator, d: *const cuda.Driver, store: *Store, mlp: []const u8) !moe.Experts {
+    const count = experts_n + 1;
+    var out: moe.Experts = .{ .layer = undefined, .gpa = gpa };
+    errdefer out.free();
+    const mods = [3][]const u8{ "gate_proj", "up_proj", "down_proj" };
+    var ptrs: [3]u64 = undefined;
+    var k2: [3]u64 = undefined;
+    var suh: [3]u64 = undefined;
+    var svh: [3]u64 = undefined;
+    var codebook: ?cuda.exl3.Codebook = null;
+    var buf: [256]u8 = undefined;
+    for (mods, 0..) |mod, m| {
+        const k = if (m == 2) moe_w else dims;
+        const n = if (m == 2) dims else moe_w;
+        const infos = try gpa.alloc(Info, count);
+        defer gpa.free(infos);
+        var total: usize = 0;
+        for (infos, 0..) |*slot, e| {
+            const base = if (e < experts_n)
+                try std.fmt.bufPrint(&buf, "{s}.experts.{d}.{s}", .{ mlp, e, mod })
+            else
+                try std.fmt.bufPrint(&buf, "{s}.shared_expert.{s}", .{ mlp, mod });
+            slot.* = try info(store, base);
+            if (slot.n != n or slot.k != k) return error.UnexpectedTensor;
+            if (codebook) |c| {
+                if (c != slot.codebook) return error.UnsupportedQuantization;
+            } else codebook = slot.codebook;
+            total += std.mem.alignForward(usize, slot.trellis.bytes.len, 16);
+        }
+        var tb = try cuda.DeviceBuffer.alloc(d, total);
+        try out.bufs.append(gpa, tb);
+        const table = try gpa.alloc(u64, count);
+        defer gpa.free(table);
+        const widths = try gpa.alloc(i32, count);
+        defer gpa.free(widths);
+        const su = try gpa.alloc(u8, count * k * 2);
+        defer gpa.free(su);
+        const sv = try gpa.alloc(u8, count * n * 2);
+        defer gpa.free(sv);
+        var at: usize = 0;
+        for (infos, 0..) |i, e| {
+            try tb.upload(at, i.trellis.bytes);
+            table[e] = tb.ptr + at;
+            widths[e] = @intCast(i.halves);
+            at += std.mem.alignForward(usize, i.trellis.bytes.len, 16);
+            @memcpy(su[e * k * 2 ..][0 .. k * 2], i.suh.bytes);
+            @memcpy(sv[e * n * 2 ..][0 .. n * 2], i.svh.bytes);
+        }
+        ptrs[m] = try put(&out, d, std.mem.sliceAsBytes(table));
+        k2[m] = try put(&out, d, std.mem.sliceAsBytes(widths));
+        suh[m] = try put(&out, d, su);
+        svh[m] = try put(&out, d, sv);
+    }
+    out.layer = .{
+        .format = .exl3,
+        .exl3 = .{
+            .gate = ptrs[0],
+            .up = ptrs[1],
+            .down = ptrs[2],
+            .gate_k2 = k2[0],
+            .up_k2 = k2[1],
+            .down_k2 = k2[2],
+            .suh_g = suh[0],
+            .suh_u = suh[1],
+            .svh_g = svh[0],
+            .svh_u = svh[1],
+            .suh_d = suh[2],
+            .svh_d = svh[2],
+            .experts = count,
+            .dims = dims,
+            .width = moe_w,
+            .codebook = codebook orelse return error.UnsupportedQuantization,
+            .limit = 0,
+            .act_mode = 1,
+        },
+        .up = 0,
+        .down = 0,
+        .width = moe_w,
+        .dims = dims,
+        .experts = count,
+        .swiglu = true,
+    };
+    return out;
+}
+
+fn put(out: *moe.Experts, d: *const cuda.Driver, bytes: []const u8) !u64 {
+    try out.bufs.ensureUnusedCapacity(out.gpa, 1);
+    const b = try cuda.DeviceBuffer.fromHost(d, bytes);
+    out.bufs.appendAssumeCapacity(b);
+    return b.ptr;
+}
+
+/// The head's rows at `ids` as bf16 [ids.len][k], decoded through the EXL3 linear: the unit vectors' products are the
+/// weight's rows, in blocks of 128 (the dense kernels' row block).
+pub fn headRows(gpa: std.mem.Allocator, d: *const cuda.Driver, stream: cuda.Stream, kit: *kit_mod.Kit, w: cuda.exl3.Weight, ids: []const u32) ![]u8 {
+    const k: usize = w.k;
+    const n: usize = w.n;
+    const block = 128;
+    const bytes = try gpa.alloc(u8, ids.len * k * 2);
+    errdefer gpa.free(bytes);
+    const out: []u16 = @alignCast(std.mem.bytesAsSlice(u16, bytes));
+    const unit = try gpa.alloc(u16, block * k);
+    defer gpa.free(unit);
+    const rows = try gpa.alloc(u16, block * n);
+    defer gpa.free(rows);
+    var x = try cuda.DeviceBuffer.alloc(d, block * k * 2);
+    defer x.free();
+    var y = try cuda.DeviceBuffer.alloc(d, block * n * 2);
+    defer y.free();
+    var k0: usize = 0;
+    while (k0 < k) : (k0 += block) {
+        @memset(unit, 0);
+        for (0..block) |r| unit[r * k + k0 + r] = 0x3f80; // bf16 1.0
+        try x.upload(0, std.mem.sliceAsBytes(unit));
+        try kit.dense.prompt(stream, w, x.ptr, .bf16, block, y.ptr, .bf16);
+        try stream.synchronize();
+        try y.download(0, std.mem.sliceAsBytes(rows));
+        for (ids, 0..) |id, j| for (0..block) |r| {
+            out[j * k + k0 + r] = rows[r * n + id];
+        };
+    }
+    return bytes;
+}
