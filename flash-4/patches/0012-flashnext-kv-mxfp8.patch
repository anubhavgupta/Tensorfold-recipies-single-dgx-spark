+pub fn kvRowBytes(heads: usize) usize {
+    return if (kv_fp8) heads * head_dim + 16 else heads * head_dim * 2;
+}
 pub const index_heads: usize = 4;
 pub const index_dim: usize = 128;
 pub const half: usize = 32;
