+// Warp-only MXFP8 quantization (E4M3 + 1-byte E8M0 power-of-2 scale per 32 elements):
+// 256 threads = 8 warps = 8 groups of 32 elements, zero shared memory, exact ceiling power-of-2 scale.
+__device__ __forceinline__ void mxfp8_quant_row(float val, int d, unsigned char* codes_out, uint8_t* scales_out) {
+    float amax = fabsf(val);
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, off));
+    uint32_t e = 0u;
+    float inv_sc = 0.0f;
+    if (amax > 0.0f) {
+        const float target = __fmul_rn(amax, 1.0f / 448.0f);
+        const uint32_t bits = __float_as_uint(target);
+        e = ((bits + 0x007fffffu) >> 23) & 0xffu;
+        if (e < 1u) e = 1u;
+        if (e > 253u) e = 253u;
+        inv_sc = __uint_as_float((254u - e) << 23);
+    }
+    if ((d & 31) == 0) scales_out[d >> 5] = static_cast<uint8_t>(e);
+    codes_out[d] = static_cast<unsigned char>(__nv_cvt_float_to_fp8(__fmul_rn(val, inv_sc), __NV_SATFINITE, __NV_E4M3));
+}
