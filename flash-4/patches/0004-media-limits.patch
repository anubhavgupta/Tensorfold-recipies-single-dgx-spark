Media limits (flash-3's patch 0003 on the native server): chat request bodies up to TENSORFOLD_MAX_BODY_MIB (default 32), 64 MiB of images and 400 Mpixel a request, 4 videos of 64 MiB, 192 MiB in all.

diff --git a/zig/src/server/audio.zig b/zig/src/server/audio.zig
index 6aa4d0e..f8a5041 100644
--- a/zig/src/server/audio.zig
+++ b/zig/src/server/audio.zig
@@ -16,7 +16,15 @@ pub const max_audio_bytes = body_limit;
 
 /// The body limit of a route that reads chat messages: an hour of audio when the engine takes it.
 pub fn bodyLimit(info: api.Info) usize {
-    return if (info.audio != null) body_limit else http_body.limit;
+    return if (info.audio != null) body_limit else chatLimit();
+}
+
+/// TENSORFOLD_MAX_BODY_MIB (whole MiB, at most 1024): a larger chat request body than http_body.limit, for pages of
+/// screenshots as base64; unset or malformed keeps the default.
+fn chatLimit() usize {
+    const v = std.c.getenv("TENSORFOLD_MAX_BODY_MIB") orelse return http_body.limit;
+    const mib = std.fmt.parseInt(usize, std.mem.span(v), 10) catch return http_body.limit;
+    return if (mib == 0 or mib > 1024) http_body.limit else @max(http_body.limit, mib << 20);
 }
 
 /// The audio token: the locator the template writes must be one added token, the one a clip's rows take.
