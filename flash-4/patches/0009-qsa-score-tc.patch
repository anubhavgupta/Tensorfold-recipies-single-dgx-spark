diff --git a/zig/kernels/cuda/flashnext_qsa_tile.cuh b/zig/kernels/cuda/flashnext_qsa_tile.cuh
index 5ead983..c3ebb48 100644
--- a/zig/kernels/cuda/flashnext_qsa_tile.cuh
+++ b/zig/kernels/cuda/flashnext_qsa_tile.cuh
@@ -84,4 +84,109 @@ __global__ void __launch_bounds__(256) scores(const __nv_bfloat16* __restrict__
                                               float* __restrict__ SC, int NB, int RATIO, int TOP, int rows) {
     scores_body<R, HI, false>(IQ, POOLED, POS0, SC, NB, RATIO, TOP, rows, Pg{});
 }
+
+// BF16 Tensor-Core indexer scores v2 (HI == 4, DI == 128): 64 query rows x 512 pooled blocks per CTA,
+// 256 threads (8 warps: 4 row-tiles x 2 block-16 tiles), cp.async double-buffered ks, register-only head reduction.
+template <bool PAGED>
+__device__ __forceinline__ void scores_tc_body(const __nv_bfloat16* __restrict__ IQ,
+                                               const __nv_bfloat16* __restrict__ POOLED, const int* __restrict__ POS0,
+                                               float* __restrict__ SC, int NB, int RATIO, int TOP, int rows,
+                                               const Pg& pg, unsigned char* smem_raw) {
+    constexpr int R = 64, BK = 32, TILES = 16, LD = DI + 8;
+    auto* qs = reinterpret_cast<__nv_bfloat16(*)[R][LD]>(smem_raw);
+    auto* ks = reinterpret_cast<__nv_bfloat16(*)[BK][LD]>(smem_raw + 4 * R * LD * sizeof(__nv_bfloat16));
+    const int r0 = blockIdx.x * R;
+    const int b0 = blockIdx.y * (BK * TILES);
+    const int pos0 = POS0[0];
+    const int last = min(r0 + R, rows) - 1;
+    const int cmax = (pos0 + last + 1) / RATIO;
+    if (cmax <= TOP || b0 >= cmax) return;
+
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5, lane = tid & 31, g = lane >> 2, t = lane & 3;
+    const int rg = warp >> 1, bg = warp & 1;
+
+    // Load 4 heads x 64 query rows x 128 bf16 (4096 uint4s) once per CTA via cp.async.
+    for (int e = tid; e < 4 * R * (DI / 8); e += 256) {
+        const int h = e / (R * (DI / 8));
+        const int rem = e % (R * (DI / 8));
+        const int ri = rem / (DI / 8), v = rem % (DI / 8);
+        const int r = r0 + ri;
+        qmm_frag::cp16z(&qs[h][ri][8 * v], IQ + (static_cast<long long>(r < rows ? r : 0) * 4 + h) * DI + 8 * v, r < rows);
+    }
+    qmm_frag::commit();
+
+    auto issue_k = [&](int tb0, int buf) {
+        for (int e = tid; e < BK * (DI / 8); e += 256) {
+            const int bi = e >> 4, v = e & 15;
+            const int b = tb0 + bi;
+            const bool valid = b < cmax;
+            const int sb = valid ? b : 0;
+            const long long at = PAGED ? page_row(pg, sb, pg.ptok / RATIO, DI) : static_cast<long long>(sb) * DI;
+            qmm_frag::cp16z(&ks[buf][bi][8 * v], POOLED + at + 8 * v, valid);
+        }
+        qmm_frag::commit();
+    };
+
+    issue_k(b0, 0);
+    qmm_frag::wait<1>();  // qs ready
+    __syncthreads();
+
+    const float scale = __fsqrt_rn(static_cast<float>(DI));
+    for (int tile = 0; tile < TILES; ++tile) {
+        const int tb0 = b0 + tile * BK;
+        if (tb0 >= cmax) break;
+        const int buf = tile & 1;
+        const bool has_next = (tile + 1 < TILES) && (tb0 + BK < cmax);
+        if (has_next) issue_k(tb0 + BK, buf ^ 1);
+        if (has_next) qmm_frag::wait<1>();
+        else qmm_frag::wait<0>();
+        __syncthreads();
+
+        float tot[2][4] = {};
+#pragma unroll
+        for (int h = 0; h < 4; ++h) {
+            float acc[2][4] = {};
+#pragma unroll
+            for (int kstep = 0; kstep < DI / 16; kstep += 2) {
+                uint32_t a0[4], a1[4];
+                qmm_frag::ldmatrix4(a0, &qs[h][rg * 16 + (lane % 16)][kstep * 16 + (lane / 16) * 8]);
+                qmm_frag::ldmatrix4(a1, &qs[h][rg * 16 + (lane % 16)][(kstep + 1) * 16 + (lane / 16) * 8]);
+#pragma unroll
+                for (int jt = 0; jt < 2; ++jt) {
+                    uint32_t bm[4];
+                    qmm_frag::ldmatrix4(bm, &ks[buf][bg * 16 + jt * 8 + (lane % 8)][kstep * 16 + (lane / 8) * 8]);
+                    qmm_frag::mma(acc[jt], a0, bm[0], bm[1]);
+                    qmm_frag::mma(acc[jt], a1, bm[2], bm[3]);
+                }
+            }
+#pragma unroll
+            for (int jt = 0; jt < 2; ++jt) {
+#pragma unroll
+                for (int e = 0; e < 4; ++e) {
+                    tot[jt][e] = __fadd_rn(tot[jt][e], fmaxf(acc[jt][e], 0.0f));
+                }
+            }
+        }
+
+#pragma unroll
+        for (int jt = 0; jt < 2; ++jt) {
+            const int b_base = tb0 + bg * 16 + jt * 8 + 2 * t;
+#pragma unroll
+            for (int rh = 0; rh < 2; ++rh) {
+                const int r = r0 + rg * 16 + g + 8 * rh;
+                if (r < rows) {
+                    const int complete = (pos0 + r + 1) / RATIO;
+                    if (complete > TOP) {
+                        if (b_base < complete)
+                            SC[static_cast<long long>(r) * NB + b_base] = __fdiv_rn(tot[jt][rh * 2], scale);
+                        if (b_base + 1 < complete)
+                            SC[static_cast<long long>(r) * NB + b_base + 1] = __fdiv_rn(tot[jt][rh * 2 + 1], scale);
+                    }
+                }
+            }
+        }
+        __syncthreads();
+    }
+}
 }  // namespace qsa_tile
