diff --git a/zig/kernels/cuda/flashnext_qsa_tile.cuh b/zig/kernels/cuda/flashnext_qsa_tile.cuh
index 5ead983..279557e 100644
--- a/zig/kernels/cuda/flashnext_qsa_tile.cuh
+++ b/zig/kernels/cuda/flashnext_qsa_tile.cuh
@@ -84,4 +84,92 @@ __global__ void __launch_bounds__(256) scores(const __nv_bfloat16* __restrict__
                                               float* __restrict__ SC, int NB, int RATIO, int TOP, int rows) {
     scores_body<R, HI, false>(IQ, POOLED, POS0, SC, NB, RATIO, TOP, rows, Pg{});
 }
+
+// BF16 Tensor-Core indexer scores (HI == 4, DI == 128): 16 query rows x 128 pooled blocks per CTA (4 warps, 1 head/warp).
+template <bool PAGED>
+__device__ __forceinline__ void scores_tc_body(const __nv_bfloat16* __restrict__ IQ,
+                                               const __nv_bfloat16* __restrict__ POOLED, const int* __restrict__ POS0,
+                                               float* __restrict__ SC, int NB, int RATIO, int TOP, int rows,
+                                               const Pg& pg) {
+    constexpr int R = 16, BK = 32, TILES = 4, LD = DI + 8;
+    __shared__ __align__(16) __nv_bfloat16 qs[4][R][LD];
+    __shared__ __align__(16) __nv_bfloat16 ks[BK][LD];
+    __shared__ float sh_sum[4][R][BK];
+    const int r0 = blockIdx.x * R;
+    const int b0 = blockIdx.y * (BK * TILES);
+    const int pos0 = POS0[0];
+    const int last = min(r0 + R, rows) - 1;
+    const int cmax = (pos0 + last + 1) / RATIO;
+    if (cmax <= TOP || b0 >= cmax) return;
+
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5, lane = tid & 31, g = lane >> 2, t = lane & 3;
+    const uint4 zero4 = make_uint4(0, 0, 0, 0);
+
+    // Load 4 heads x 16 query rows x 128 bf16 (1024 uint4s) once per CTA
+    for (int e = tid; e < 4 * R * (DI / 8); e += 128) {
+        const int h = e / (R * (DI / 8));
+        const int rem = e % (R * (DI / 8));
+        const int ri = rem / (DI / 8), v = rem % (DI / 8);
+        const int r = r0 + ri;
+        uint4 val = zero4;
+        if (r < rows) val = *reinterpret_cast<const uint4*>(IQ + (static_cast<long long>(r) * 4 + h) * DI + 8 * v);
+        *reinterpret_cast<uint4*>(&qs[h][ri][8 * v]) = val;
+    }
+    __syncthreads();
+
+    const float scale = __fsqrt_rn(static_cast<float>(DI));
+    for (int tile = 0; tile < TILES; ++tile) {
+        const int tb0 = b0 + tile * BK;
+        if (tb0 >= cmax) break;
+        for (int e = tid; e < BK * (DI / 8); e += 128) {
+            const int bi = e / (DI / 8), v = e % (DI / 8);
+            const int b = tb0 + bi;
+            uint4 val = zero4;
+            if (b < cmax) {
+                const long long at = PAGED ? page_row(pg, b, pg.ptok / RATIO, DI) : static_cast<long long>(b) * DI;
+                val = *reinterpret_cast<const uint4*>(POOLED + at + 8 * v);
+            }
+            *reinterpret_cast<uint4*>(&ks[bi][8 * v]) = val;
+        }
+        __syncthreads();
+
+        float acc[4][4] = {};
+#pragma unroll
+        for (int kstep = 0; kstep < DI / 16; kstep += 2) {
+            uint32_t a0[4], a1[4];
+            qmm_frag::ldmatrix4(a0, &qs[warp][lane % 16][kstep * 16 + (lane / 16) * 8]);
+            qmm_frag::ldmatrix4(a1, &qs[warp][lane % 16][(kstep + 1) * 16 + (lane / 16) * 8]);
+#pragma unroll
+            for (int jt = 0; jt < 4; ++jt) {
+                uint32_t bm[4];
+                qmm_frag::ldmatrix4(bm, &ks[jt * 8 + lane % 8][kstep * 16 + (lane / 8) * 8]);
+                qmm_frag::mma(acc[jt], a0, bm[0], bm[1]);
+                qmm_frag::mma(acc[jt], a1, bm[2], bm[3]);
+            }
+        }
+#pragma unroll
+        for (int jt = 0; jt < 4; ++jt) {
+#pragma unroll
+            for (int e = 0; e < 4; ++e) {
+                const int ri = g + 8 * (e >> 1);
+                const int bi = jt * 8 + 2 * t + (e & 1);
+                sh_sum[warp][ri][bi] = fmaxf(acc[jt][e], 0.0f);
+            }
+        }
+        __syncthreads();
+
+        for (int e = tid; e < R * BK; e += 128) {
+            const int ri = e >> 5, bi = e & 31;
+            const int r = r0 + ri, b = tb0 + bi;
+            if (r >= rows) continue;
+            const int complete = (pos0 + r + 1) / RATIO;
+            if (complete <= TOP || b >= complete) continue;
+            const float tot = __fadd_rn(__fadd_rn(sh_sum[0][ri][bi], sh_sum[1][ri][bi]),
+                                        __fadd_rn(sh_sum[2][ri][bi], sh_sum[3][ri][bi]));
+            SC[static_cast<long long>(r) * NB + b] = __fdiv_rn(tot, scale);
+        }
+        __syncthreads();
+    }
+}
 }  // namespace qsa_tile
