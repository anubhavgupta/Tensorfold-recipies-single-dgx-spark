Tool calls: an XML call's envelope closer and each parameter's end are found through the call's structure (functions, parameters, the closer), not the first closing tag, so a literal </tool_call> or </parameter> inside a value stays data (the model quoting a tool call in a file it writes). The flash-3 repro matrix: 12 -> 4 mismatches (the rest are token-limit cuts).

diff --git a/zig/src/server/tool_json_close.zig b/zig/src/server/tool_json_close.zig
index b794a90..130c0e0 100644
--- a/zig/src/server/tool_json_close.zig
+++ b/zig/src/server/tool_json_close.zig
@@ -3,9 +3,77 @@ const std = @import("std");
 
 const tag = "</tool_call>";
 
+const fn_open = "<function=";
+const fn_close = "</function>";
+const param_open = "<parameter=";
+const param_close = "</parameter>";
+
+fn skipSpace(text: []const u8, from: usize) usize {
+    var i = from;
+    while (i < text.len and (text[i] == ' ' or text[i] == '\t' or text[i] == '\r' or text[i] == '\n')) i += 1;
+    return i;
+}
+
+/// Whether `rest` is a proper prefix of `tag` (a tag the feed cut short), compared without case.
+fn cutTag(rest: []const u8, whole: []const u8) bool {
+    return rest.len < whole.len and std.ascii.startsWithIgnoreCase(whole, rest);
+}
+
+/// The end of a ``</parameter>`` that closes the value starting at `from`: the first one followed, past blanks, by the next
+/// ``<parameter=`` or by ``</function>`` (a literal ``</parameter>`` inside the value is data), or by the end of `text` when
+/// `end_closes` (a function body already cut at its ``</function>``). null: not decided yet.
+pub fn paramEnd(text: []const u8, from: usize, end_closes: bool) ?usize {
+    var q = from;
+    while (std.ascii.findIgnoreCasePos(text, q, param_close)) |e| : (q = e + 1) {
+        const k = skipSpace(text, e + param_close.len);
+        if (k >= text.len) return if (end_closes) e else null;
+        const rest = text[k..];
+        if (std.ascii.startsWithIgnoreCase(rest, fn_close) or std.ascii.startsWithIgnoreCase(rest, param_open)) return e;
+        if (cutTag(rest, fn_close) or cutTag(rest, param_open)) return null;
+    }
+    return null;
+}
+
+/// The ``</tool_call>`` closing an XML-led payload that starts at `begin`, found through its structure: functions, their
+/// parameters (values read to ``paramEnd``), then the closer. A closer inside a value is data. null until decided; the
+/// first closer anywhere when the text leaves that structure.
+fn xmlClose(text: []const u8, begin: usize) ?usize {
+    var i = begin;
+    while (true) {
+        i = skipSpace(text, i);
+        if (i >= text.len) return null;
+        const rest = text[i..];
+        if (std.ascii.startsWithIgnoreCase(rest, fn_open)) {
+            const gt = std.mem.indexOfScalarPos(u8, text, i, '>') orelse return null;
+            i = gt + 1;
+            while (true) {
+                i = skipSpace(text, i);
+                if (i >= text.len) return null;
+                const r = text[i..];
+                if (std.ascii.startsWithIgnoreCase(r, param_open)) {
+                    const g = std.mem.indexOfScalarPos(u8, text, i, '>') orelse return null;
+                    const e = paramEnd(text, g + 1, false) orelse return null;
+                    i = e + param_close.len;
+                } else if (std.ascii.startsWithIgnoreCase(r, fn_close)) {
+                    i += fn_close.len;
+                    break;
+                } else if (cutTag(r, fn_close) or cutTag(r, param_open)) {
+                    return null;
+                } else return std.ascii.findIgnoreCasePos(text, begin, tag);
+            }
+        } else if (std.ascii.startsWithIgnoreCase(rest, tag)) {
+            return i;
+        } else if (cutTag(rest, tag) or cutTag(rest, fn_open)) {
+            return null;
+        } else return std.ascii.findIgnoreCasePos(text, begin, tag);
+    }
+}
+
