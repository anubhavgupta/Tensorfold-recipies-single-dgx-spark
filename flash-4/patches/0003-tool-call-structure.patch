+test "the closer: an XML-led payload's closer inside a parameter value is data, however the text is fed" {
+    const t = std.testing;
+    const text = "<function=write_file>\n<parameter=content>\n<tool_call><function=example></function></tool_call>\n</parameter>\n</function>\n</tool_call>";
+    const want = std.mem.lastIndexOf(u8, text, "</tool_call>").?;
+    var c: Closer = .{ .at = 0 };
+    var got: ?usize = null;
+    for (1..text.len + 1) |n| {
+        got = c.next(text[0..n]);
+        if (got != null) break;
+    }
+    try t.expectEqual(@as(?usize, want), got);
+    try t.expectEqual(@as(?usize, want), find(text, 0));
+    // a literal </parameter> that something other than the next parameter or </function> follows is data too
+    const odd = "<function=f>\n<parameter=a>x </parameter> y</parameter>\n</function>\n</tool_call>";
+    try t.expectEqual(@as(?usize, std.mem.lastIndexOf(u8, odd, "</tool_call>").?), find(odd, 0));
+}
