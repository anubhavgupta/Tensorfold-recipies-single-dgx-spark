+"""CUDA helpers for Prism Bonsai's rotated affine pack."""
+
+from __future__ import annotations
+
+import torch
+
+BLOCK = 1024
+
+
+def _hadamard_blocks(x: torch.Tensor) -> torch.Tensor:
+    """Sylvester Hadamard over each 1024-wide block, matching Prism's normalized transform."""
+
+    if x.shape[-1] % BLOCK:
+        raise ValueError(f"Prism Hadamard widths must be multiples of {BLOCK}, not {x.shape[-1]}")
+    rows, width = x.numel() // x.shape[-1], int(x.shape[-1])
+    y = x.reshape(rows, width).to(torch.float32).reshape(rows, width // BLOCK, BLOCK).contiguous()
+    h = 1
+    while h < BLOCK:
+        v = y.reshape(rows, width // BLOCK, -1, 2, h)
+        a = v[..., 0, :].clone()
+        b = v[..., 1, :].clone()
+        v[..., 0, :] = a + b
+        v[..., 1, :] = a - b
+        h <<= 1
+    return (y * (1.0 / 32.0)).to(torch.bfloat16).reshape_as(x)
+
+
+def rotate_rows(x: torch.Tensor, signs: torch.Tensor) -> torch.Tensor:
+    """x * signs, then normalized 1024-point Hadamard blocks, rounded once to bf16."""
+
+    return _hadamard_blocks(x * signs.to(device=x.device, dtype=torch.float32))
+
+
+def inverse_rows(x: torch.Tensor, signs: torch.Tensor) -> torch.Tensor:
+    """Inverse embedding transform: Hadamard first, then signs, rounded to bf16."""
+
+    y = _hadamard_blocks(x)
+    return (y.to(torch.float32) * signs.to(device=x.device, dtype=torch.float32)).to(torch.bfloat16)
+
+
+def maybe_rotate(x: torch.Tensor, q) -> torch.Tensor:
+    signs = getattr(q, "prism_signs", None)
+    return rotate_rows(x, signs) if signs is not None else x
+
+
+def maybe_inverse_embedding(x: torch.Tensor, q) -> torch.Tensor:
+    signs = getattr(q, "prism_inverse_signs", None)
+    return inverse_rows(x, signs) if signs is not None else x
