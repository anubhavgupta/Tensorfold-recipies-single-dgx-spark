+++ b/zig/src/families/glm/cuda_mat.zig
@@ -0,0 +1,38 @@
+//! A GLM-5.3-Flash projection on CUDA as its checkpoint stores it: BF16 (the B16 path) or an EXL3 trellis.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const glue = @import("cuda_glue.zig");
+const b16 = @import("cuda_b16.zig");
+
+/// A projection's weights: bf16 [n][k] on the device, or an EXL3 group (cuda/exl3.zig).
+pub const Mat = union(enum) {
+    bf16: u64,
+    exl3: cuda.exl3.Weight,
+};
+
+/// out [m][n] bf16 (fp32 with `wide`) = x . w, x [m][k] bf16 `x_stride` apart (EXL3: packed rows only).
+pub fn matmul(set: glue.Set, stream: cuda.Stream, x: u64, x_stride: usize, w: Mat, out: u64, part: u64, m: usize, n: usize, k: usize, wide: bool) !void {
+    switch (w) {
+        .bf16 => |p| return b16.matmul(set, stream, x, x_stride, p, out, part, m, n, k, wide),
+        .exl3 => |q| {
+            const de = set.dense orelse return error.FormatNotLoaded;
+            if (q.k != k or q.n != n) return error.Exl3Shape;
+            if (x_stride != k) return error.RowStride;
+            return de.decode(stream, q, x, .bf16, m, out, if (wide) .f32 else .bf16);
+        },
+    }
+}
+
+/// Rows of `bytes` from src (`src_stride` bytes apart) into dst (`dst_stride` apart): glm_ops' tf_glm_copy_rows.
+pub fn copyRows(set: glue.Set, stream: cuda.Stream, src: u64, src_stride: usize, dst: u64, dst_stride: usize, rows: usize, bytes: usize) !void {
+    const f = set.copy_rows orelse return error.FormatNotLoaded;
+    var a: cuda.Args = .{};
+    a.add(src);
+    a.add(@as(c_longlong, @intCast(src_stride)));
+    a.add(dst);
+    a.add(@as(c_longlong, @intCast(dst_stride)));
+    a.add(@as(c_int, @intCast(rows)));
+    a.add(@as(c_int, @intCast(bytes)));
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast((rows * bytes + 255) / 256) }, .block = .{ .x = 256 } }, stream, &a);
+}
