diff --git a/zig/src/cuda/exl3.zig b/zig/src/cuda/exl3.zig
new file mode 100644
index 00000000..2a42bce1
--- /dev/null
+++ b/zig/src/cuda/exl3.zig
@@ -0,0 +1,274 @@
+//! The EXL3 decode-row linear (exl3/linear.cu's device code): the plan, a layer's tensors, and the two kernels.
+const std = @import("std");
+const driver = @import("driver.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+const kernels = @import("kernels.zig");
+const memory = @import("memory.zig");
+const Driver = driver.Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = stream_.Stream;
+
+/// x's and y's element types (linear.cu DType).
+pub const DType = enum(i32) { f16 = 0, bf16 = 1, f32 = 2 };
+
+/// The three codebooks (exl3_format.zig's, numbered as the kernel's).
+pub const Codebook = enum(u3) { inst3 = 0, mcg = 1, mul1 = 2 };
+
+/// One compiled kernel: 2 * bits halves, a codebook, and the warps one block runs.
+pub const Variant = struct { halves: u32, codebook: Codebook, warps: u32 };
+
+/// Every instantiation of exl3_linear.cu: every width (whole bits all codebooks, the mul1 half steps), 4 and 8 warps.
+pub const variants = blk: {
+    var vs: [60]Variant = undefined;
+    var i: usize = 0;
+    for (0..2) |w| {
+        const warps: u32 = if (w == 0) 4 else 8;
+        for ([_]u32{ 2, 1, 0 }) |cbi| {
+            const cb: Codebook = @fromBackingInt(@intCast(cbi));
+            var halves: u32 = 2;
+            while (halves <= 16) : (halves += 2) {
+                vs[i] = .{ .halves = halves, .codebook = cb, .warps = warps };
+                i += 1;
+            }
+            if (cb != .mul1) continue; // the half steps exist only with mul1
+            halves = 3;
+            while (halves <= 13) : (halves += 2) { // the mul1 half steps, 1.5 to 6.5 bits (format.py's BITS)
+                vs[i] = .{ .halves = halves, .codebook = cb, .warps = warps };
+                i += 1;
+            }
+        }
+    }
+    break :blk vs;
+};
+
+/// The kernel's extern "C" name for an instantiation (linear.cu's TF_EXL3_LINEAR macro).
+pub fn symbol(comptime halves: u32, comptime codebook: Codebook, comptime warps: u32) [:0]const u8 {
+    return std.fmt.comptimePrint("tf_exl3_linear_{d}_{d}_{d}", .{ halves, @backingInt(codebook), warps });
+}
+
+pub const rot_in_symbol = "tf_exl3_rot_in";
+
+pub fn variantIndex(halves: u32, codebook: Codebook, warps: u32) ?usize {
+    for (variants, 0..) |v, i| {
+        if (v.halves == halves and v.codebook == codebook and v.warps == warps) return i;
+    }
+    return null;
+}
+
+/// What one shape launches, from the shape alone so a row's bits never depend on the row count (linear.py plan).
+pub fn plan(k: usize, n: usize, blocks: usize, min_tiles: usize) struct { sk: u32, wk: u32 } {
+    const kt = k / 16;
+    const nb = n / 128;
+    var sk: usize = 1;
+    var wk: usize = if (nb >= 64) 8 else 4;
+    if (nb < 64) {
+        while (nb * sk < blocks and sk < 64) sk *= 2;
+    }
+    while ((wk > 4 or sk > 1) and (kt % (sk * wk) != 0 or kt / (sk * wk) < min_tiles)) {
+        if (wk > 4) wk = 4 else if (sk > 1) sk /= 2 else break;
+    }
+    return .{ .sk = @intCast(sk), .wk = @intCast(wk) };
+}
+
+/// Words between k tiles and 128-column blocks of one layout: strips [N/128, K/16, 8, W] or stored [K/16, N/16, W].
+pub fn strides(k: usize, n: usize, halves: usize, strips: bool) struct { k: usize, nb: usize } {
+    const words = halves * 4;
+    return if (strips)
+        .{ .k = 8 * words, .nb = (k / 16) * 8 * words }
+    else
+        .{ .k = (n / 16) * words, .nb = 8 * words };
+}
+
+/// One layer's tensors on the device: the trellis words, the Hadamard scales, the optional bias, shape and layout.
+pub const Weight = struct {
+    trellis: u64, // u32 words, `stride_k` and `stride_nb` apart
+    suh: u64, // fp16 [k]
+    svh: u64, // fp16 [n]
+    bias: u64 = 0, // fp16 [n], 0 when the layer has none
+    k: u32,
+    n: u32,
+    halves: u32, // 2 * bits, odd for the mul1 half steps
+    codebook: Codebook,
+    stride_k: u64,
+    stride_nb: u64,
+};
+
+/// The module and its kernels.
+pub const Linear = struct {
+    mod: Module,
+    fns: [variants.len]Function,
+    rot_in: Function,
+
+    pub fn load(d: *const Driver) !Linear {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var l: Linear = .{ .mod = try Module.load(d, kernels.exl3_linear), .fns = undefined, .rot_in = undefined };
+        errdefer l.mod.unload();
+        l.rot_in = try l.mod.function(rot_in_symbol);
+        inline for (0..variants.len) |i| {
+            l.fns[i] = try l.mod.function(symbol(variants[i].halves, variants[i].codebook, variants[i].warps));
+        }
+        return l;
+    }
+
+    pub fn unload(l: *Linear) void {
+        l.mod.unload();
+    }
+
+    /// Shared bytes one call needs: WK * min(m, 8) * 128 floats of warp sums, at most 32 KB.
+    pub fn sharedBytes(w: Weight, m: usize) u32 {
+        const p = plan(w.k, w.n, 192, 8);
+        return @intCast(p.wk * @min(m, 8) * 128 * 4);
+    }
+
+    /// Split partials one call needs (fp32 [sk, m, n]) when the plan splits K, else 0.
+    pub fn zBytes(w: Weight, m: usize) usize {
+        const p = plan(w.k, w.n, 192, 8);
+        return if (p.sk > 1) @as(usize, p.sk) * m * w.n * 4 else 0;
+    }
+
+    /// Counter bytes one call needs: per pass and block, zeroed (fill8(0), never zeros()).
+    pub fn counterBytes(w: Weight) usize {
+        return 8 * (w.n / 128) * 4;
+    }
+
+    /// y [m, n] = x [m, k] through the weight; `xh` is fp16 [m, k] scratch, `z` the split partials, `counters` zeroed.
+    pub fn matmul(l: *const Linear, s: Stream, w: Weight, x: u64, x_dtype: DType, m: usize, y: u64, y_dtype: DType, xh: u64, z: u64, counters: u64) !void {
+        // Shapes the loader admits (linear.py's k % 128 and n % 128, 1..128 rows) are returned errors here too.
+        if (m < 1 or m > 128) return error.Exl3Shape;
+        if (w.k % 128 != 0 or w.n % 128 != 0) return error.Exl3Shape;
+        const p = plan(w.k, w.n, 192, 8);
+        if ((w.k / 16) % (p.sk * p.wk) != 0) return error.Exl3Shape;
+        const idx = variantIndex(w.halves, w.codebook, p.wk) orelse return error.UnsupportedExl3Width;
+        if (p.sk > 1 and z == 0) return error.Exl3Scratch;
+
+        var r: launch_.Args = .{};
+        r.add(x);
+        r.add(w.suh);
+        r.add(xh);
+        r.add(@as(i32, @backingInt(x_dtype)));
+        r.add(@as(i32, @intCast(m)));
+        r.add(@as(i32, @intCast(w.k)));
+        try launch_.launch(l.rot_in, .{
+            .grid = .{ .x = @intCast((w.k / 128 + 3) / 4), .y = @intCast(m), .z = 1 },
+            .block = .{ .x = 128, .y = 1, .z = 1 },
+            .shared = 0,
+        }, s, &r);
+
+        var args: launch_.Args = .{};
+        args.add(xh);
+        args.add(w.trellis);
+        args.add(@as(i64, @intCast(w.stride_k)));
+        args.add(@as(i64, @intCast(w.stride_nb)));
+        args.add(w.svh);
+        args.add(w.bias);
+        args.add(y);
+        args.add(if (p.sk > 1) z else @as(u64, 0));
+        args.add(counters);
+        args.add(@as(i32, @backingInt(y_dtype)));
+        args.add(@as(i32, @intCast(w.n)));
+        args.add(@as(i32, @intCast(p.sk)));
+        args.add(@as(i32, @intCast(m)));
+        args.add(@as(i32, @intCast(w.k)));
+        try launch_.launch(l.fns[idx], .{
+            .grid = .{ .x = @intCast(w.n / 128 * p.sk), .y = 1, .z = 1 },
+            .block = .{ .x = @intCast(p.wk * 32), .y = 1, .z = 1 },
+            .shared = sharedBytes(w, m),
+        }, s, &args);
+    }
+};
+
+/// The loaded kernels plus the scratch one stream's dense calls share; prompt rows run in 128-row blocks (forward.py).
+pub const Dense = struct {
+    d: *const Driver,
+    lin: Linear,
+    xh: ?memory.DeviceBuffer = null, // the rotated inputs, 128 rows of the widest layer at most
+    z: ?memory.DeviceBuffer = null, // the split partials, 128 rows at most
+    counters: ?memory.DeviceBuffer = null, // per pass and block, zeroed before every call
+
+    pub fn load(d: *const Driver) !Dense {
+        return .{ .d = d, .lin = try Linear.load(d) };
+    }
+
+    pub fn unload(de: *Dense) void {
+        de.lin.unload();
+        const slots = [_]*?memory.DeviceBuffer{ &de.xh, &de.z, &de.counters };
+        for (slots) |slot| {
+            if (slot.* != null) slot.*.?.free();
+            slot.* = null;
+        }
+    }
+
+    /// A scratch buffer's address, grown when a layer needs more than it holds.
+    fn scratch(de: *Dense, slot: *?memory.DeviceBuffer, bytes: usize) !u64 {
+        if (slot.* != null and slot.*.?.len >= bytes) return slot.*.?.ptr;
+        if (slot.* != null) slot.*.?.free();
+        slot.* = try memory.DeviceBuffer.alloc(de.d, bytes);
+        return slot.*.?.ptr;
+    }
+
+    /// Decode rows: one call (the kernel takes 1..128), any count above in 128-row blocks.
+    pub fn decode(de: *Dense, s: Stream, w: Weight, x: u64, x_dtype: DType, rows: usize, y: u64, y_dtype: DType) !void {
+        return de.blocks(s, w, x, x_dtype, rows, y, y_dtype);
+    }
+
+    /// Prompt rows: 128-row blocks of `matmul`, so a row's bits never depend on where its chunk starts.
+    pub fn prompt(de: *Dense, s: Stream, w: Weight, x: u64, x_dtype: DType, rows: usize, y: u64, y_dtype: DType) !void {
+        return de.blocks(s, w, x, x_dtype, rows, y, y_dtype);
+    }
+    fn blocks(de: *Dense, s: Stream, w: Weight, x: u64, x_dtype: DType, rows: usize, y: u64, y_dtype: DType) !void {
+        const p = plan(w.k, w.n, 192, 8);
+        const z: u64 = if (p.sk > 1) try de.scratch(&de.z, Linear.zBytes(w, 128)) else 0;
+        const counters = try de.scratch(&de.counters, Linear.counterBytes(w));
+        const xe: u64 = if (x_dtype == .f32) 4 else 2;
+        const ye: u64 = if (y_dtype == .f32) 4 else 2;
+        var r: usize = 0;
+        while (r < rows) : (r += 128) {
+            const m = @min(rows - r, 128);
+            const xh = try de.scratch(&de.xh, m * w.k * 2);
+            try de.counters.?.fill8(0, s.handle);
+            try de.lin.matmul(s, w, x + @as(u64, r) * w.k * xe, x_dtype, m, y + @as(u64, r) * w.n * ye, y_dtype, xh, z, counters);
+        }
+    }
+};
+
+test "the plan matches linear.py's for known shapes" {
+    try std.testing.expectEqual(@as(@TypeOf(plan(0, 0, 192, 8)), .{ .sk = 8, .wk = 4 }), plan(4096, 1024, 192, 8));
+    try std.testing.expectEqual(@as(@TypeOf(plan(0, 0, 192, 8)), .{ .sk = 2, .wk = 4 }), plan(1024, 4096, 192, 8));
+    try std.testing.expectEqual(@as(@TypeOf(plan(0, 0, 192, 8)), .{ .sk = 4, .wk = 4 }), plan(2048, 512, 192, 8));
+    try std.testing.expectEqual(@as(@TypeOf(plan(0, 0, 192, 8)), .{ .sk = 1, .wk = 4 }), plan(512, 1024, 192, 8));
+    try std.testing.expectEqual(@as(@TypeOf(plan(0, 0, 192, 8)), .{ .sk = 1, .wk = 4 }), plan(512, 512, 192, 8));
+    try std.testing.expectEqual(@as(@TypeOf(plan(0, 0, 192, 8)), .{ .sk = 4, .wk = 4 }), plan(2048, 4096, 192, 8));
+}
+
+test "the stored and strips strides of one layout" {
+    try std.testing.expectEqual(@as(@TypeOf(strides(0, 0, 0, false)), .{ .k = 4096, .nb = 256 }), strides(4096, 2048, 8, false));
+    try std.testing.expectEqual(@as(@TypeOf(strides(0, 0, 0, true)), .{ .k = 256, .nb = 65536 }), strides(4096, 2048, 8, true));
+}
+
+test "every variant's symbol is its instantiation's name" {
+    try std.testing.expectEqualStrings("tf_exl3_linear_8_2_4", symbol(8, .mul1, 4));
+    try std.testing.expectEqualStrings("tf_exl3_linear_7_2_8", symbol(7, .mul1, 8));
+    try std.testing.expectEqualStrings("tf_exl3_linear_8_0_4", symbol(8, .inst3, 4));
+    try std.testing.expectEqual(@as(?usize, 5), variantIndex(12, .mul1, 4));
+    try std.testing.expectEqual(@as(?usize, 2), variantIndex(6, .mul1, 4));
+    try std.testing.expectEqual(@as(?usize, null), variantIndex(3, .mcg, 4)); // the half steps are mul1's alone
+}
+
+test "matmul refuses shapes the loader would refuse, before any launch" {
+    const l: Linear = .{ .mod = undefined, .fns = undefined, .rot_in = undefined };
+    const s: Stream = undefined; // never reached: the refusal comes first
+    const st = strides(4096, 1024, 8, false);
+    const w: Weight = .{ .trellis = 0, .suh = 0, .svh = 0, .bias = 0, .k = 4096, .n = 1024, .halves = 8, .codebook = .mul1, .stride_k = st.k, .stride_nb = st.nb };
+    try std.testing.expectError(error.Exl3Shape, l.matmul(s, w, 0, .bf16, 0, 0, .bf16, 0, 0, 0));
+    try std.testing.expectError(error.Exl3Shape, l.matmul(s, w, 0, .bf16, 129, 0, .bf16, 0, 0, 0));
+    var kbad = w;
+    kbad.k = 144; // k % 16 == 0 but not a multiple of 128
+    try std.testing.expectError(error.Exl3Shape, l.matmul(s, kbad, 0, .bf16, 8, 0, .bf16, 0, 0, 0));
+    var nbad = w;
+    nbad.n = 100;
+    try std.testing.expectError(error.Exl3Shape, l.matmul(s, nbad, 0, .bf16, 8, 0, .bf16, 0, 0, 0));
+    try std.testing.expectError(error.Exl3Scratch, l.matmul(s, w, 0, .bf16, 8, 0, .bf16, 0, 0, 0)); // plan(4096, 1024) splits K
+}
diff --git a/zig/src/cuda/exl3_experts.zig b/zig/src/cuda/exl3_experts.zig
new file mode 100644
index 00000000..e665dd3a
--- /dev/null
+++ b/zig/src/cuda/exl3_experts.zig
@@ -0,0 +1,299 @@
+//! The EXL3 routed experts (exl3/experts.cu's device code): the group, the grouped GEMMs, the epilogues.
+const std = @import("std");
+const driver = @import("driver.zig");
+const module = @import("module.zig");
+const launch_ = @import("launch.zig");
+const stream_ = @import("stream.zig");
+const kernels = @import("kernels.zig");
+const exl3 = @import("exl3.zig");
+const Driver = driver.Driver;
+const Module = module.Module;
+const Function = module.Function;
+const Stream = stream_.Stream;
+
+pub const DType = exl3.DType;
+pub const Codebook = exl3.Codebook;
+
+/// One layer's routed experts (experts.py's Exl3RoutedExperts): per-expert trellis pointers, stacked scales, the clamp.
+pub const Layer = struct {
+    gate: u64, // int64 [E], one trellis pointer per expert
+    up: u64,
+    down: u64,
+    gate_k2: u64, // int32 [E], half-bits a value (2 * bits)
+    up_k2: u64,
+    down_k2: u64,
+    suh_g: u64, // fp16 [E, D]
+    suh_u: u64,
+    svh_g: u64, // fp16 [E, I]
+    svh_u: u64,
+    suh_d: u64, // fp16 [E, I]
+    svh_d: u64, // fp16 [E, D]
+    experts: usize, // E
+    dims: usize, // D (model width)
+    width: usize, // I (expert width)
+    codebook: Codebook,
+    gu_stride: usize = 0, // gate/up trellis row stride in tiles (0: contiguous per projection)
+    limit: f32 = 0, // the SwiGLU clamp (0: none)
+    act_mode: i32 = 0, // 0: GLM's bf16 roundings (the route RED-SNOW runs), 1: fp32
+};
+
+/// What one projection launches (experts.py default_config): the 8-tile 4-warp K splits, shape-fixed; n % 128 required.
+pub fn plan(k: usize, n: usize, gateup: bool) !u32 {
+    const cands = [_]usize{ if (gateup) 4 else 1, 2, 1 };
+    for (cands) |sk| {
+        if (k % (16 * sk * 4) == 0 and n % 128 == 0) return @intCast(sk);
+    }
+    return error.TileNotBuilt;
+}
+
+/// One call's buffers (exl3/experts.py Scratch), laid out in scratch()'s order, each 256-byte aligned.
+pub const Scratch = struct {
+    xg: u64, // fp16 [P, D], the rotated gate inputs
+    xu: u64, // fp16 [P, D], the rotated up inputs
+    xd: u64, // fp16 [P, I], the rotated gate and up outputs (the down inputs)
+    z: u64, // fp32, gate and up write 2 * sk_gu * P * I partials, down sk_d * P * D
+    y: u64, // fp32 [P, D], the per-slot outputs
+    ids: u64, // int32 [min(P, E)], distinct routed experts in id order
+    count: u64, // int32 [1]
+    members: u64, // int32 [min(P, E), rows], row * 32 + slot, -1 after the last member
+    rows: usize, // the row capacity the buffers hold
+    slots: usize, // slots a row, at most 32
+};
+
+/// The byte size of the scratch buffers for a layer and row capacity, or error.TileNotBuilt when plan() fails.
+pub fn scratchBytes(l: Layer, rows: usize, slots: usize) !usize {
+    const g_sk = try plan(l.dims, l.width, true);
+    const d_sk = try plan(l.width, l.dims, false);
+    const p = rows * slots;
+    const maxu = @min(p, l.experts);
+    return align256(p * l.dims * 2) + align256(p * l.dims * 2) + align256(p * l.width * 2) +
+        align256(@max(2 * g_sk * l.width, d_sk * l.dims) * p * 4) + align256(p * l.dims * 4) +
+        align256(maxu * 4) + 256 + align256(maxu * rows * 4);
+}
+
+fn align256(n: usize) usize {
+    return (n + 255) / 256 * 256;
+}
+
+/// The pointers into one allocation of scratchBytes(), or error.TileNotBuilt when plan() fails.
+pub fn scratch(base: u64, l: Layer, rows: usize, slots: usize) !Scratch {
+    const p = rows * slots;
+    const g_sk = try plan(l.dims, l.width, true);
+    const d_sk = try plan(l.width, l.dims, false);
+    const maxu = @min(p, l.experts);
+    var at = base;
+    const take = struct {
+        fn f(a: *u64, bytes: usize) u64 {
+            const r = a.*;
+            a.* = r + align256(bytes);
+            return r;
+        }
+    }.f;
+    const xg = take(&at, p * l.dims * 2);
+    const xu = take(&at, p * l.dims * 2);
+    const xd = take(&at, p * l.width * 2);
+    const z = take(&at, @max(2 * g_sk * l.width, d_sk * l.dims) * p * 4);
+    const y = take(&at, p * l.dims * 4);
+    const ids = take(&at, maxu * 4);
+    const count = take(&at, 4);
+    const members = take(&at, maxu * rows * 4);
+    return .{ .xg = xg, .xu = xu, .xd = xd, .z = z, .y = y, .ids = ids, .count = count, .members = members, .rows = rows, .slots = slots };
+}
+
+/// The loaded kernels.
+pub const Experts = struct {
+    mod: Module,
+    group: Function,
+    rot_in: Function,
+    grouped: [3]Function, // one per codebook
+    gateup: Function,
+    down_combine: Function,
+
+    pub fn load(d: *const Driver) !Experts {
+        if (!kernels.available) return error.BuiltWithoutKernels;
+        var e: Experts = .{
+            .mod = try Module.load(d, kernels.exl3_experts),
+            .group = undefined,
+            .rot_in = undefined,
+            .grouped = undefined,
+            .gateup = undefined,
+            .down_combine = undefined,
+        };
+        errdefer e.mod.unload();
+        e.group = try e.mod.function("tf_exl3_group");
+        try e.group.allowDynamicShared(64 * 1024);
+        e.rot_in = try e.mod.function("tf_exl3_experts_rot_in");
+        e.grouped = .{
+            try e.mod.function("tf_exl3_grouped_0"),
+            try e.mod.function("tf_exl3_grouped_1"),
+            try e.mod.function("tf_exl3_grouped_2"),
+        };
+        e.gateup = try e.mod.function("tf_exl3_gateup_epilogue");
+        e.down_combine = try e.mod.function("tf_exl3_down_combine");
+        return e;
+    }
+
+    pub fn unload(e: *Experts) void {
+        e.mod.unload();
+    }
+
+    /// The routed experts of `rows` rows: group, rotate in, grouped gate/up, SwiGLU, grouped down, wts-weighted sum.
+    pub fn run(e: *const Experts, s: Stream, l: Layer, x: u64, x_stride: usize, x_dtype: DType, pick: u64, wts: u64, rows: usize, out: u64, sc: Scratch) !void {
+        const d = l.dims;
+        const w = l.width;
+        const slots = sc.slots;
+        std.debug.assert(rows >= 1 and rows <= sc.rows);
+        std.debug.assert(slots >= 1 and slots <= 32);
+        std.debug.assert(l.experts >= 1 and l.experts <= 4096);
+        const g_sk = try plan(d, w, true);
+        const d_sk = try plan(w, d, false);
+        const p = rows * slots;
+        const maxu = @min(p, l.experts);
+        const mt = (rows + 15) / 16;
+        const i32d = struct {
+            fn f(v: usize) i32 {
+                return @intCast(v);
+            }
+        }.f;
+
+        var a: launch_.Args = .{};
+        a.add(pick);
+        a.add(sc.ids);
+        a.add(sc.count);
+        a.add(sc.members);
+        a.add(i32d(rows));
+        a.add(i32d(slots));
+        a.add(i32d(l.experts));
+        a.add(i32d(rows));
+        try launch_.launch(e.group, .{ .grid = .{ .x = 1, .y = 1, .z = 1 }, .block = .{ .x = 1024, .y = 1, .z = 1 }, .shared = @intCast(rows * slots * 4) }, s, &a);
+
+        var r: launch_.Args = .{};
+        r.add(x);
+        r.add(i32d(x_stride));
+        r.add(@as(i32, @backingInt(x_dtype)));
+        r.add(pick);
+        r.add(l.suh_g);
+        r.add(l.suh_u);
+        r.add(sc.xg);
+        r.add(sc.xu);
+        r.add(i32d(d));
+        r.add(i32d(slots));
+        r.add(i32d(l.experts));
+        try launch_.launch(e.rot_in, .{ .grid = .{ .x = @intCast(p), .y = @intCast(d / 128), .z = 2 }, .block = .{ .x = 32, .y = 1, .z = 1 } }, s, &r);
+
+        var g: launch_.Args = .{};
+        g.add(sc.xg);
+        g.add(sc.xu);
+        g.add(l.gate);
+        g.add(l.up);
+        g.add(l.gate_k2);
+        g.add(l.up_k2);
+        g.add(sc.ids);
+        g.add(sc.count);
+        g.add(sc.members);
+        g.add(sc.z);
+        g.add(i32d(d));
+        g.add(i32d(w));
+        g.add(i32d(p));
+        g.add(i32d(g_sk));
+        g.add(i32d(rows));
+        g.add(i32d(slots));
+        g.add(i32d(maxu));
+        g.add(@as(i32, 2));
+        g.add(i32d(l.gu_stride));
+        try launch_.launch(e.grouped[@backingInt(l.codebook)], .{ .grid = .{ .x = @intCast(maxu), .y = @intCast(w / 128), .z = @intCast(2 * g_sk * mt) }, .block = .{ .x = 128, .y = 1, .z = 1 } }, s, &g);
+
+        var ep: launch_.Args = .{};
+        ep.add(sc.z);
+        ep.add(pick);
+        ep.add(l.svh_g);
+        ep.add(l.svh_u);
+        ep.add(l.suh_d);
+        ep.add(sc.xd);
+        ep.add(i32d(p));
+        ep.add(i32d(w));
+        ep.add(i32d(g_sk));
+        ep.add(i32d(l.experts));
+        ep.add(l.limit);
+        ep.add(l.act_mode);
+        try launch_.launch(e.gateup, .{ .grid = .{ .x = @intCast(p), .y = @intCast(w / 128), .z = 1 }, .block = .{ .x = 32, .y = 1, .z = 1 } }, s, &ep);
+
+        var dn: launch_.Args = .{};
+        dn.add(sc.xd);
+        dn.add(sc.xd);
+        dn.add(l.down);
+        dn.add(l.down);
+        dn.add(l.down_k2);
+        dn.add(l.down_k2);
+        dn.add(sc.ids);
+        dn.add(sc.count);
+        dn.add(sc.members);
+        dn.add(sc.z);
+        dn.add(i32d(w));
+        dn.add(i32d(d));
+        dn.add(i32d(p));
+        dn.add(i32d(d_sk));
+        dn.add(i32d(rows));
+        dn.add(i32d(slots));
+        dn.add(i32d(maxu));
+        dn.add(@as(i32, 1));
+        dn.add(@as(i32, 0));
+        try launch_.launch(e.grouped[@backingInt(l.codebook)], .{ .grid = .{ .x = @intCast(maxu), .y = @intCast(d / 128), .z = @intCast(d_sk * mt) }, .block = .{ .x = 128, .y = 1, .z = 1 } }, s, &dn);
+
+        var cb: launch_.Args = .{};
+        cb.add(sc.z);
+        cb.add(pick);
+        cb.add(l.svh_d);
+        cb.add(sc.y);
+        cb.add(wts);
+        cb.add(out);
+        cb.add(i32d(p));
+        cb.add(i32d(d));
+        cb.add(i32d(d_sk));
+        cb.add(i32d(l.experts));
+        cb.add(i32d(slots));
+        try launch_.launch(e.down_combine, .{ .grid = .{ .x = @intCast(rows), .y = @intCast(d / 128), .z = 1 }, .block = .{ .x = @intCast(32 * slots), .y = 1, .z = 1 } }, s, &cb);
+    }
+};
+
+test "the plan matches experts.py's for known shapes" {
+    try std.testing.expectEqual(@as(u32, 4), try plan(4096, 2048, true)); // GLM_GATEUP
+    try std.testing.expectEqual(@as(u32, 1), try plan(2048, 4096, false)); // GLM_DOWN
+    try std.testing.expectEqual(@as(u32, 4), try plan(512, 256, true));
+    try std.testing.expectEqual(@as(u32, 1), try plan(256, 512, false));
+    try std.testing.expectError(error.TileNotBuilt, plan(300, 256, true));
+}
+
+test "the scratch layout is 256-aligned and covered by scratchBytes" {
+    const l: Layer = .{
+        .gate = 0,
+        .up = 0,
+        .down = 0,
+        .gate_k2 = 0,
+        .up_k2 = 0,
+        .down_k2 = 0,
+        .suh_g = 0,
+        .suh_u = 0,
+        .svh_g = 0,
+        .svh_u = 0,
+        .suh_d = 0,
+        .svh_d = 0,
+        .experts = 9,
+        .dims = 512,
+        .width = 256,
+        .codebook = .mul1,
+    };
+    const bytes = try scratchBytes(l, 64, 8);
+    var buf: [4096]u8 align(256) = undefined;
+    const sc = try scratch(@intFromPtr(&buf), l, 64, 8);
+    try std.testing.expectEqual(@as(u64, @intFromPtr(&buf)), sc.xg);
+    try std.testing.expectEqual(@as(u64, 0), sc.xg % 256);
+    try std.testing.expectEqual(@as(u64, 0), sc.xu % 256);
+    try std.testing.expectEqual(@as(u64, 0), sc.xd % 256);
+    try std.testing.expectEqual(@as(u64, 0), sc.z % 256);
+    try std.testing.expectEqual(@as(u64, 0), sc.y % 256);
+    try std.testing.expectEqual(@as(u64, 0), sc.ids % 256);
+    try std.testing.expectEqual(@as(u64, 0), sc.count % 256);
+    try std.testing.expectEqual(@as(u64, 0), sc.members % 256);
+    try std.testing.expectEqual(@as(usize, @intFromPtr(&buf) + bytes), sc.members + @as(usize, 9) * 64 * 4);
+}
diff --git a/zig/src/cuda/exl3_upload.zig b/zig/src/cuda/exl3_upload.zig
new file mode 100644
index 00000000..ef0e434a
--- /dev/null
+++ b/zig/src/cuda/exl3_upload.zig
@@ -0,0 +1,105 @@
+//! Uploading core exl3_load groups to the device as the exl3 kernels' weights (the engine's load path).
+const std = @import("std");
+const driver = @import("driver.zig");
+const memory = @import("memory.zig");
+const exl3 = @import("exl3.zig");
+const exl3e = @import("exl3_experts.zig");
+const Driver = driver.Driver;
+
+/// The tensors one upload holds: appended to `bufs` and freed together.
+pub const Uploader = struct {
+    d: *const Driver,
+    gpa: std.mem.Allocator,
+    bufs: std.ArrayList(memory.DeviceBuffer) = .empty,
+    bytes: usize = 0, // the tensors' total device bytes
+
+    pub fn deinit(u: *Uploader) void {
+        for (u.bufs.items) |*b| b.free();
+        u.bufs.deinit(u.gpa);
+    }
+
+    pub fn dev(u: *Uploader, bytes: []const u8) !u64 {
+        const b = try memory.DeviceBuffer.fromHost(u.d, bytes);
+        try u.bufs.append(u.gpa, b);
+        u.bytes += bytes.len;
+        return b.ptr;
+    }
+
+    /// One dense group: `parts` (exl3_load.Parts) and `g` (exl3_load.Group) as the Weight; the scales must be fp16.
+    pub fn dense(u: *Uploader, parts: anytype, g: anytype) !exl3.Weight {
+        if (parts.suh_packed) return error.PackedScales;
+        const st = exl3.strides(g.k, g.n, g.halves, false);
+        return .{
+            .trellis = try u.dev(parts.trellis.bytes),
+            .suh = try u.dev(parts.suh.bytes),
+            .svh = try u.dev(parts.svh.bytes),
+            .bias = if (parts.bias) |b| try u.dev(b.bytes) else 0,
+            .k = @intCast(g.k),
+            .n = @intCast(g.n),
+            .halves = g.halves,
+            .codebook = switch (g.codebook) {
+                .inst3 => .inst3,
+                .mcg => .mcg,
+                .mul1 => .mul1,
+            },
+            .stride_k = st.k,
+            .stride_nb = st.nb,
+        };
+    }
+};
+
+/// One expert projection's tensors (fp16 scales) and half-bit width: the exl3_load Parts' bytes, the group's halves.
+pub const Proj = struct { trellis: []const u8, suh: []const u8, svh: []const u8, k2: u32 };
+
+/// One layer's routed experts: trellises in place (pointers stacked), scales stacked [E, n] fp16, widths int32 [E].
+pub fn layer(u: *Uploader, a: std.mem.Allocator, dims: usize, width: usize, cb: exl3.Codebook, limit: f32, act_mode: i32, gate: []const Proj, up: []const Proj, down: []const Proj) !exl3e.Layer {
+    const e = gate.len;
+    if (up.len != e or down.len != e or e == 0) return error.BadExperts;
+    const gt = try pointers(u, a, gate);
+    const ut = try pointers(u, a, up);
+    const dt = try pointers(u, a, down);
+    return .{
+        .gate = try u.dev(std.mem.sliceAsBytes(gt)),
+        .up = try u.dev(std.mem.sliceAsBytes(ut)),
+        .down = try u.dev(std.mem.sliceAsBytes(dt)),
+        .gate_k2 = try k2s(u, a, gate),
+        .up_k2 = try k2s(u, a, up),
+        .down_k2 = try k2s(u, a, down),
+        .suh_g = try stacked(u, a, gate, dims, "suh"),
+        .suh_u = try stacked(u, a, up, dims, "suh"),
+        .svh_g = try stacked(u, a, gate, width, "svh"),
+        .svh_u = try stacked(u, a, up, width, "svh"),
+        .suh_d = try stacked(u, a, down, width, "suh"),
+        .svh_d = try stacked(u, a, down, dims, "svh"),
+        .experts = e,
+        .dims = dims,
+        .width = width,
+        .codebook = cb,
+        .gu_stride = 0,
+        .limit = limit,
+        .act_mode = act_mode,
+    };
+}
+
+fn pointers(u: *Uploader, a: std.mem.Allocator, projs: []const Proj) ![]u64 {
+    const out = try a.alloc(u64, projs.len);
+    for (projs, 0..) |p, i| out[i] = try u.dev(p.trellis);
+    return out;
+}
+
+fn k2s(u: *Uploader, a: std.mem.Allocator, projs: []const Proj) !u64 {
+    const host = try a.alloc(i32, projs.len);
+    for (projs, 0..) |p, i| host[i] = @intCast(p.k2);
+    return u.dev(std.mem.sliceAsBytes(host));
+}
+
+/// Every expert's fp16 scale of `name` ("suh" or "svh"), `n` values each, stacked [E, n].
+fn stacked(u: *Uploader, a: std.mem.Allocator, projs: []const Proj, n: usize, comptime name: []const u8) !u64 {
+    const host = try a.alloc(u8, projs.len * n * 2);
+    for (projs, 0..) |p, i| {
+        const s = @field(p, name);
+        if (s.len != n * 2) return error.BadScales;
+        @memcpy(host[i * n * 2 ..][0..s.len], s);
+    }
+    return u.dev(host);
+}
