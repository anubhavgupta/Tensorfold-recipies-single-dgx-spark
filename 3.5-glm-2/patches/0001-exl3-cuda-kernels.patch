diff --git a/zig/tests/cuda/exl3_dense_tests.zig b/zig/tests/cuda/exl3_dense_tests.zig
new file mode 100644
index 00000000..877d9ed7
--- /dev/null
+++ b/zig/tests/cuda/exl3_dense_tests.zig
@@ -0,0 +1,329 @@
+//! EXL3 dense prompt path: qlinear's dispatch, float64 references, chunk invariance, the engine's prompt bytes.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const quant_ref_tests = @import("quant_ref_tests.zig");
+const exl3fmt = @import("core").exl3_format;
+const exl3_load = @import("core").exl3_load;
+const exl3 = cuda.exl3;
+const qlinear = cuda.qlinear;
+const exl3_tests = @import("exl3_tests.zig");
+const Run = exl3_tests.Run;
+const Rig = quant_ref_tests.RigT;
+const bf = quant_ref_tests.helpers.bfOf;
+
+pub fn run(r: *Rig, state: *Run, dir: []const u8) !void {
+    var dense = try exl3.Dense.load(r.gpu.d);
+    defer dense.unload();
+    const ql: qlinear.Linear = .{ .exl3 = &dense };
+    {
+        var ok = true;
+        qlinearCheck(r, &ql, &dense.lin) catch |e| {
+            state.fail(e, "exl3.qlinear");
+            ok = false;
+        };
+        if (ok) check.pass("exl3.qlinear", .{});
+    }
+    {
+        var ok = true;
+        promptF64(r, &dense.lin) catch |e| {
+            state.fail(e, "exl3.prompt.linear.f64");
+            ok = false;
+        };
+        if (ok) check.pass("exl3.prompt.linear.f64", .{});
+    }
+    {
+        var ok = true;
+        chunks(r, &dense) catch |e| {
+            state.fail(e, "exl3.prompt.linear.chunks");
+            ok = false;
+        };
+        if (ok) check.pass("exl3.prompt.linear.chunks", .{});
+    }
+    if (pythonPrompt(r, &dense, dir) catch |e| blk: {
+        state.fail(e, "exl3.prompt.python");
+        break :blk false;
+    }) check.pass("exl3.prompt.python", .{});
+    if (loadRedsnow(r, &dense, dir) catch |e| blk: {
+        state.fail(e, "exl3.load.redsnow");
+        break :blk false;
+    }) check.pass("exl3.load.redsnow", .{});
+}
+
+/// Through qlinear.Linear's decode and prompt dispatch, 1, 17 and 300 rows byte-equal the direct block loop.
+fn qlinearCheck(r: *Rig, ql: *const qlinear.Linear, lin: *const exl3.Linear) !void {
+    const k = 1024;
+    const n = 512;
+    const trellis, const suh, const svh = try tensors(r, k, n, .{ .halves = 8 });
+    const w = try weight(r, trellis, suh, svh, k, n, 8, .mul1);
+    const x = try r.bfs(300 * k, 1.0);
+    const dx = try r.dev(std.mem.sliceAsBytes(x));
+    const counters = try exl3_tests.zeroed(r, exl3.Linear.counterBytes(w));
+    const xh = try exl3_tests.zeroed(r, 128 * k * 2);
+    const z: u64 = if (exl3.plan(k, n, 192, 8).sk > 1) try exl3_tests.zeroed(r, exl3.Linear.zBytes(w, 128)) else 0;
+    for ([_]usize{ 1, 17, 300 }) |m| {
+        const want = try r.zeros(m * n * 2);
+        var off: usize = 0;
+        while (off < m) : (off += 128) {
+            try lin.matmul(r.s, w, dx + off * k * 2, .bf16, @min(m - off, 128), want + off * n * 2, .bf16, xh, z, counters);
+        }
+        const wantraw = try r.back(want, m * n * 2);
+        const Kind = enum { decode, prompt };
+        for ([_]Kind{ .decode, .prompt }) |kind| {
+            const got = try r.zeros(m * n * 2);
+            switch (kind) {
+                .decode => try ql.decode(r.s, .{ .exl3 = w }, .{ .x = dx }, got, m),
+                .prompt => try ql.prompt(r.s, .{ .exl3 = w }, .{ .x = dx }, got, m),
+            }
+            const raw = try r.back(got, m * n * 2);
+            const id = try std.fmt.allocPrint(r.a, "exl3.qlinear.{s} m={d}", .{ @tagName(kind), m });
+            try check.sameBytes(id, raw, wantraw);
+        }
+    }
+}
+
+/// 300 and 1000 prompt rows against the float64 reference (exl3_tests' reference with m a parameter).
+fn promptF64(r: *Rig, lin: *const exl3.Linear) !void {
+    const cfgs = [_]struct { halves: u32, codebook: exl3fmt.Codebook, k: usize, n: usize }{
+        .{ .halves = 8, .codebook = .mul1, .k = 512, .n = 512 },
+        .{ .halves = 10, .codebook = .mul1, .k = 1024, .n = 512 },
+    };
+    for (cfgs) |c| {
+        const width: exl3fmt.Width = .{ .halves = @intCast(c.halves) };
+        const trellis, const suh, const svh = try tensors(r, c.k, c.n, width);
+        const w = try weight(r, trellis, suh, svh, c.k, c.n, c.halves, cbOf(@tagName(c.codebook)));
+        const counters = try exl3_tests.zeroed(r, exl3.Linear.counterBytes(w));
+        const xh = try exl3_tests.zeroed(r, 128 * c.k * 2);
+        const z: u64 = if (exl3.plan(c.k, c.n, 192, 8).sk > 1) try exl3_tests.zeroed(r, exl3.Linear.zBytes(w, 128)) else 0;
+        for ([_]usize{ 300, 1000 }) |m| {
+            const x = try r.bfs(m * c.k, 1.0);
+            const dx = try r.dev(std.mem.sliceAsBytes(x));
+            const ref = try promptReference(r, width, c.codebook, trellis, c.k, c.n, x, suh, svh, m);
+            const id = try std.fmt.allocPrint(r.a, "exl3.prompt.linear.f64 k={d} n={d} m={d}", .{ c.k, c.n, m });
+            const dy = try r.zeros(m * c.n * 2);
+            var off: usize = 0;
+            while (off < m) : (off += 128) {
+                try lin.matmul(r.s, w, dx + off * c.k * 2, .bf16, @min(m - off, 128), dy + off * c.n * 2, .bf16, xh, z, counters);
+            }
+            try exl3_tests.closeOut(r, id, dy, m * c.n, ref.want, ref.tol);
+        }
+    }
+}
+
+/// A row's bytes are identical whether the prompt runs as one call, 128-row calls, a split at 37, or 2048 chunks.
+fn chunks(r: *Rig, de: *exl3.Dense) !void {
+    const k = 512;
+    const n = 512;
+    const rows = 2185; // 17 whole 128-blocks and a 9-row tail
+    const trellis, const suh, const svh = try tensors(r, k, n, .{ .halves = 8 });
+    const w = try weight(r, trellis, suh, svh, k, n, 8, .mul1);
+    const x = try r.bfs(rows * k, 1.0);
+    const dx = try r.dev(std.mem.sliceAsBytes(x));
+    const y0 = try r.zeros(rows * n * 2);
+    try de.prompt(r.s, w, dx, .bf16, rows, y0, .bf16);
+    const want = try r.back(y0, rows * n * 2);
+    var b128: [17]usize = undefined;
+    for (&b128, 1..) |*v, i| v.* = i * 128;
+    for ([_][]const usize{ &.{}, &b128, &.{37}, &.{2048} }) |bounds| {
+        const y = try r.zeros(rows * n * 2);
+        var prev: usize = 0;
+        for (bounds) |b| {
+            try de.prompt(r.s, w, dx + prev * k * 2, .bf16, b - prev, y + prev * n * 2, .bf16);
+            prev = b;
+        }
+        try de.prompt(r.s, w, dx + prev * k * 2, .bf16, rows - prev, y + prev * n * 2, .bf16);
+        const got = try r.back(y, rows * n * 2);
+        const id = try std.fmt.allocPrint(r.a, "exl3.prompt.linear.chunks {d} splits", .{bounds.len});
+        try check.sameBytes(id, got, want);
+    }
+}
+
+/// The Python engine's recorded prompt bytes for one real dense projection, bit for bit.
+fn pythonPrompt(r: *Rig, de: *exl3.Dense, dir: []const u8) !bool {
+    if (std.mem.eql(u8, dir, "none")) {
+        std.debug.print("SKIP exl3.prompt.python\n", .{});
+        return false;
+    }
+    const d = (try denseEntry(r, dir)) orelse {
+        std.debug.print("SKIP exl3.prompt.python: no dense entry\n", .{});
+        return false;
+    };
+    const k: usize = @intCast(d.get("k").?.integer);
+    const n: usize = @intCast(d.get("n").?.integer);
+    const bits: u32 = bitsOf(d.get("bits").?);
+    const m: usize = @intCast(d.get("rows").?.integer);
+    const bias = d.get("bias").?;
+    const st = exl3.strides(k, n, 2 * bits, false);
+    const w: exl3.Weight = .{
+        .trellis = try r.dev(try exl3_tests.readFile(r, dir, d.get("trellis").?.string)),
+        .suh = try r.dev(try exl3_tests.readFile(r, dir, d.get("suh").?.string)),
+        .svh = try r.dev(try exl3_tests.readFile(r, dir, d.get("svh").?.string)),
+        .bias = if (std.meta.activeTag(bias) == .null) 0 else try r.dev(try exl3_tests.readFile(r, dir, bias.string)),
+        .k = @intCast(k),
+        .n = @intCast(n),
+        .halves = 2 * bits,
+        .codebook = cbOf(d.get("codebook").?.string),
+        .stride_k = st.k,
+        .stride_nb = st.nb,
+    };
+    const x = try exl3_tests.readFile(r, dir, d.get("x").?.string);
+    const want = try exl3_tests.readFile(r, dir, d.get("y").?.string);
+    const dy = try r.zeros(m * n * 2);
+    try de.prompt(r.s, w, try r.dev(x), .bf16, m, dy, .bf16);
+    const got = try r.back(dy, want.len);
+    try check.sameBytes("exl3.prompt.python", got, want);
+    return true;
+}
+
+/// The checkpoint loader over real RED-SNOW: every EXL3 group admitted, one layer's prompt vs the fixture bytes.
+fn loadRedsnow(r: *Rig, de: *exl3.Dense, dir: []const u8) !bool {
+    if (std.mem.eql(u8, dir, "none")) {
+        std.debug.print("SKIP exl3.load.redsnow\n", .{});
+        return false;
+    }
+    const o = try manifest(r, dir);
+    const model = o.get("model") orelse return error.TestFailed; // the fixture names its model folder
+    const d = (try denseEntry(r, dir)) orelse {
+        std.debug.print("SKIP exl3.load.redsnow: no dense entry\n", .{});
+        return false;
+    };
+    var s = try exl3_load.scan(r.gpu.gpa, r.gpu.io, model.string);
+    defer s.deinit();
+    const sum = s.summary;
+    // the inspect tool's counts: every group suh/svh mul1, the whole-bits histogram, the experts' downs
+    try check.expect(sum.groups == 37408, "exl3.load.redsnow: {d} groups, expected 37408", .{sum.groups});
+    try check.expect(sum.mul1 == 37408, "exl3.load.redsnow: {d} mul1, expected 37408", .{sum.mul1});
+    try check.expect(sum.suh_svh == 37408, "exl3.load.redsnow: {d} suh/svh, expected 37408", .{sum.suh_svh});
+    const hist = [_]usize{ 15425, 11801, 10054, 43, 85 }; // whole bits 4 to 8
+    const downs = [_]usize{ 10283, 1448, 653, 0, 0 };
+    for (hist, downs, 4..) |want, down, bits| {
+        try check.expect(sum.bits[2 * bits] == want, "exl3.load.redsnow: {d} groups at {d} bits, expected {d}", .{ sum.bits[2 * bits], bits, want });
+        try check.expect(sum.experts_down[2 * bits] == down, "exl3.load.redsnow: {d} expert down projections at {d} bits, expected {d}", .{ sum.experts_down[2 * bits], bits, down });
+    }
+    try check.expect(s.bad == 0, "exl3.load.redsnow: {d} tensors refused", .{s.bad});
+    const gi = s.find(d.get("name").?.string) orelse return error.TestFailed; // the fixture's layer
+    const g = s.groups[gi];
+    const p = try s.parts(r.a, gi);
+    const st = exl3.strides(g.k, g.n, g.halves, false);
+    const w: exl3.Weight = .{
+        .trellis = try r.dev(p.trellis.bytes),
+        .suh = try r.dev(p.suh.bytes),
+        .svh = try r.dev(p.svh.bytes),
+        .bias = if (p.bias) |b| try r.dev(b.bytes) else 0,
+        .k = @intCast(g.k),
+        .n = @intCast(g.n),
+        .halves = g.halves,
+        .codebook = .mul1,
+        .stride_k = st.k,
+        .stride_nb = st.nb,
+    };
+    try check.expect(g.halves == 2 * bitsOf(d.get("bits").?) and g.k == @as(usize, @intCast(d.get("k").?.integer)) and
+        g.n == @as(usize, @intCast(d.get("n").?.integer)), "exl3.load.redsnow: the loaded layer is not the fixture's", .{});
+    const m: usize = @intCast(d.get("rows").?.integer);
+    const x = try exl3_tests.readFile(r, dir, d.get("x").?.string);
+    const want = try exl3_tests.readFile(r, dir, d.get("y").?.string);
+    const dy = try r.zeros(m * g.n * 2);
+    try de.prompt(r.s, w, try r.dev(x), .bf16, m, dy, .bf16);
+    const got = try r.back(dy, want.len);
+    try check.sameBytes("exl3.load.redsnow", got, want);
+    return true;
+}
+
+/// The manifest's "dense" entry, null when an older fixture dir has none.
+fn denseEntry(r: *Rig, dir: []const u8) !?std.json.ObjectMap {
+    const o = try manifest(r, dir);
+    return if (o.get("dense")) |v| v.object else null;
+}
+
+fn manifest(r: *Rig, dir: []const u8) !std.json.ObjectMap {
+    const text = try std.Io.Dir.cwd().readFileAlloc(r.gpu.io, try std.fs.path.join(r.a, &.{ dir, "manifest.json" }), r.a, .limited(1 << 24));
+    const parsed = try std.json.parseFromSlice(std.json.Value, r.a, text, .{});
+    return parsed.value.object;
+}
+
+fn bitsOf(v: std.json.Value) u32 {
+    return switch (v) {
+        .integer => |i| @intCast(i),
+        .float => |f| @intFromFloat(f),
+        else => unreachable,
+    };
+}
+
+fn cbOf(name: []const u8) exl3.Codebook {
+    if (std.mem.eql(u8, name, "mcg")) return .mcg;
+    if (std.mem.eql(u8, name, "inst3")) return .inst3;
+    return .mul1;
+}
+
+/// Random trellis, scales at one shape (the same layout as exl3_tests' f64 cfgs).
+fn tensors(r: *Rig, k: usize, n: usize, width: exl3fmt.Width) !struct { []i16, []u16, []u16 } {
+    const trellis = try r.a.alloc(i16, (k / 16) * (n / 16) * width.tileWords());
+    for (trellis) |*v| v.* = r.rng.int(i16);
+    const suh = try r.a.alloc(u16, k);
+    const svh = try r.a.alloc(u16, n);
+    for (suh) |*v| v.* = @bitCast(@as(f16, @floatCast(r.rng.float(f32) * 2 - 1)));
+    for (svh) |*v| v.* = @bitCast(@as(f16, @floatCast(r.rng.float(f32) * 2 - 1)));
+    return .{ trellis, suh, svh };
+}
+
+fn weight(r: *Rig, trellis: []const i16, suh: []const u16, svh: []const u16, k: usize, n: usize, halves: u32, cb: exl3.Codebook) !exl3.Weight {
+    const st = exl3.strides(k, n, halves, false);
+    return .{
+        .trellis = try r.dev(std.mem.sliceAsBytes(trellis)),
+        .suh = try r.dev(std.mem.sliceAsBytes(suh)),
+        .svh = try r.dev(std.mem.sliceAsBytes(svh)),
+        .bias = 0,
+        .k = @intCast(k),
+        .n = @intCast(n),
+        .halves = halves,
+        .codebook = cb,
+        .stride_k = st.k,
+        .stride_nb = st.nb,
+    };
+}
+
+/// The Python engine's f64 reference, with the row count a parameter.
+fn promptReference(r: *Rig, width: exl3fmt.Width, cb: exl3fmt.Codebook, trellis: []const i16, k: usize, n: usize, x: []const u16, suh: []const u16, svh: []const u16, m: usize) !struct { want: []f64, tol: []f64 } {
+    const wq = try r.a.alloc(f16, k * n);
+    exl3fmt.unpack(width, cb, trellis, k / 16, n / 16, wq);
+    const xs = try r.a.alloc(f64, m * k);
+    for (0..m) |row| {
+        for (0..k) |i| xs[row * k + i] = bf(x[row * k + i]) * @as(f64, @floatCast(@as(f16, @bitCast(suh[i]))));
+    }
+    exl3fmt.rotate(xs, m, k, 1);
+    const xh = try r.a.alloc(f16, m * k);
+    for (xh, xs) |*o, v| o.* = @floatCast(v);
+    const ypre = try r.a.alloc(f64, m * n); // [n][m], rotated along n
+    @memset(ypre, 0);
+    const s1 = try r.a.alloc(f64, m * n); // each output's sum of |xh * wq| over k
+    @memset(s1, 0);
+    var xv: [1000]f64 = undefined;
+    var xa: [1000]f64 = undefined;
+    for (0..k) |ki| {
+        for (0..m) |row| {
+            xv[row] = @floatCast(xh[row * k + ki]);
+            xa[row] = @abs(xv[row]);
+        }
+        for (0..n) |col| {
+            const wv: f64 = @floatCast(wq[ki * n + col]);
+            const wa = @abs(wv);
+            const base = col * m;
+            for (0..m) |row| {
+                ypre[base + row] += xv[row] * wv;
+                s1[base + row] += xa[row] * wa;
+            }
+        }
+    }
+    exl3fmt.rotate(ypre, n, m, 0);
+    const want = try r.a.alloc(f64, m * n);
+    const tol = try r.a.alloc(f64, m * n);
+    for (0..n) |col| {
+        const scale: f64 = @floatCast(@as(f16, @bitCast(svh[col])));
+        for (0..m) |row| {
+            want[row * n + col] = ypre[col * m + row] * scale;
+            // bf16 output ulp (2^-7 of the value) plus fp32 accumulation and fp16 xh cases, 2^-11 of the |t| sum
+            tol[row * n + col] = @abs(want[row * n + col]) / 128 + s1[row * n + col] / 2048 + 1e-30;
+        }
+    }
+    return .{ .want = want, .tol = tol };
+}
diff --git a/zig/tests/cuda/exl3_experts_f64_tests.zig b/zig/tests/cuda/exl3_experts_f64_tests.zig
new file mode 100644
index 00000000..6e0c162c
--- /dev/null
+++ b/zig/tests/cuda/exl3_experts_f64_tests.zig
@@ -0,0 +1,463 @@
+//! The EXL3 routed experts' float64 reference: the mirrored chain and each output's worst-case error bound.
+const std = @import("std");
+const check = @import("check.zig");
+const quant_ref_tests = @import("quant_ref_tests.zig");
+const cuda = @import("cuda");
+const exl3fmt = @import("core").exl3_format;
+const exl3e = cuda.exl3_experts;
+const exl3t = @import("exl3_tests.zig");
+const Rig = quant_ref_tests.RigT;
+const bf = quant_ref_tests.helpers.bfOf;
+const Run = exl3t.Run;
+
+pub const E = 9; // experts of a synthetic layer
+pub const D = 512; // model width
+const I = 256; // expert width
+pub const SLOTS = 8;
+const LIMIT: f32 = 10.0; // the SwiGLU clamp
+const CAP = 300; // rows of x, pick and wts the builders make (the f64 checks use the first 128)
+const rows = [_]usize{ 1, 3, 8, 16, 17, 64, 128 }; // the f64 checks' row counts (the reference builds 128 rows)
+
+const f64_ids = [_][]const u8{ "exl3.experts.f64.mul1.4", "exl3.experts.f64.mul1.5", "exl3.experts.f64.mul1.6" };
+
+/// One synthetic layer: the device tensors, the host trellises the reference unpacks, and the seeded routing.
+pub const Built = struct {
+    layer: exl3e.Layer,
+    bits: []const u32,
+    gate: [E][]i16,
+    up: [E][]i16,
+    down: [E][]i16,
+    suh_g: []u16, // fp16 [E, D]
+    suh_u: []u16,
+    svh_g: []u16, // fp16 [E, I]
+    svh_u: []u16,
+    suh_d: []u16, // fp16 [E, I]
+    svh_d: []u16, // fp16 [E, D]
+    dx: u64,
+    dpick: u64,
+    dwts: u64,
+    x: []u16, // bf16 [CAP, D]
+    pick: []i32, // [CAP, SLOTS]
+    wts: []f32, // [CAP, SLOTS]
+};
+
+/// The f64 id checks: every width alone, then the mixed layer folded into the .6 id (the contract's ids).
+pub fn checks(r: *Rig, exp: *const exl3e.Experts, state: *Run) void {
+    for (f64_ids, 0..) |id, i| {
+        var ok = true;
+        f64Check(r, exp, &allBits(@intCast(i + 4))) catch |e| {
+            state.fail(e, id);
+            ok = false;
+        };
+        if (ok) check.pass("{s}", .{id});
+    }
+    {
+        var ok = true;
+        f64Check(r, exp, &.{ 4, 5, 6, 4, 5, 6, 4, 5, 6 }) catch |e| {
+            state.fail(e, f64_ids[2]);
+            ok = false;
+        };
+        if (ok) check.pass("{s}", .{f64_ids[2]});
+    }
+}
+
+fn allBits(bits: u32) [E]u32 {
+    return .{ bits, bits, bits, bits, bits, bits, bits, bits, bits };
+}
+
+fn widthOf(bits: u32) exl3fmt.Width {
+    return .{ .halves = @intCast(2 * bits) };
+}
+
+fn f16v(v: u16) f64 {
+    return @floatCast(@as(f16, @bitCast(v)));
+}
+
+/// bf16 round-to-nearest-even of an f64 (the kernel rounds its fp32 value; the double round is within the tolerance).
+fn bf16r(v: f64) f64 {
+    const u: u32 = @bitCast(@as(f32, @floatCast(v)));
+    return bf(@intCast((u + 0x7fff + ((u >> 16) & 1)) >> 16));
+}
+
+pub fn buildLayer(r: *Rig, bits: []const u32) !Built {
+    var b: Built = .{
+        .layer = undefined,
+        .bits = bits,
+        .gate = undefined,
+        .up = undefined,
+        .down = undefined,
+        .dx = 0,
+        .dpick = 0,
+        .dwts = 0,
+        .suh_g = undefined,
+        .suh_u = undefined,
+        .svh_g = undefined,
+        .svh_u = undefined,
+        .suh_d = undefined,
+        .svh_d = undefined,
+        .x = undefined,
+        .pick = undefined,
+        .wts = undefined,
+    };
+    var gate_p: [E]u64 = undefined;
+    var up_p: [E]u64 = undefined;
+    var down_p: [E]u64 = undefined;
+    var gk2: [E]i32 = undefined;
+    var uk2: [E]i32 = undefined;
+    var dk2: [E]i32 = undefined;
+    const suh_g = try r.a.alloc(u16, E * D);
+    const suh_u = try r.a.alloc(u16, E * D);
+    const svh_g = try r.a.alloc(u16, E * I);
+    const svh_u = try r.a.alloc(u16, E * I);
+    const suh_d = try r.a.alloc(u16, E * I);
+    const svh_d = try r.a.alloc(u16, E * D);
+    for (0..E) |e| {
+        b.gate[e] = try randI16(r, (D / 16) * (I / 16) * widthOf(bits[e]).tileWords());
+        b.up[e] = try randI16(r, (D / 16) * (I / 16) * widthOf(bits[e]).tileWords());
+        b.down[e] = try randI16(r, (I / 16) * (D / 16) * widthOf(bits[e]).tileWords());
+        gate_p[e] = try r.dev(std.mem.sliceAsBytes(b.gate[e]));
+        up_p[e] = try r.dev(std.mem.sliceAsBytes(b.up[e]));
+        down_p[e] = try r.dev(std.mem.sliceAsBytes(b.down[e]));
+        gk2[e] = @intCast(2 * bits[e]);
+        uk2[e] = gk2[e];
+        dk2[e] = gk2[e];
+        randScale(r, suh_g[e * D ..][0..D]);
+        randScale(r, suh_u[e * D ..][0..D]);
+        randScale(r, svh_g[e * I ..][0..I]);
+        randScale(r, svh_u[e * I ..][0..I]);
+        randScale(r, suh_d[e * I ..][0..I]);
+        randScale(r, svh_d[e * D ..][0..D]);
+    }
+    b.suh_g = suh_g;
+    b.suh_u = suh_u;
+    b.svh_g = svh_g;
+    b.svh_u = svh_u;
+    b.suh_d = suh_d;
+    b.svh_d = svh_d;
+    b.layer = .{
+        .gate = try r.dev(std.mem.sliceAsBytes(gate_p[0..])),
+        .up = try r.dev(std.mem.sliceAsBytes(up_p[0..])),
+        .down = try r.dev(std.mem.sliceAsBytes(down_p[0..])),
+        .gate_k2 = try r.dev(std.mem.sliceAsBytes(gk2[0..])),
+        .up_k2 = try r.dev(std.mem.sliceAsBytes(uk2[0..])),
+        .down_k2 = try r.dev(std.mem.sliceAsBytes(dk2[0..])),
+        .suh_g = try r.dev(std.mem.sliceAsBytes(suh_g)),
+        .suh_u = try r.dev(std.mem.sliceAsBytes(suh_u)),
+        .svh_g = try r.dev(std.mem.sliceAsBytes(svh_g)),
+        .svh_u = try r.dev(std.mem.sliceAsBytes(svh_u)),
+        .suh_d = try r.dev(std.mem.sliceAsBytes(suh_d)),
+        .svh_d = try r.dev(std.mem.sliceAsBytes(svh_d)),
+        .experts = E,
+        .dims = D,
+        .width = I,
+        .codebook = .mul1,
+        .limit = LIMIT,
+        .act_mode = 0,
+    };
+    b.x = try r.bfs(CAP * D, 0.5); // half-range x, with the small scales, keeps the SwiGLU inputs moderate
+    b.pick = try picks(r, CAP);
+    b.wts = try wtsOf(r, CAP);
+    b.dx = try r.dev(std.mem.sliceAsBytes(b.x));
+    b.dpick = try r.dev(std.mem.sliceAsBytes(b.pick));
+    b.dwts = try r.dev(std.mem.sliceAsBytes(b.wts));
+    return b;
+}
+
+fn randI16(r: *Rig, n: usize) ![]i16 {
+    const out = try r.a.alloc(i16, n);
+    for (out) |*v| v.* = r.rng.int(i16);
+    return out;
+}
+
+/// Small scales (with the half-range x): the |t||w| sums and the SwiGLU inputs stay moderate for the bound.
+fn randScale(r: *Rig, out: []u16) void {
+    for (out) |*v| v.* = @bitCast(@as(f16, @floatCast(r.rng.float(f32) * 0.25 - 0.125)));
+}
+
+/// Distinct experts a row: a partial Fisher-Yates over the layer's experts, seeded.
+fn picks(r: *Rig, cap: usize) ![]i32 {
+    const out = try r.a.alloc(i32, cap * SLOTS);
+    for (0..cap) |row| {
+        var idx: [E]u32 = undefined;
+        for (0..E, 0..) |_, i| idx[i] = @intCast(i);
+        var n: usize = E;
+        for (0..SLOTS) |k| {
+            const j = r.rng.uintLessThan(usize, n);
+            out[row * SLOTS + k] = @intCast(idx[j]);
+            idx[j] = idx[n - 1];
+            n -= 1;
+        }
+    }
+    return out;
+}
+
+fn wtsOf(r: *Rig, cap: usize) ![]f32 {
+    const out = try r.a.alloc(f32, cap * SLOTS);
+    for (out) |*v| v.* = 0.1 + 0.9 * r.rng.float(f32);
+    return out;
+}
+
+/// One routed call over `rows` rows starting at row 0 of the built routing; the scratch and out are fresh canaries.
+pub fn runRows(r: *Rig, exp: *const exl3e.Experts, b: *const Built, rows_n: usize) !u64 {
+    return (try runSlice(r, exp, b.layer, b.dx, b.dpick, b.dwts, rows_n)).out;
+}
+
+pub fn runSlice(r: *Rig, exp: *const exl3e.Experts, layer: exl3e.Layer, x: u64, pick: u64, wts: u64, rows_n: usize) !struct { out: u64, y: u64 } {
+    const sb = try r.zeros(try exl3e.scratchBytes(layer, rows_n, SLOTS));
+    const sc = try exl3e.scratch(sb, layer, rows_n, SLOTS);
+    const out = try r.zeros(rows_n * D * 4);
+    try exp.run(r.s, layer, x, D, .bf16, pick, wts, rows_n, out, sc);
+    return .{ .out = out, .y = sc.y };
+}
+
+fn f64Check(r: *Rig, exp: *const exl3e.Experts, bits: []const u32) !void {
+    const b = try buildLayer(r, bits);
+    const want = try reference(r, &b, 128);
+    for (rows) |m| try closeOut(r, b.bits, m, (try runRows(r, exp, &b, m)), want.want, want.tol);
+}
+
+/// fp32 outputs within the f64 reference's tolerance, with the exact FAIL line.
+fn closeOut(r: *Rig, bits: []const u32, m: usize, ptr: u64, want: []const f64, tol: []const f64) !void {
+    const raw = try r.back(ptr, m * D * 4);
+    var most: f64 = 0;
+    var at: usize = 0;
+    for (want[0 .. m * D], tol[0 .. m * D], 0..) |wv, t, i| {
+        const g: f64 = @floatCast(std.mem.bytesToValue(f32, raw[4 * i ..][0..4]));
+        const q = @abs(g - wv) / t;
+        if (q > most) {
+            most = q;
+            at = i;
+        }
+    }
+    std.debug.print("RESULT exl3.experts.f64.mul1.{d} m={d}: largest difference {d:.3} of its tolerance (element {d})\n", .{ bits[0], m, most, at });
+    if (most > 1) {
+        std.debug.print("FAIL exl3.experts.f64.mul1.{d}: largest difference {d:.3} of its tolerance\n", .{ bits[0], most });
+        return error.TestFailed;
+    }
+}
+
+/// A 300-row chunk against the f64 reference (the mixed-width layer).
+pub fn prompt(r: *Rig, exp: *const exl3e.Experts) !void {
+    var bits: [E]u32 = .{ 4, 5, 6, 4, 5, 6, 4, 5, 6 };
+    const b = try buildLayer(r, &bits);
+    const want = try reference(r, &b, 300);
+    const res = try runRows(r, exp, &b, 300);
+    const raw = try r.back(res, 300 * D * 4);
+    var most: f64 = 0;
+    var at: usize = 0;
+    for (want.want, want.tol, 0..) |wv, t, i| {
+        const g: f64 = @floatCast(std.mem.bytesToValue(f32, raw[4 * i ..][0..4]));
+        const q = @abs(g - wv) / t;
+        if (q > most) {
+            most = q;
+            at = i;
+        }
+    }
+    std.debug.print("RESULT exl3.prompt.experts.f64: largest difference {d:.3} of its tolerance (element {d})\n", .{ most, at });
+    if (most > 1) return error.TestFailed;
+}
+
+/// The f64 reference: the kernel's chain mirrored in f64, each output's error its per-element worst case.
+fn reference(r: *Rig, b: *const Built, rows_n: usize) !struct { want: []f64, tol: []f64 } {
+    const p = rows_n * SLOTS;
+    // xg: fp16((x * suh_g) @ H) per slot; |xg| and its error <= V, the block's sum of |x * suh| over sqrt(128)
+    const xs = try r.a.alloc(f64, p * D);
+    for (0..p) |s0| {
+        const ex: usize = @intCast(b.pick[s0]);
+        for (0..D) |i| xs[s0 * D + i] = bf(b.x[(s0 / SLOTS) * D + i]) * f16v(b.suh_g[ex * D + i]);
+    }
+    exl3fmt.rotate(xs, p, D, 1);
+    const xg = try r.a.alloc(f16, p * D);
+    for (xg, xs) |*o, v| o.* = @floatCast(v);
+    const xgerr = try r.a.alloc(f64, p * D);
+    for (xgerr, xs) |*o, v| o.* = @abs(v);
+    absRotateCols(xgerr, p, D);
+    for (xgerr) |*v| v.* *= 1.0 / 2048.0 + 8.0 / 16777216.0; // the fp16 rounding (2^-11) plus the fp32 rotation's (8 * 2^-24), both of V
+
+    const wq = try r.a.alloc(f16, @max(D, I) * @max(D, I));
+    const zg = try r.a.alloc(f64, I * p); // [n][p]
+    const zu = try r.a.alloc(f64, I * p);
+    const s1g = try r.a.alloc(f64, I * p);
+    const s1u = try r.a.alloc(f64, I * p);
+    const eg = try r.a.alloc(f64, I * p); // the GEMM's propagated input error, before the output rotation
+    const eu = try r.a.alloc(f64, I * p);
+    @memset(zg, 0);
+    @memset(zu, 0);
+    @memset(s1g, 0);
+    @memset(s1u, 0);
+    @memset(eg, 0);
+    @memset(eu, 0);
+    for (0..E) |ex| {
+        exl3fmt.unpack(widthOf(b.bits[ex]), .mul1, b.gate[ex], D / 16, I / 16, wq[0 .. D * I]);
+        for (0..p) |s0| {
+            if (b.pick[s0] != @as(i32, @intCast(ex))) continue;
+            gemmK(xg[s0 * D ..][0..D], wq, zg[s0..], s1g[s0..], eg[s0..], xgerr[s0 * D ..][0..D], D, I, p);
+        }
+        exl3fmt.unpack(widthOf(b.bits[ex]), .mul1, b.up[ex], D / 16, I / 16, wq[0 .. D * I]);
+        for (0..p) |s0| {
+            if (b.pick[s0] != @as(i32, @intCast(ex))) continue;
+            gemmK(xg[s0 * D ..][0..D], wq, zu[s0..], s1u[s0..], eu[s0..], xgerr[s0 * D ..][0..D], D, I, p);
+        }
+    }
+    // the fp16 rounding (2^-11) and the fp32 accumulation (2^-17 of 128 roundings), both on the |t||w| sum
+    for (eg, s1g) |*e, s| e.* += s * (1.0 / 2048.0 + 1.0 / 131072.0);
+    for (eu, s1u) |*e, s| e.* += s * (1.0 / 2048.0 + 1.0 / 131072.0);
+    exl3fmt.rotate(zg, I, p, 0);
+    exl3fmt.rotate(zu, I, p, 0);
+    // the output Hadamard: worst case is the block's sum of |errors| over sqrt(128), plus the fp32 rotation's own
+    absRotate(eg, I, p);
+    absRotate(eu, I, p);
+    const zgerr = try r.a.alloc(f64, I * p);
+    for (zgerr, zg) |*o, v| o.* = @abs(v);
+    absRotate(zgerr, I, p);
+    for (zgerr) |*v| v.* *= 8.0 / 16777216.0;
+    const zuerr = try r.a.alloc(f64, I * p);
+    for (zuerr, zu) |*o, v| o.* = @abs(v);
+    absRotate(zuerr, I, p);
+    for (zuerr) |*v| v.* *= 8.0 / 16777216.0;
+    for (eg, zgerr) |*e, v| e.* += v;
+    for (eu, zuerr) |*e, v| e.* += v;
+
+    // the SwiGLU (bf16 roundings, f64 exp): g's error is the rotated GEMM error through svh plus a bf16 double rounding
+    const v = try r.a.alloc(f64, I * p);
+    const verr = try r.a.alloc(f64, I * p);
+    for (0..I) |n| {
+        for (0..p) |s0| {
+            const ex: usize = @intCast(b.pick[s0]);
+            const vg = zg[n * p + s0] * f16v(b.svh_g[ex * I + n]);
+            const gg = @min(bf16r(vg), @as(f64, LIMIT));
+            const vu = zu[n * p + s0] * f16v(b.svh_u[ex * I + n]);
+            const uu = @min(@max(bf16r(vu), -@as(f64, LIMIT)), @as(f64, LIMIT));
+            const inner = bf16r(gg / (1.0 + std.math.exp(-gg)));
+            const act = bf16r(inner * uu);
+            v[n * p + s0] = act * f16v(b.suh_d[ex * I + n]);
+            const egk = eg[n * p + s0] * @abs(f16v(b.svh_g[ex * I + n])) + (@abs(vg) + @abs(gg)) / 256;
+            const euk = eu[n * p + s0] * @abs(f16v(b.svh_u[ex * I + n])) + (@abs(vu) + @abs(uu)) / 256;
+            const einner = egk + (@abs(gg) + 1) / 524288 + @abs(inner) / 256;
+            verr[n * p + s0] = (@abs(uu) * einner + @abs(inner) * euk + @abs(act) / 256) * @abs(f16v(b.suh_d[ex * I + n])) +
+                @abs(v[n * p + s0]) / 16777216; // act's: |silu'| (<= 1) g's, |silu(g)| (<= |g|) u's, expf and roundings
+        }
+    }
+    // the down input: the fp32 rotation's roundings (of the block's sum of |v|) and the fp16 store (2^-11)
+    exl3fmt.rotate(v, I, p, 0);
+    absRotate(verr, I, p);
+    const vrot = try r.a.alloc(f64, I * p);
+    for (vrot, v) |*o, val| o.* = @abs(val);
+    absRotate(vrot, I, p);
+    for (vrot) |*o| o.* *= 8.0 / 16777216.0;
+    const xd = try r.a.alloc(f16, p * I);
+    const xderr = try r.a.alloc(f64, p * I);
+    for (0..p) |s0| {
+        for (0..I) |ki| {
+            xd[s0 * I + ki] = @floatCast(v[ki * p + s0]);
+            xderr[s0 * I + ki] = verr[ki * p + s0] + vrot[ki * p + s0] + @abs(xd[s0 * I + ki]) / 2048;
+        }
+    }
+
+    // down: the GEMM, its |t| and |w| sums, and the propagated input error
+    const zd = try r.a.alloc(f64, D * p); // [d][p]
+    const s1d = try r.a.alloc(f64, D * p);
+    const de = try r.a.alloc(f64, D * p);
+    @memset(zd, 0);
+    @memset(s1d, 0);
+    @memset(de, 0);
+    for (0..E) |ex| {
+        exl3fmt.unpack(widthOf(b.bits[ex]), .mul1, b.down[ex], I / 16, D / 16, wq[0 .. I * D]);
+        for (0..p) |s0| {
+            if (b.pick[s0] != @as(i32, @intCast(ex))) continue;
+            for (0..I) |ki| {
+                const t: f64 = @floatCast(xd[s0 * I + ki]);
+                const ta = @abs(t);
+                const row = wq[ki * D ..][0..D];
+                const xek = xderr[s0 * I + ki];
+                for (0..D) |d| {
+                    const wv: f64 = @floatCast(row[d]);
+                    zd[d * p + s0] += t * wv;
+                    s1d[d * p + s0] += ta * @abs(wv);
+                    de[d * p + s0] += @abs(wv) * xek;
+                }
+            }
+        }
+    }
+    // the fp16 xd rounding (2^-11 of the |t||w| sum) and the fp32 accumulation (2^-17), then the output Hadamard's mix
+    for (de, s1d) |*e, s| e.* += s * (1.0 / 2048.0 + 1.0 / 131072.0);
+    exl3fmt.rotate(zd, D, p, 0);
+    absRotate(de, D, p);
+    const zderr = try r.a.alloc(f64, D * p);
+    for (zderr, zd) |*o, val| o.* = @abs(val);
+    absRotate(zderr, D, p);
+    for (zderr) |*o| o.* *= 8.0 / 16777216.0;
+    for (de, zderr) |*e, val| e.* += val;
+
+    // the per-slot outputs and the weighted combine: the fp32 fma chain (8 roundings of the running sum) and the store
+    const want = try r.a.alloc(f64, rows_n * D);
+    const tol = try r.a.alloc(f64, rows_n * D);
+    for (0..rows_n) |row| {
+        for (0..D) |d| {
+            var acc: f32 = 0;
+            var err: f64 = 0;
+            var swy: f64 = 0;
+            for (0..SLOTS) |k| {
+                const s0 = row * SLOTS + k;
+                const ex: usize = @intCast(b.pick[s0]);
+                const y: f32 = @floatCast(zd[d * p + s0] * f16v(b.svh_d[ex * D + d]));
+                acc = @mulAdd(f32, b.wts[row * SLOTS + k], y, acc);
+                const yerr = de[d * p + s0] * @abs(f16v(b.svh_d[ex * D + d])) + @abs(y) / 16777216;
+                err += @abs(b.wts[row * SLOTS + k]) * yerr;
+                swy += @abs(b.wts[row * SLOTS + k] * y);
+            }
+            want[row * D + d] = acc;
+            tol[row * D + d] = err + swy / 2097152 + @abs(want[row * D + d]) / 16777216 + 1e-30;
+        }
+    }
+    return .{ .want = want, .tol = tol };
+}
+
+/// One output column's GEMM over k: the sums into [n][p], their |t| sums, the propagated input error.
+fn gemmK(xrow: []const f16, wq: []const f16, z: []f64, s1: []f64, e: []f64, xerr: []const f64, k: usize, n: usize, p: usize) void {
+    for (0..k) |ki| {
+        const t: f64 = @floatCast(xrow[ki]);
+        const ta = @abs(t);
+        const wrow = wq[ki * n ..][0..n];
+        const xek = xerr[ki];
+        for (0..n) |col| {
+            const wv: f64 = @floatCast(wrow[col]);
+            z[col * p] += t * wv;
+            s1[col * p] += ta * @abs(wv);
+            e[col * p] += @abs(wv) * xek;
+        }
+    }
+}
+
+/// Each 128-block along the row axis replaced by the sum of its |entries| over sqrt(128) (the worst case).
+fn absRotate(x: []f64, nrows: usize, cols: usize) void {
+    const inv = 1.0 / @sqrt(@as(f64, 128.0));
+    var r: usize = 0;
+    while (r < nrows) : (r += 128) {
+        for (0..cols) |c| {
+            var s: f64 = 0;
+            for (0..128) |n| s += @abs(x[(r + n) * cols + c]);
+            s *= inv;
+            for (0..128) |n| x[(r + n) * cols + c] = s;
+        }
+    }
+}
+
+test "the ids are the contract's" {
+    try std.testing.expectEqualStrings("exl3.experts.f64.mul1.4", f64_ids[0]);
+    try std.testing.expectEqualStrings("exl3.experts.f64.mul1.6", f64_ids[2]);
+}
+
+/// The column-axis twin: each 128-run along the columns replaced by the sum of its |entries| over sqrt(128).
+fn absRotateCols(x: []f64, nrows: usize, cols: usize) void {
+    const inv = 1.0 / @sqrt(@as(f64, 128.0));
+    for (0..nrows) |row| {
+        var c: usize = 0;
+        while (c < cols) : (c += 128) {
+            var s: f64 = 0;
+            for (0..128) |n| s += @abs(x[row * cols + c + n]);
+            s *= inv;
+            for (0..128) |n| x[row * cols + c + n] = s;
+        }
+    }
+}
diff --git a/zig/tests/cuda/exl3_experts_tests.zig b/zig/tests/cuda/exl3_experts_tests.zig
new file mode 100644
index 00000000..20710d30
--- /dev/null
+++ b/zig/tests/cuda/exl3_experts_tests.zig
@@ -0,0 +1,197 @@
+//! The EXL3 routed experts: the f64 checks, row and chunk invariance, and the Python engine's recorded bytes.
+const std = @import("std");
+const check = @import("check.zig");
+const quant_ref_tests = @import("quant_ref_tests.zig");
+const cuda = @import("cuda");
+const exl3 = cuda.exl3;
+const exl3e = cuda.exl3_experts;
+const exl3t = @import("exl3_tests.zig");
+const ref = @import("exl3_experts_f64_tests.zig");
+const Rig = quant_ref_tests.RigT;
+const Run = exl3t.Run;
+
+pub fn run(r: *Rig, state: *Run, dir: []const u8) !void {
+    var exp = try exl3e.Experts.load(r.gpu.d);
+    defer exp.unload();
+
+    // every expert one width: 4, 5 and 6 bits (the mixed run folds into .6)
+    ref.checks(r, &exp, state);
+    {
+        var ok = true;
+        rowsInvariant(r, &exp) catch |e| {
+            state.fail(e, "exl3.experts.rows");
+            ok = false;
+        };
+        if (ok) check.pass("exl3.experts.rows", .{});
+    }
+    {
+        var ok = true;
+        ref.prompt(r, &exp) catch |e| {
+            state.fail(e, "exl3.prompt.experts.f64");
+            ok = false;
+        };
+        if (ok) check.pass("exl3.prompt.experts.f64", .{});
+    }
+    {
+        var ok = true;
+        chunks(r, &exp) catch |e| {
+            state.fail(e, "exl3.prompt.experts.chunks");
+            ok = false;
+        };
+        if (ok) check.pass("exl3.prompt.experts.chunks", .{});
+    }
+    {
+        var ok = true;
+        python(r, &exp, dir, state) catch |e| {
+            state.fail(e, "exl3.experts.python");
+            ok = false;
+        };
+        if (ok) check.pass("exl3.experts.python", .{});
+    }
+}
+
+/// A row's output bytes are its own: solo, with 3 rows, in 64-row batches, shared or not.
+fn rowsInvariant(r: *Rig, exp: *const exl3e.Experts) !void {
+    var bits: [ref.E]u32 = .{ 6, 4, 5, 6, 4, 5, 6, 4, 5 };
+    const b = try ref.buildLayer(r, &bits);
+    const solo = try r.back(try ref.runRows(r, exp, &b, 1), ref.D * 4);
+    // 3 rows: two more rows on the same picks as row 0
+    const p3 = try r.a.alloc(i32, 3 * ref.SLOTS);
+    @memcpy(p3[0 .. 2 * ref.SLOTS], b.pick[0 .. 2 * ref.SLOTS]);
+    @memcpy(p3[2 * ref.SLOTS ..], b.pick[0..ref.SLOTS]);
+    const w3 = try r.a.alloc(f32, 3 * ref.SLOTS);
+    @memcpy(w3, b.wts[0 .. 3 * ref.SLOTS]);
+    const got3 = try r.back((try ref.runSlice(r, exp, b.layer, b.dx, try r.dev(std.mem.sliceAsBytes(p3)), try r.dev(std.mem.sliceAsBytes(w3)), 3)).out, ref.D * 4);
+    try check.sameBytes("exl3.experts.rows 3 rows", got3, solo);
+    // 64 rows: the others share row 0's experts (the same picks), or run their own
+    const p64 = try r.a.alloc(i32, 64 * ref.SLOTS);
+    const w64 = try r.a.alloc(f32, 64 * ref.SLOTS);
+    @memcpy(p64[0..ref.SLOTS], b.pick[0..ref.SLOTS]);
+    @memcpy(w64[0..ref.SLOTS], b.wts[0..ref.SLOTS]);
+    for (1..64) |row| {
+        @memcpy(p64[row * ref.SLOTS ..][0..ref.SLOTS], b.pick[0..ref.SLOTS]);
+        @memcpy(w64[row * ref.SLOTS ..][0..ref.SLOTS], b.wts[0..ref.SLOTS]);
+    }
+    const shared = try r.back((try ref.runSlice(r, exp, b.layer, b.dx, try r.dev(std.mem.sliceAsBytes(p64)), try r.dev(std.mem.sliceAsBytes(w64)), 64)).out, ref.D * 4);
+    try check.sameBytes("exl3.experts.rows 64 rows shared", shared[0 .. ref.D * 4], solo);
+    const own = try r.back((try ref.runSlice(r, exp, b.layer, b.dx, b.dpick, b.dwts, 64)).out, ref.D * 4);
+    try check.sameBytes("exl3.experts.rows 64 rows own", own[0 .. ref.D * 4], solo);
+    // and a 64-row batch whose other rows interleave with row 0's experts in both orders
+    const p64b = try r.a.alloc(i32, 64 * ref.SLOTS);
+    const w64b = try r.a.alloc(f32, 64 * ref.SLOTS);
+    @memcpy(p64b[0..ref.SLOTS], b.pick[0..ref.SLOTS]);
+    @memcpy(w64b[0..ref.SLOTS], b.wts[0..ref.SLOTS]);
+    for (1..64) |row| {
+        const src = if (row % 2 == 0) @as(usize, 0) else row % ref.SLOTS;
+        @memcpy(p64b[row * ref.SLOTS ..][0..ref.SLOTS], b.pick[src * ref.SLOTS ..][0..ref.SLOTS]);
+        @memcpy(w64b[row * ref.SLOTS ..][0..ref.SLOTS], b.wts[src * ref.SLOTS ..][0..ref.SLOTS]);
+    }
+    const mixed = try r.back((try ref.runSlice(r, exp, b.layer, b.dx, try r.dev(std.mem.sliceAsBytes(p64b)), try r.dev(std.mem.sliceAsBytes(w64b)), 64)).out, ref.D * 4);
+    try check.sameBytes("exl3.experts.rows 64 rows mixed", mixed[0 .. ref.D * 4], solo);
+}
+
+/// The same 300 rows as one call, split at 128 and at 37: a row's bytes never move.
+fn chunks(r: *Rig, exp: *const exl3e.Experts) !void {
+    var bits: [ref.E]u32 = .{ 4, 5, 6, 4, 5, 6, 4, 5, 6 };
+    const b = try ref.buildLayer(r, &bits);
+    const whole = try r.back(try ref.runRows(r, exp, &b, 300), 300 * ref.D * 4);
+    var at: usize = 0;
+    while (at < 300) : (at += 128) {
+        const n: usize = @min(300 - at, 128);
+        const res = try ref.runSlice(r, exp, b.layer, b.dx + @as(u64, at) * ref.D * 2, b.dpick + @as(u64, at) * ref.SLOTS * 4, b.dwts + @as(u64, at) * ref.SLOTS * 4, n);
+        const got = try r.back(res.out, n * ref.D * 4);
+        try check.sameBytes("exl3.prompt.experts.chunks 128", got, whole[at * ref.D * 4 ..][0 .. n * ref.D * 4]);
+    }
+    at = 0;
+    while (at < 300) : (at += 37) {
+        const n: usize = @min(300 - at, 37);
+        const res = try ref.runSlice(r, exp, b.layer, b.dx + @as(u64, at) * ref.D * 2, b.dpick + @as(u64, at) * ref.SLOTS * 4, b.dwts + @as(u64, at) * ref.SLOTS * 4, n);
+        const got = try r.back(res.out, n * ref.D * 4);
+        try check.sameBytes("exl3.prompt.experts.chunks 37", got, whole[at * ref.D * 4 ..][0 .. n * ref.D * 4]);
+    }
+}
+
+/// The Python engine's recorded y and out, bit for bit (exl3_oracle_experts.py's manifest and raw files).
+fn python(r: *Rig, exp: *const exl3e.Experts, dir: []const u8, state: *Run) !void {
+    if (std.mem.eql(u8, dir, "none")) {
+        std.debug.print("SKIP exl3.experts.python\n", .{});
+        return;
+    }
+    const manifest_path = try std.fs.path.join(r.a, &.{ dir, "manifest.json" });
+    const text = std.Io.Dir.cwd().readFileAlloc(r.gpu.io, manifest_path, r.a, .limited(1 << 24)) catch |e| {
+        std.debug.print("FAIL exl3.experts.python: {t}\n", .{e});
+        state.failed = true;
+        return;
+    };
+    var parsed = try std.json.parseFromSlice(std.json.Value, r.a, text, .{});
+    const o = parsed.value.object.get("experts").?.object;
+    const e_count: usize = @intCast(o.get("count").?.integer);
+    const dims: usize = @intCast(o.get("dims").?.integer);
+    const width: usize = @intCast(o.get("width").?.integer);
+    const slots: usize = @intCast(o.get("slots").?.integer);
+    const cb: exl3.Codebook = if (std.mem.eql(u8, o.get("codebook").?.string, "mcg"))
+        .mcg
+    else if (std.mem.eql(u8, o.get("codebook").?.string, "inst3"))
+        .inst3
+    else
+        .mul1;
+    const trellis = o.get("trellis").?.object;
+    var gate_p = try r.a.alloc(u64, e_count);
+    var up_p = try r.a.alloc(u64, e_count);
+    var down_p = try r.a.alloc(u64, e_count);
+    var gk2 = try r.a.alloc(i32, e_count);
+    var uk2 = try r.a.alloc(i32, e_count);
+    var dk2 = try r.a.alloc(i32, e_count);
+    for (o.get("gate_k2").?.array.items, 0..) |v, i| gk2[i] = @intCast(v.integer);
+    for (o.get("up_k2").?.array.items, 0..) |v, i| uk2[i] = @intCast(v.integer);
+    for (o.get("down_k2").?.array.items, 0..) |v, i| dk2[i] = @intCast(v.integer);
+    for (0..e_count) |i| {
+        gate_p[i] = try r.dev(try readFile(r, dir, trellis.get("gate").?.array.items[i].string));
+        up_p[i] = try r.dev(try readFile(r, dir, trellis.get("up").?.array.items[i].string));
+        down_p[i] = try r.dev(try readFile(r, dir, trellis.get("down").?.array.items[i].string));
+    }
+    const layer: exl3e.Layer = .{
+        .gate = try r.dev(std.mem.sliceAsBytes(gate_p)),
+        .up = try r.dev(std.mem.sliceAsBytes(up_p)),
+        .down = try r.dev(std.mem.sliceAsBytes(down_p)),
+        .gate_k2 = try r.dev(std.mem.sliceAsBytes(gk2)),
+        .up_k2 = try r.dev(std.mem.sliceAsBytes(uk2)),
+        .down_k2 = try r.dev(std.mem.sliceAsBytes(dk2)),
+        .suh_g = try r.dev(try readFile(r, dir, o.get("suh_g").?.string)),
+        .suh_u = try r.dev(try readFile(r, dir, o.get("suh_u").?.string)),
+        .svh_g = try r.dev(try readFile(r, dir, o.get("svh_g").?.string)),
+        .svh_u = try r.dev(try readFile(r, dir, o.get("svh_u").?.string)),
+        .suh_d = try r.dev(try readFile(r, dir, o.get("suh_d").?.string)),
+        .svh_d = try r.dev(try readFile(r, dir, o.get("svh_d").?.string)),
+        .experts = e_count,
+        .dims = dims,
+        .width = width,
+        .codebook = cb,
+        .limit = @floatCast(o.get("limit").?.float),
+        .act_mode = @intCast(o.get("act_mode").?.integer),
+    };
+    const xmap = o.get("x").?.object;
+    const pickmap = o.get("pick").?.object;
+    const wtsmap = o.get("wts").?.object;
+    const ymap = o.get("y").?.object;
+    const outmap = o.get("out").?.object;
+    for (o.get("rows").?.array.items) |rv| {
+        const m: usize = @intCast(rv.integer);
+        const key = try std.fmt.allocPrint(r.a, "{d}", .{m});
+        const dx = try r.dev(try readFile(r, dir, xmap.get(key).?.string));
+        const dpick = try r.dev(try readFile(r, dir, pickmap.get(key).?.string));
+        const dwts = try r.dev(try readFile(r, dir, wtsmap.get(key).?.string));
+        const sb = try r.zeros(try exl3e.scratchBytes(layer, m, slots));
+        const sc = try exl3e.scratch(sb, layer, m, slots);
+        const out = try r.zeros(m * dims * 4);
+        try exp.run(r.s, layer, dx, dims, .bf16, dpick, dwts, m, out, sc);
+        const got_y = try r.back(sc.y, m * slots * dims * 4);
+        try check.sameBytes("exl3.experts.python y", got_y, try readFile(r, dir, ymap.get(key).?.string));
+        const got_out = try r.back(out, m * dims * 4);
+        try check.sameBytes("exl3.experts.python out", got_out, try readFile(r, dir, outmap.get(key).?.string));
+    }
+}
+
+fn readFile(r: *Rig, dir: []const u8, name: []const u8) ![]u8 {
+    return std.Io.Dir.cwd().readFileAlloc(r.gpu.io, try std.fs.path.join(r.a, &.{ dir, name }), r.a, .limited(1 << 32));
+}
diff --git a/zig/tests/cuda/exl3_layer_tests.zig b/zig/tests/cuda/exl3_layer_tests.zig
new file mode 100644
index 00000000..4282f83e
--- /dev/null
+++ b/zig/tests/cuda/exl3_layer_tests.zig
@@ -0,0 +1,156 @@
+//! EXL3 whole layers: a KDA and a DSA MoE layer of real RED-SNOW through core/exl3_load vs the engine's fixture bytes.
+const std = @import("std");
+const cuda = @import("cuda");
+const check = @import("check.zig");
+const quant_ref_tests = @import("quant_ref_tests.zig");
+const exl3_load = @import("core").exl3_load;
+const exl3 = cuda.exl3;
+const exl3e = cuda.exl3_experts;
+const exl3_upload = cuda.exl3_upload;
+const exl3_tests = @import("exl3_tests.zig");
+const Run = exl3_tests.Run;
+const Rig = quant_ref_tests.RigT;
+
+pub fn run(r: *Rig, state: *Run, dir: []const u8) !void {
+    if (std.mem.eql(u8, dir, "none")) {
+        std.debug.print("SKIP exl3.layer.python\n", .{});
+        return;
+    }
+    const o = manifest(r, dir) catch |e| {
+        std.debug.print("FAIL exl3.layer.python: {t}\n", .{e});
+        state.failed = true;
+        return;
+    };
+    const layers = o.get("layers") orelse {
+        std.debug.print("SKIP exl3.layer.python: no layers entry\n", .{});
+        return;
+    };
+    const model = o.get("model").?.string;
+    var scan = exl3_load.scan(r.gpu.gpa, r.gpu.io, model) catch |e| {
+        std.debug.print("FAIL exl3.layer.python: {t}\n", .{e});
+        state.failed = true;
+        return;
+    };
+    defer scan.deinit();
+    var idx = std.StringHashMapUnmanaged(usize).empty;
+    for (scan.groups, 0..) |g, i| try idx.put(r.a, g.prefix, i);
+    var dense = try exl3.Dense.load(r.gpu.d);
+    defer dense.unload();
+    var exp = try exl3e.Experts.load(r.gpu.d);
+    defer exp.unload();
+    var ok = true;
+    layerChecks(r, &scan, &idx, &dense, &exp, dir, layers.array.items) catch |e| {
+        state.fail(e, "exl3.layer.python");
+        ok = false;
+    };
+    if (ok) check.pass("exl3.layer.python", .{});
+}
+
+fn layerChecks(r: *Rig, scan: *exl3_load.Scan, idx: *std.StringHashMapUnmanaged(usize), dense: *exl3.Dense, exp: *const exl3e.Experts, dir: []const u8, layers: []std.json.Value) !void {
+    const t0 = check.now(r.gpu.io);
+    var total: usize = 0;
+    for (layers) |item| {
+        const o = item.object;
+        const id = o.get("id").?.string;
+        var up: exl3_upload.Uploader = .{ .d = r.gpu.d, .gpa = r.gpu.gpa };
+        defer up.deinit();
+        for (o.get("groups").?.array.items) |gitem| try denseGroup(r, scan, idx, dense, dir, &up, gitem.object);
+        try expertLayer(r, scan, idx, exp, dir, &up, o.get("experts").?.object);
+        std.debug.print("RESULT exl3.layer.python.{s}: {d:.1} MiB of weights on the device\n", .{ id, @as(f64, @floatFromInt(up.bytes)) / (1 << 20) });
+        total += up.bytes;
+    }
+    const dt = @as(f64, @floatFromInt(check.now(r.gpu.io) - t0)) / 1e9;
+    std.debug.print("RESULT exl3.layer.python: {d} layers, {d:.1} MiB uploaded, {d:.2} s\n", .{ layers.len, @as(f64, @floatFromInt(total)) / (1 << 20), dt });
+}
+
+/// One non-routed group: checkpoint tensors through the uploader, fixture inputs and bytes through the prompt path.
+fn denseGroup(r: *Rig, scan: *exl3_load.Scan, idx: *std.StringHashMapUnmanaged(usize), dense: *exl3.Dense, dir: []const u8, up: *exl3_upload.Uploader, o: std.json.ObjectMap) !void {
+    const name = o.get("name").?.string;
+    const gi = idx.get(name) orelse return error.TestFailed;
+    const g = scan.groups[gi];
+    try check.expect(g.halves == 2 * bitsOf(o.get("bits").?) and g.k == @as(usize, @intCast(o.get("k").?.integer)) and
+        g.n == @as(usize, @intCast(o.get("n").?.integer)), "exl3.layer.python {s}: the checkpoint group is not the fixture's", .{name});
+    const parts = try scan.parts(r.a, gi);
+    const w = try up.dense(parts, g);
+    const xmap = o.get("x").?.object;
+    const ymap = o.get("y").?.object;
+    for (o.get("rows").?.array.items) |rv| {
+        const m: usize = @intCast(rv.integer);
+        const key = try std.fmt.allocPrint(r.a, "{d}", .{m});
+        const dx = try r.dev(try readFile(r, dir, xmap.get(key).?.string));
+        const want = try readFile(r, dir, ymap.get(key).?.string);
+        const dy = try r.zeros(m * g.n * 2);
+        try dense.prompt(r.s, w, dx, .bf16, m, dy, .bf16);
+        const got = try r.back(dy, want.len);
+        try check.sameBytes(try std.fmt.allocPrint(r.a, "exl3.layer.python {s} {d} rows", .{ name, m }), got, want);
+    }
+}
+
+/// One layer's routed experts: all E experts' projections uploaded, the fixture's routing and inputs per row count.
+fn expertLayer(r: *Rig, scan: *exl3_load.Scan, idx: *std.StringHashMapUnmanaged(usize), exp: *const exl3e.Experts, dir: []const u8, up: *exl3_upload.Uploader, o: std.json.ObjectMap) !void {
+    const base = o.get("name").?.string;
+    const e_count: usize = @intCast(o.get("count").?.integer);
+    const dims: usize = @intCast(o.get("dims").?.integer);
+    const width: usize = @intCast(o.get("width").?.integer);
+    const slots: usize = @intCast(o.get("slots").?.integer);
+    var gate = try r.a.alloc(exl3_upload.Proj, e_count);
+    var upj = try r.a.alloc(exl3_upload.Proj, e_count);
+    var down = try r.a.alloc(exl3_upload.Proj, e_count);
+    const shorts = [_][]const u8{ "gate", "up", "down" };
+    const parts_names = [_][]const u8{ "gate_proj", "up_proj", "down_proj" };
+    for (shorts, parts_names) |short, part| {
+        const k2map = o.get(try std.fmt.allocPrint(r.a, "{s}_k2", .{short})).?.array;
+        const list: *[]exl3_upload.Proj = switch (short[0]) {
+            'g' => &gate,
+            'u' => &upj,
+            else => &down,
+        };
+        for (0..e_count) |e| {
+            const prefix = try std.fmt.allocPrint(r.a, "{s}.{d}.{s}", .{ base, e, part });
+            const gi = idx.get(prefix) orelse return error.TestFailed;
+            const g = scan.groups[gi];
+            try check.expect(g.halves == bitsOf(k2map.items[e]), "exl3.layer.python {s}: expert {d} is {d} halves, the fixture says {d}", .{ prefix, e, g.halves, bitsOf(k2map.items[e]) });
+            const parts = try scan.parts(r.a, gi);
+            list.*[e] = .{ .trellis = parts.trellis.bytes, .suh = parts.suh.bytes, .svh = parts.svh.bytes, .k2 = g.halves };
+        }
+    }
+    const l = try exl3_upload.layer(up, r.a, dims, width, .mul1, @floatCast(o.get("limit").?.float), @intCast(o.get("act_mode").?.integer), gate, upj, down);
+    const xmap = o.get("x").?.object;
+    const pickmap = o.get("pick").?.object;
+    const wtsmap = o.get("wts").?.object;
+    const ymap = o.get("y").?.object;
+    const outmap = o.get("out").?.object;
+    for (o.get("rows").?.array.items) |rv| {
+        const m: usize = @intCast(rv.integer);
+        const key = try std.fmt.allocPrint(r.a, "{d}", .{m});
+        const dx = try r.dev(try readFile(r, dir, xmap.get(key).?.string));
+        const dpick = try r.dev(try readFile(r, dir, pickmap.get(key).?.string));
+        const dwts = try r.dev(try readFile(r, dir, wtsmap.get(key).?.string));
+        const sb = try r.zeros(try exl3e.scratchBytes(l, m, slots));
+        const sc = try exl3e.scratch(sb, l, m, slots);
+        const out = try r.zeros(m * dims * 4);
+        try exp.run(r.s, l, dx, dims, .bf16, dpick, dwts, m, out, sc);
+        const got_out = try r.back(out, m * dims * 4);
+        try check.sameBytes(try std.fmt.allocPrint(r.a, "exl3.layer.python {s} experts {d} rows out", .{ base, m }), got_out, try readFile(r, dir, outmap.get(key).?.string));
+        const got_y = try r.back(sc.y, m * slots * dims * 4);
+        try check.sameBytes(try std.fmt.allocPrint(r.a, "exl3.layer.python {s} experts {d} rows y", .{ base, m }), got_y, try readFile(r, dir, ymap.get(key).?.string));
+    }
+}
+
+fn manifest(r: *Rig, dir: []const u8) !std.json.ObjectMap {
+    const text = try std.Io.Dir.cwd().readFileAlloc(r.gpu.io, try std.fs.path.join(r.a, &.{ dir, "manifest.json" }), r.a, .limited(1 << 24));
+    const parsed = try std.json.parseFromSlice(std.json.Value, r.a, text, .{});
+    return parsed.value.object;
+}
+
+fn bitsOf(v: std.json.Value) u32 {
+    return switch (v) {
+        .integer => |i| @intCast(i),
+        .float => |f| @intFromFloat(f),
+        else => unreachable,
+    };
+}
+
+fn readFile(r: *Rig, dir: []const u8, name: []const u8) ![]u8 {
+    return std.Io.Dir.cwd().readFileAlloc(r.gpu.io, try std.fs.path.join(r.a, &.{ dir, name }), r.a, .limited(1 << 30));
+}
