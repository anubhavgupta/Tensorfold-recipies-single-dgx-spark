 from .weights import Weights
 
 
+def media_key(prompt, vision) -> list[int]:
+    """The prompt as a prefix-cache key: each image or video placeholder run becomes ids only that media's bytes make."""
+
+    import hashlib
+
+    ids = list(prompt)
+    if vision is None:
+        return ids
+
+    def tag(kind, h):
+        return -1 - int.from_bytes(hashlib.sha256(f"{kind}:{h}".encode()).digest()[:16], "big")
+
+    for (a, b), h in zip(vision.image_spans, vision.image_hashes):
+        ids[a:b] = [tag("i", h)] * (b - a)
+    spans, grids = list(getattr(vision, "video_spans", ())), getattr(vision, "video_grid_thw", None)
+    first = 0
+    for h, grid in zip(getattr(vision, "video_hashes", ()), () if grids is None else grids):
+        for a, b in spans[first:first + int(grid[0])]:
+            ids[a:b] = [tag("v", h)] * (b - a)
+        first += int(grid[0])
+    return ids
+
+
