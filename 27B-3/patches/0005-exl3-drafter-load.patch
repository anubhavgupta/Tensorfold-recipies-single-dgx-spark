+def _hadamard(n: int, device) -> torch.Tensor:
+    """H / sqrt(n) (Sylvester, symmetric), the rotation EXL3 applies to every 128 inputs and outputs."""
+
+    h = torch.ones((1, 1), dtype=torch.float32)
+    while h.shape[0] < n:
+        h = torch.cat((torch.cat((h, h), 1), torch.cat((h, -h), 1)), 0)
+    return (h / n ** 0.5).to(device)
+
+
+def dequantize_exl3(weights: dict, device) -> None:
+    """Turn an EXL3 drafter's groups (trellis, suh, svh, mul1) into bf16 ``.weight`` [N, K] tensors in place.
+
+    W = diag(suh) H W_q H diag(svh) with W_q decoded on the GPU; the 4-bit affine packing then runs as for a bf16 drafter."""
+
+    from tensorfold.cuda.exl3.linear import Exl3Linear
+
+    h = _hadamard(128, device)
+    for prefix in sorted(n[:-len(".trellis")] for n in weights if n.endswith(".trellis")):
+        parts = {p: weights.pop(f"{prefix}.{p}", None) for p in ("trellis", "suh", "svh", "su", "sv", "mul1", "mcg")}
+        codebook = "mul1" if parts["mul1"] is not None else "mcg" if parts["mcg"] is not None else "3inst"
+        layer = Exl3Linear.from_tensors(parts["trellis"], parts["suh"] if parts["suh"] is not None else parts["su"],
+                                        parts["svh"] if parts["svh"] is not None else parts["sv"], codebook, None,
+                                        device, layout="stored")
+        wq = layer.unpack().float()                                   # [K, N] in the rotated domain
+        k, n = wq.shape
+        w = torch.matmul(h, wq.view(k // 128, 128, n)).view(k, n) * layer.suh.float()[:, None]
+        w = torch.matmul(w.view(k, n // 128, 128), h).view(k, n) * layer.svh.float()[None, :]
+        weights[f"{prefix}.weight"] = w.t().contiguous().to(torch.bfloat16).cpu()
+        del layer, wq, w
+
