diff --git a/zig/build/dory.zig b/zig/build/dory.zig
new file mode 100644
index 00000000..06b76db3
--- /dev/null
+++ b/zig/build/dory.zig
@@ -0,0 +1,27 @@
+//! libdory, NVIDIA Nemotron-Labs Dory's forward pass: an optional library nvcc builds beside the server from -Ddory-src.
+
+const std = @import("std");
+
+const sources = [_][]const u8{ "dory_kernels.cu", "dory_mma.cu", "dory_attn.cu", "dory_host.cu" };
+
+/// `zig build dory -Dnvcc=NVCC -Ddory-src=DIR`: native/lib/libdory.so, which a Dory checkpoint opens.
+pub fn steps(b: *std.Build, nvcc: ?[]const u8) void {
+    const step = b.step("dory", "libdory (Nemotron-Labs Dory's engine, sm_121) from -Ddory-src with -Dnvcc, beside the server");
+    const src = b.option([]const u8, "dory-src", "the directory of libdory's .cu sources (dory_host.cu and its siblings)");
+    const tool = nvcc orelse {
+        step.dependOn(&b.addFail("zig build dory needs -Dnvcc=PATH to nvcc").step);
+        return;
+    };
+    const dir = src orelse {
+        step.dependOn(&b.addFail("zig build dory needs -Ddory-src=DIR, the folder holding dory_host.cu").step);
+        return;
+    };
+    const root: std.Build.LazyPath = .{ .cwd_relative = dir };
+    const run = b.addSystemCommand(&.{ tool, "-shared", "-Xcompiler", "-fPIC", "-O3", "-gencode", "arch=compute_121,code=sm_121", "-I" });
+    run.addDirectoryArg(root);
+    run.addArg("-o");
+    const lib = run.addOutputFileArg("libdory.so");
+    for (sources) |name| run.addFileArg(root.path(b, name));
+    run.addArg("-lcuda");
+    step.dependOn(&b.addInstallFile(lib, "native/lib/libdory.so").step);
+}
